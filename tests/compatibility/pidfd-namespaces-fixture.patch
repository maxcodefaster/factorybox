+def require_pidfd_namespace_coverage(proof):
+    required = ['passed', 'exact_nested_target_signaled_before',
+                'exact_nested_target_signaled_after', 'same_sandbox']
+    if any(proof.get(key) is not True for key in required):
+        raise ValueError('namespace pidfd proof omitted its exact target identity')
+    cases = proof.get('cases', {})
+    if set(cases) != {'flat', 'nested', 'shared-table'}:
+        raise ValueError('namespace pidfd proof omitted a namespace or shared-table control')
+    for mode, row in cases.items():
+        if (any(row.get(key) is not True for key in required + [
+                'aliases_and_independent_flags', 'dead_pidfd_stays_dead',
+                'self_pidfd_stays_live', 'fork_targets_independent', 'fork_pause_resume']) or
+                row.get('shared_file_table') is not (mode == 'shared-table')):
+            raise ValueError('namespace pidfd proof omitted its description or fork controls')
+        cycles = row.get('cycles', [])
+        if (len(cycles) != 3 or len({cycle.get('snapshot') for cycle in cycles}) != 3 or
+                any(cycle.get('original_handle_signaled_exact_target') is not True
+                    for cycle in cycles)):
+            raise ValueError('namespace pidfd proof omitted repeated exact Resume')
