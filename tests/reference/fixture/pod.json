    "containers": [
      {
        "args": [
          "attempt=0\nwhile ! test -f /experiment/theia/client-ready; do\n  attempt=$((attempt+1))\n  if test \"$attempt\" -ge 90; then printf \"1\\n\" > /experiment/exit-code; exit 1; fi\n  sleep 1\ndone\n/pipe-keeper > /experiment/pipe-store-keeper.log 2>&1 &\npipe_keeper_pid=$!\npipe_ready=0\nwhile ! test -f /experiment/pipe-store/ready.json; do\n  if ! kill -0 \"$pipe_keeper_pid\" 2>/dev/null; then printf '1\\n' > /experiment/exit-code; exit 1; fi\n  pipe_ready=$((pipe_ready+1))\n  if test \"$pipe_ready\" -ge 100; then printf '1\\n' > /experiment/exit-code; exit 1; fi\n  sleep 0.05\ndone\npython3 -c 'import datetime,json,pathlib,sys,time; p=pathlib.Path(\"/experiment/pipe-store/helper-lifecycle.json\"); p.write_text(json.dumps({\"pid\":int(sys.argv[1]),\"observed_at\":datetime.datetime.now(datetime.timezone.utc).isoformat(),\"monotonic_ns\":time.monotonic_ns(),\"fixture_keeper_deadline_seconds\":390})+\"\\n\")' \"$pipe_keeper_pid\"\n/lab criu-probe\nstatus=$?\ntouch /experiment/pipe-store/finish\nif ! wait \"$pipe_keeper_pid\"; then status=1; fi\nprintf '%s\\n' \"$status\" > /experiment/exit-code\nexec sleep infinity\n"
        ],
