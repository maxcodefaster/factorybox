@@ -0,0 +1,237 @@
+/* A waitable exec zombie can be in a sibling init's PID namespace while its
+ * actual parent is the outside shim. Keep that parent and both PID levels.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <poll.h>
+#include <sched.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <linux/nsfs.h>
+
+#include "common/scm.h"
+#include "criu-log.h"
+#include "fdstore.h"
+#include "namespaces.h"
+#include "nested-ns.h"
+#include "pstree.h"
+#include "rst_info.h"
+#include "util.h"
+#include "xmalloc.h"
+
+static bool outside_parent(struct pstree_item *item)
+{
+	struct pstree_item *parent = item->parent;
+
+	return parent && parent->ids && root_item->ids &&
+		parent->ids->pid_ns_id == root_item->ids->pid_ns_id &&
+		parent->ids->user_ns_id == root_item->ids->user_ns_id;
+}
+
+static struct pstree_item *peer_init(struct pstree_item *item, unsigned int id, bool dump)
+{
+	struct pstree_item *peer, *found = NULL;
+
+	if (!outside_parent(item) || !id || id == root_item->ids->pid_ns_id)
+		return NULL;
+	list_for_each_entry(peer, &item->parent->children, sibling) {
+		pid_t own;
+
+		if (peer == item || !peer->ids || peer->ids->pid_ns_id != id ||
+		    peer->ids->files_id == item->parent->ids->files_id)
+			continue;
+		own = dump ? nested_ns_dump_own_pid(peer->pid->real, vpid(peer)) : peer->own_ns_pid;
+		if (own != 1)
+			continue;
+		if (found)
+			return NULL;
+		found = peer;
+	}
+	return found;
+}
+
+int nested_zombie_dump_peer(struct pstree_item *item)
+{
+	struct stat child;
+	struct ns_id *ns;
+	pid_t own;
+	int fd;
+
+	if (!nested_ns_enabled() || item->pid->state != TASK_DEAD || !outside_parent(item))
+		return -1;
+	fd = open_pid_proc(item->pid->real);
+	if (fd < 0 || fstatat(fd, "ns/pid", &child, 0) || child.st_ino > UINT_MAX)
+		return -1;
+	ns = lookup_ns_by_kid(child.st_ino, &pid_ns_desc);
+	own = nested_ns_dump_own_pid(item->pid->real, vpid(item));
+	if (!ns || ns->id > INT_MAX || own <= 1 || own == vpid(item) || !peer_init(item, ns->id, true)) {
+		pr_err("Zombie has no validated sibling PID namespace init\n");
+		return -1;
+	}
+	pr_info("Zombie %d keeps outside parent %d and sibling PID namespace %u\n",
+		vpid(item), vpid(item->parent), ns->id);
+	return ns->id;
+}
+
+int nested_zombie_prepare_pstree(void)
+{
+	struct pstree_item *item, **pending;
+	size_t count = 0, i = 0;
+	int ret = -1;
+
+	if (!nested_ns_enabled())
+		return 0;
+	for_each_pstree_item(item)
+		if (item->zombie_peer_pidns_id)
+			count++;
+	if (!count)
+		return 0;
+	pending = xmalloc(count * sizeof(*pending));
+	if (!pending)
+		return -1;
+	for_each_pstree_item(item)
+		if (item->zombie_peer_pidns_id)
+			pending[i++] = item;
+	for (i = 0; i < count; i++) {
+		struct pstree_item *home;
+
+		item = pending[i];
+		home = peer_init(item, item->zombie_peer_pidns_id, false);
+		if (item->ids || item->zombie_parent_pidns || !home ||
+		    item->own_ns_pid <= 1 || item->own_ns_pid == vpid(item)) {
+			pr_err("Invalid outside-parent zombie namespace topology for %d\n", vpid(item));
+			goto out;
+		}
+		item->zombie_pidns_home = home;
+		/* Image collection reverses sibling order. Create the namespace init
+		 * before its zombie without changing either task's actual parent. */
+		list_del(&item->sibling);
+		list_add(&item->sibling, &home->sibling);
+	}
+	ret = 0;
+out:
+	xfree(pending);
+	return ret;
+}
+
+void nested_zombie_home_close(int pair[2])
+{
+	if (pair[0] >= 0)
+		close(pair[0]);
+	if (pair[1] >= 0)
+		close(pair[1]);
+	pair[0] = pair[1] = -1;
+}
+
+int nested_zombie_home_prepare(struct pstree_item *item, unsigned long flags, int pair[2])
+{
+	struct pstree_item *sibling;
+	bool needed = false;
+
+	pair[0] = pair[1] = -1;
+	if (!nested_ns_enabled() || !item->parent)
+		return 0;
+	list_for_each_entry(sibling, &item->parent->children, sibling)
+		if (sibling->zombie_pidns_home == item)
+			needed = true;
+	if (!needed)
+		return 0;
+	if (!(flags & CLONE_NEWPID) || (flags & CLONE_FILES)) {
+		pr_err("Zombie namespace init requires its independent fork/FD table\n");
+		return -1;
+	}
+	return socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0, pair);
+}
+
+int nested_zombie_home_send(int pair[2])
+{
+	int fd, ret;
+
+	if (pair[1] < 0)
+		return 0;
+	close(pair[0]);
+	pair[0] = -1;
+	/* /proc/self resolves the caller even on the inherited ancestor proc. */
+	fd = open("/proc/self/ns/pid", O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	ret = send_fd(pair[1], NULL, 0, fd);
+	close(fd);
+	close(pair[1]);
+	pair[1] = -1;
+	return ret;
+}
+
+int nested_zombie_home_receive(struct pstree_item *item, int pair[2])
+{
+	struct pollfd pollfd;
+	int fd, id, ret;
+
+	if (pair[0] < 0)
+		return 0;
+	close(pair[1]);
+	pair[1] = -1;
+	pollfd = (struct pollfd){ .fd = pair[0], .events = POLLIN };
+	do {
+		ret = poll(&pollfd, 1, 5000);
+	} while (ret < 0 && errno == EINTR);
+	if (ret != 1 || !(pollfd.revents & POLLIN)) {
+		pr_err("Zombie sibling PID namespace handoff did not arrive\n");
+		return -1;
+	}
+	fd = recv_fd(pair[0]);
+	if (fd < 0)
+		return -1;
+	ret = ioctl(fd, NS_GET_NSTYPE);
+	id = ret == CLONE_NEWPID ? fdstore_add(fd) : -1;
+	close(fd);
+	nested_zombie_home_close(pair);
+	if (id < 0)
+		return -1;
+	rsti(item)->zombie_pidns_fd_id = id;
+	rsti(item)->zombie_pidns_fd_ready = true;
+	return 0;
+}
+
+int nested_zombie_enter(struct pstree_item *item, int *previous)
+{
+	struct pstree_item *home = item->zombie_pidns_home;
+	int fd, saved;
+
+	*previous = -1;
+	if (!item->zombie_peer_pidns_id)
+		return 0;
+	if (item->pid->state != TASK_DEAD || item->ids || !home ||
+	    !rsti(home)->zombie_pidns_fd_ready || !outside_parent(item) ||
+	    (rsti(item)->clone_flags & CLONE_NEWPID)) {
+		pr_err("Zombie fork has no ready validated sibling PID namespace\n");
+		return -1;
+	}
+	fd = fdstore_get(rsti(home)->zombie_pidns_fd_id);
+	if (fd < 0)
+		return -1;
+	saved = open("/proc/self/ns/pid_for_children", O_RDONLY | O_CLOEXEC);
+	if (saved < 0 || setns(fd, CLONE_NEWPID)) {
+		if (saved >= 0)
+			close(saved);
+		close(fd);
+		return -1;
+	}
+	close(fd);
+	*previous = saved;
+	return 0;
+}
+
+int nested_zombie_leave(int previous)
+{
+	int ret;
+
+	if (previous < 0)
+		return 0;
+	ret = setns(previous, CLONE_NEWPID);
+	close(previous);
+	return ret;
+}
