+// Pin the prepared launcher's own worker cgroup before CRIU is started.
+// Sysbox temporarily moves its CRIU child into the target's init.scope.
+func factoryboxHoldOrigin(target string) (*os.File, error) {
+	data, err := os.ReadFile("/proc/self/cgroup")
+	if err != nil {
+		return nil, err
+	}
+	path := ""
+	for _, line := range strings.Split(string(data), "\n") {
+		if strings.HasPrefix(line, "0::") {
+			if path != "" {
+				return nil, fmt.Errorf("ambiguous original worker cgroup")
+			}
+			path = strings.TrimPrefix(line, "0::")
+		}
+	}
+	if path == "" || !filepath.IsAbs(path) || filepath.Clean(path) != path || path == "/"+target || strings.HasPrefix(path, "/"+target+"/") {
+		return nil, fmt.Errorf("restore launcher is outside its original worker cgroup")
+	}
+	fd, err := unix.Openat2(unix.AT_FDCWD, "/sys/fs/cgroup"+path, &unix.OpenHow{
+		Flags:   unix.O_RDONLY | unix.O_DIRECTORY | unix.O_CLOEXEC,
+		Resolve: unix.RESOLVE_NO_SYMLINKS,
+	})
+	if err != nil {
+		return nil, err
+	}
+	file := os.NewFile(uintptr(fd), "original restore worker cgroup")
+	var filesystem unix.Statfs_t
+	if err := unix.Fstatfs(fd, &filesystem); err != nil || filesystem.Type != unix.CGROUP2_SUPER_MAGIC {
+		file.Close()
+		return nil, fmt.Errorf("original worker is not on cgroup v2: %v", err)
+	}
+	return file, nil
+}
+
+func factoryboxHoldMoveCRIU(origin *os.File, target, executable string, criuPID int) error {
+	current, err := factoryboxHoldOrigin(target)
+	if err != nil {
+		return err
+	}
+	defer current.Close()
+	saved, err := origin.Stat()
+	if err != nil {
+		return err
+	}
+	now, err := current.Stat()
+	if err != nil || !os.SameFile(saved, now) {
+		return fmt.Errorf("original worker cgroup changed before CRIU return: %v", err)
+	}
+	actual, err := os.Stat(fmt.Sprintf("/proc/%d/exe", criuPID))
+	if err != nil {
+		return err
+	}
+	expected, err := os.Stat(executable)
+	if err != nil || !os.SameFile(actual, expected) {
+		return fmt.Errorf("pre-resume tracer executable differs from the original CRIU: %v", err)
+	}
+	pidfd, err := unix.PidfdOpen(criuPID, 0)
+	if err != nil {
+		return err
+	}
+	defer unix.Close(pidfd)
+	poll := []unix.PollFd{{Fd: int32(pidfd), Events: unix.POLLIN}}
+	if n, err := unix.Poll(poll, 0); err != nil || n != 0 {
+		return fmt.Errorf("original CRIU child has exited: %v", err)
+	}
+	data, err := os.ReadFile(fmt.Sprintf("/proc/%d/cgroup", criuPID))
+	if err != nil {
+		return err
+	}
+	member := false
+	for _, line := range strings.Split(string(data), "\n") {
+		member = member || line == "0::/"+target || strings.HasPrefix(line, "0::/"+target+"/")
+	}
+	if !member {
+		return fmt.Errorf("original CRIU child is outside its temporary target cgroup")
+	}
+	fd, err := unix.Openat(int(origin.Fd()), "cgroup.procs", unix.O_WRONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return err
+	}
+	procs := os.NewFile(uintptr(fd), "original CRIU worker return")
+	_, writeErr := procs.WriteString(strconv.Itoa(criuPID))
+	if err := errors.Join(writeErr, procs.Close()); err != nil {
+		return err
+	}
+	data, err = os.ReadFile(fmt.Sprintf("/proc/%d/cgroup", criuPID))
+	worker, workerErr := os.ReadFile("/proc/self/cgroup")
+	if err != nil || workerErr != nil || !bytes.Equal(data, worker) {
+		return fmt.Errorf("original CRIU did not return to its worker cgroup: %v %v", err, workerErr)
+	}
+	return nil
+}
 
