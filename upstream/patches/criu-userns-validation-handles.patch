--- a/criu/namespaces.c
+++ b/criu/namespaces.c
@@ -960,9 +960,30 @@
 	if (chld == 0) {
 		struct __user_cap_data_struct data[_LINUX_CAPABILITY_U32S_3];
 		struct __user_cap_header_struct hdr;
+		struct ns_desc *checked[] = { &user_ns_desc, &net_ns_desc, &uts_ns_desc,
+					     &time_ns_desc, &ipc_ns_desc, &mnt_ns_desc };
+		int nsfd[ARRAY_SIZE(checked)];
+		unsigned int i;
 		uid_t uid;
 		gid_t gid;
 
+		/*
+		 * Pin the target's namespace handles before dropping authority.
+		 * A non-dumpable task can deny a procfs namespace lookup from
+		 * its current userns even when the namespace itself has the
+		 * correct owner, particularly after restore without exec.
+		 * setns below still checks each exact handle from the target
+		 * userns; do not change the target's dumpability or skip checks.
+		 */
+		for (i = 0; i < ARRAY_SIZE(checked); i++) {
+			nsfd[i] = -1;
+			if (i && !(root_ns_mask & checked[i]->cflag))
+				continue;
+			nsfd[i] = open_proc(pid, "ns/%s", checked[i]->str);
+			if (nsfd[i] < 0)
+				exit(1);
+		}
+
 		uid = host_uid(0);
 		gid = host_gid(0);
 		if (uid == INVALID_ID || gid == INVALID_ID) {
@@ -1013,16 +1034,10 @@
-		if (switch_ns(pid, &user_ns_desc, NULL))
-			exit(1);
-
-		if ((root_ns_mask & CLONE_NEWNET) && switch_ns(pid, &net_ns_desc, NULL))
-			exit(1);
-		if ((root_ns_mask & CLONE_NEWUTS) && switch_ns(pid, &uts_ns_desc, NULL))
-			exit(1);
-		if ((root_ns_mask & CLONE_NEWTIME) && switch_ns(pid, &time_ns_desc, NULL))
-			exit(1);
-		if ((root_ns_mask & CLONE_NEWIPC) && switch_ns(pid, &ipc_ns_desc, NULL))
-			exit(1);
-		if ((root_ns_mask & CLONE_NEWNS) && switch_ns(pid, &mnt_ns_desc, NULL))
-			exit(1);
+		for (i = 0; i < ARRAY_SIZE(checked); i++) {
+			if (nsfd[i] < 0)
+				continue;
+			if (switch_ns_by_fd(nsfd[i], checked[i], NULL))
+				exit(1);
+			close(nsfd[i]);
+		}
 		exit(0);
 	}
 
