 func (m *manager) GetChildCgroupPaths() map[string]string {
-	return m.GetPaths()
+	// Exec must use the same delegated leaf as the original init. Joining
+	// the root works while its controllers are disabled, but then prevents
+	// Docker or systemd from enabling domain controllers for new children.
+	// Do not depend on EnterPid's EBUSY fallback to find this leaf.
+	return map[string]string{"": filepath.Join(m.dirPath, "init.scope")}
 }
 
