+package main
+
+import (
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/urfave/cli"
+)
+
+func TestFactoryboxBinfmtMiscPolicy(t *testing.T) {
+	for _, tc := range []struct {
+		name                 string
+		args                 []string
+		present, namespaced  bool
+		moduleErr, nsErr     error
+		want                 bool
+		moduleCalls, nsCalls int
+		wantError            string
+	}{
+		{name: "default supported", present: true, namespaced: true, want: true, moduleCalls: 1, nsCalls: 1},
+		{name: "explicit opt out", args: []string{"--disable-binfmt-misc"}, present: true, namespaced: true},
+		{name: "regular container", args: []string{"--syscont-mode=false"}, present: true, namespaced: true},
+		{name: "module absent", moduleCalls: 1},
+		{name: "not namespaced", present: true, moduleCalls: 1, nsCalls: 1},
+		{name: "module error", moduleErr: errors.New("probe denied"), moduleCalls: 1, wantError: "kernel module check failed: probe denied"},
+		{name: "namespace error", present: true, nsErr: errors.New("probe denied"), moduleCalls: 1, nsCalls: 1, wantError: "namespacing: probe denied"},
+		{name: "opt out skips failing probes", args: []string{"--disable-binfmt-misc"}, moduleErr: errors.New("must not probe"), nsErr: errors.New("must not probe")},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			moduleCalls, nsCalls := 0, 0
+			app := cli.NewApp()
+			app.Flags = []cli.Flag{cli.BoolTFlag{Name: "syscont-mode"}, disableBinfmtMiscFlag}
+			app.Action = func(ctx *cli.Context) error {
+				got, err := autoMountBinfmtMisc(ctx, func(name string) (bool, error) {
+					moduleCalls++
+					if name != "binfmt_misc" {
+						t.Fatalf("unexpected module probe %q", name)
+					}
+					return tc.present, tc.moduleErr
+				}, func() (bool, error) {
+					nsCalls++
+					return tc.namespaced, tc.nsErr
+				})
+				if got != tc.want {
+					t.Fatalf("mount decision %t, want %t", got, tc.want)
+				}
+				return err
+			}
+			err := app.Run(append([]string{"sysbox-mgr"}, tc.args...))
+			if tc.wantError == "" && err != nil || tc.wantError != "" && (err == nil || !strings.Contains(err.Error(), tc.wantError)) {
+				t.Fatalf("unexpected policy error %v, want %q", err, tc.wantError)
+			}
+			if moduleCalls != tc.moduleCalls || nsCalls != tc.nsCalls {
+				t.Fatalf("probe calls module=%d namespaces=%d, want %d/%d", moduleCalls, nsCalls, tc.moduleCalls, tc.nsCalls)
+			}
+		})
+	}
+}
