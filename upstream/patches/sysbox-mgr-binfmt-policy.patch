@@ -0,0 +1,39 @@
+package main
+
+import (
+	"fmt"
+
+	"github.com/sirupsen/logrus"
+	"github.com/urfave/cli"
+)
+
+var disableBinfmtMiscFlag = cli.BoolFlag{
+	Name:  "disable-binfmt-misc",
+	Usage: "Disable automatic binfmt_misc mounts; foreign binary format registration is unavailable (default = false)",
+}
+
+// The Factorybox reference worker disables this optional filesystem until its
+// kernel handler state has an independent checkpoint/restore qualification.
+func autoMountBinfmtMisc(ctx *cli.Context, module func(string) (bool, error),
+	namespaced func() (bool, error)) (bool, error) {
+	if !ctx.GlobalBoolT("syscont-mode") || ctx.GlobalBool("disable-binfmt-misc") {
+		return false, nil
+	}
+	present, err := module("binfmt_misc")
+	if err != nil {
+		return false, fmt.Errorf("binfmt_misc kernel module check failed: %v", err)
+	}
+	if !present {
+		return false, nil
+	}
+	supported, err := namespaced()
+	if err != nil {
+		return false, fmt.Errorf("failed to check kernel support for binfmt_misc namespacing: %v", err)
+	}
+	if supported {
+		logrus.Info("binfmt_misc namespacing supported by kernel; will auto mount it in containers.")
+	} else {
+		logrus.Info("binfmt_misc namespacing not supported by kernel; won't auto mount it in containers.")
+	}
+	return supported, nil
+}
