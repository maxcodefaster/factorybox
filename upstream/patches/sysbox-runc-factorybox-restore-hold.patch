+)
+
+func factoryboxHoldRead(group *os.File, name string) ([]byte, error) {
+	fd, err := unix.Openat(int(group.Fd()), name, unix.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	file := os.NewFile(uintptr(fd), "original restore hold "+name)
+	data, readErr := io.ReadAll(io.LimitReader(file, 16385))
+	if len(data) > 16384 {
+		readErr = errors.Join(readErr, fmt.Errorf("restore hold counters exceed bound"))
+	}
+	return data, errors.Join(readErr, file.Close())
+}
+
+func factoryboxHoldConfirmed(group *os.File) error {
+	data, err := factoryboxHoldRead(group, "cgroup.events")
+	if err != nil {
+		return err
+	}
+	values := map[string]uint64{}
+	for _, line := range strings.Split(string(data), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 2 {
+			value, err := strconv.ParseUint(fields[1], 10, 64)
+			if err != nil {
+				return err
+			}
+			values[fields[0]] = value
+		}
+	}
+	if values["frozen"] != 1 || values["populated"] != 1 {
+		return fmt.Errorf("restored original cgroup is not populated and frozen")
+	}
+	return nil
+}
+
+// CRIU invokes this callback before its final ptrace detach. The exact
+// inherited cgroup is frozen before acknowledging the notification. The
+// controller must acknowledge this held identity, or restore fails closed.
+func factoryboxHoldBeforeResume(group, control *os.File, target string, pid int, request any, validate func() error) error {
+	if pid <= 1 || pid == os.Getpid() {
+		return fmt.Errorf("invalid pre-resume task identity")
+	}
+	if err := validate(); err != nil {
+		return err
+	}
+	kind, err := unix.GetsockoptInt(int(control.Fd()), unix.SOL_SOCKET, unix.SO_TYPE)
+	if err != nil || kind != unix.SOCK_SEQPACKET {
+		return fmt.Errorf("restore hold has no original packet control socket: %v", err)
+	}
+	membership, err := os.ReadFile(fmt.Sprintf("/proc/%d/cgroup", pid))
+	if err != nil {
+		return err
+	}
+	member := false
+	for _, line := range strings.Split(string(membership), "\n") {
+		member = member || line == "0::/"+target || strings.HasPrefix(line, "0::/"+target+"/")
+	}
+	if !member {
+		return fmt.Errorf("pre-resume task left its original cgroup")
+	}
+	status, err := os.ReadFile(fmt.Sprintf("/proc/%d/status", pid))
+	if err != nil {
+		return err
+	}
+	tracer := 0
+	for _, line := range strings.Split(string(status), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 2 && fields[0] == "TracerPid:" {
+			tracer, err = strconv.Atoi(fields[1])
+			if err != nil {
+				return err
+			}
+		}
+	}
+	if tracer <= 1 {
+		return fmt.Errorf("pre-resume task has already lost its CRIU tracer")
+	}
+	stat, err := os.ReadFile(fmt.Sprintf("/proc/%d/stat", pid))
+	if err != nil {
+		return err
+	}
+	end := strings.LastIndexByte(string(stat), ')')
+	if end < 0 {
+		return fmt.Errorf("invalid pre-resume task birth")
+	}
+	fields := strings.Fields(string(stat[end+1:]))
+	if len(fields) < 20 {
+		return fmt.Errorf("incomplete pre-resume task birth")
+	}
+	if _, err := strconv.ParseUint(fields[19], 10, 64); err != nil {
+		return err
+	}
+	fd, err := unix.Openat(int(group.Fd()), "cgroup.freeze", unix.O_WRONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return err
+	}
+	freeze := os.NewFile(uintptr(fd), "original pre-resume freezer")
+	_, writeErr := freeze.WriteString("1")
+	if err := errors.Join(writeErr, freeze.Close()); err != nil {
+		return err
+	}
+	for deadline := time.Now().Add(2 * time.Second); ; {
+		if err := validate(); err != nil {
+			return err
+		}
+		if err := factoryboxHoldConfirmed(group); err == nil {
+			break
+		} else if time.Now().After(deadline) {
+			return err
+		}
+		time.Sleep(time.Millisecond)
+	}
+	data, err := json.Marshal(request)
+	if err != nil {
+		return err
+	}
+	hash := sha256.Sum256(data)
+	token := hex.EncodeToString(hash[:])
+	packet, err := json.Marshal(map[string]any{"version": 1, "request_sha256": token, "runtime_id": target,
+		"pid": pid, "process_start": fields[19], "criu_tracer_pid": tracer, "frozen_before_resume": true})
+	if err != nil {
+		return err
+	}
+	if _, err := control.Write(packet); err != nil {
+		return err
+	}
+	poll := []unix.PollFd{{Fd: int32(control.Fd()), Events: unix.POLLIN | unix.POLLHUP}}
+	for {
+		_, err = unix.Poll(poll, 3000)
+		if !errors.Is(err, unix.EINTR) {
+			break
+		}
+	}
+	if err != nil || poll[0].Revents&unix.POLLIN == 0 {
+		return fmt.Errorf("restore hold controller did not acknowledge its original task: %v", err)
+	}
+	ack := make([]byte, 128)
+	n, err := control.Read(ack)
+	if err != nil || string(ack[:n]) != "held:"+token {
+		return fmt.Errorf("restore hold acknowledgement differs from its sealed request: %v", err)
+	}
+	return errors.Join(validate(), factoryboxHoldConfirmed(group))
+}
+
+func factoryboxRestoreOutcome(request factoryboxRestoreRequest, state *libcontainer.State, group *os.File) error {
+	if !request.HoldForActivation {
+		return factoryboxRestoreComplete(request, state)
+	}
+	if err := factoryboxHoldConfirmed(group); err != nil {
+		return err
+	}
+	data, err := factoryboxCompletionData(request.Owner, request, state)
+	if err != nil {
+		return err
+	}
+	return factoryboxStoreCompletion(request.Root+"/objects/"+request.SandboxID, "restore-held.json", data)
+}
