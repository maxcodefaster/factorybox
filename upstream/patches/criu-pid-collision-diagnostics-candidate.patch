+/* Read-only diagnostics for the preserved rare EEXIST restore failure.
+ * No retry, PID-counter write, signal, or change to the original errno. */
+static void nested_pid_collision_file(const char *path)
+{
+	char buffer[2049];
+	ssize_t count;
+	int fd;
+
+	fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0) {
+		pr_err("PID-COLLISION cannot open %s: %d\n", path, errno);
+		return;
+	}
+	count = read(fd, buffer, sizeof(buffer) - 1);
+	close(fd);
+	if (count < 0) {
+		pr_err("PID-COLLISION cannot read %s: %d\n", path, errno);
+		return;
+	}
+	buffer[count] = '\0';
+	pr_err("PID-COLLISION bounded %s bytes=%zd:\n%s\n", path, count, buffer);
+}
+
+static void nested_pid_collision(struct pstree_item *item, pid_t *requested, int nr)
+{
+	int saved = errno;
+	char path[96];
+#ifdef SYS_pidfd_open
+	int fd;
+#endif
+
+	pr_err("PID-COLLISION saved_pid=%d own_pid=%d caller=%d set_tid_size=%d tid0=%d tid1=%d flags=%lx\n",
+	       vpid(item), item->own_ns_pid, getpid(), nr, nr > 0 ? requested[0] : -1,
+	       nr > 1 ? requested[1] : -1, rsti(item)->clone_flags);
+	nested_pid_collision_file("/proc/self/status");
+	if (nr > 0) {
+		snprintf(path, sizeof(path), "/proc/%d/status", requested[0]);
+		nested_pid_collision_file(path);
+#ifdef SYS_pidfd_open
+		/* A pidfd is opened using the caller's PID namespace. Its fdinfo
+		 * reports the occupant in the mounted proc view as well. Read only. */
+		fd = syscall(SYS_pidfd_open, requested[0], 0);
+		if (fd >= 0) {
+			snprintf(path, sizeof(path), "/proc/self/fdinfo/%d", fd);
+			nested_pid_collision_file(path);
+			close(fd);
+		} else {
+			pr_err("PID-COLLISION pidfd_open(%d): %d\n", requested[0], errno);
+		}
+#endif
+	}
+	errno = saved;
+}
