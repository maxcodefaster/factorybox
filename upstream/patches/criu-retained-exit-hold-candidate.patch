+/* Private native-test fault point. A sandbox cannot write the root-owned
+ * transaction guard directory. No request means no additional stop. */
+int factorybox_retained_test_stop(int pid)
+{
+	int evidence, length, failed, vpid = captured_vpid(pid);
+	ssize_t count;
+	char request[256], expected[256], stopped[512];
+	struct stat info;
+	if (child_pid <= 1 || !active_phase || !__atomic_load_n(active_phase, __ATOMIC_ACQUIRE))
+		return 0;
+	evidence = openat(get_service_fd(IMG_FD_OFF), "../guard",
+			  O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	if (evidence < 0)
+		return -1;
+	if (fstat(evidence, &info) || info.st_uid || (info.st_mode & 0777) != 0700) {
+		close(evidence);
+		return -1;
+	}
+	if (fstatat(evidence, "criu-retained-test-request.json", &info, AT_SYMLINK_NOFOLLOW)) {
+		int missing = errno == ENOENT;
+		close(evidence);
+		return missing ? 0 : -1;
+	}
+	count = private_record(evidence, "criu-retained-test-request.json", request, sizeof(request));
+	length = snprintf(expected, sizeof(expected),
+			  "{\"version\":1,\"token\":\"%s\",\"active_vpid\":%d}\n", capture_token, vpid);
+	if (count != length || memcmp(request, expected, length)) {
+		/* A canonical request for a later process is not our stop. */
+		int target = private_number(evidence, "criu-retained-test-request.json", "active_vpid");
+		close(evidence);
+		return target > 0 && target != vpid ? 0 : -1;
+	}
+	snprintf(stopped, sizeof(stopped),
+		 "{\"version\":1,\"token\":\"%s\",\"tracer_pid\":%d,\"helper_pid\":%d,"
+		 "\"active_pid\":%d,\"active_vpid\":%d,\"nonce\":\"%s\"}\n",
+		 capture_token, getpid(), child_pid, pid, vpid, recovery_nonce);
+	failed = metadata(evidence, "criu-retained-test-stop.json", stopped);
+	close(evidence);
+	return failed ? -1 : raise(SIGSTOP);
 }
 
