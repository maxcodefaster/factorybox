+//go:build linux
+
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestFactoryboxFsSnapshotScope(t *testing.T) {
+	owner := strings.Repeat("a", 32)
+	bundle := "/owned/objects/source"
+	output := bundle + "/captures/" + strings.Repeat("b", 32) + "/sysbox-state.json"
+	if _, err := factoryboxFsSnapshotPath("fbx-"+owner, owner, bundle, output); err != nil {
+		t.Fatal(err)
+	}
+	for _, test := range []struct{ id, owner, bundle, output string }{
+		{"other", owner, bundle, output},
+		{"fbx-" + owner, strings.Repeat("c", 32), bundle, output},
+		{"fbx-" + owner, owner, bundle, "/foreign/sysbox-state.json"},
+		{"fbx-" + owner, owner, bundle, bundle + "/captures/../sysbox-state.json"},
+		{"fbx-" + owner, owner, bundle, bundle + "/captures/not-a-generation/sysbox-state.json"},
+		{"fbx-" + owner, owner, bundle, strings.TrimSuffix(output, ".json") + ".other"},
+	} {
+		if _, err := factoryboxFsSnapshotPath(test.id, test.owner, test.bundle, test.output); err == nil {
+			t.Fatalf("foreign snapshot path or identity accepted: %+v", test)
+		}
+	}
+}
