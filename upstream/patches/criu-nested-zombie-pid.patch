+int nested_ns_dump_zombie_parent(struct pstree_item *item)
+{
+	struct stat child, parent;
+	int fd;
+
+	if (!item->parent)
+		return 0;
+	fd = open_pid_proc(item->pid->real);
+	if (fd < 0 || fstatat(fd, "ns/pid", &child, 0)) {
+		pr_perror("Can't identify zombie PID namespace");
+		return -1;
+	}
+	fd = open_pid_proc(item->parent->pid->real);
+	if (fd < 0 || fstatat(fd, "ns/pid", &parent, 0)) {
+		pr_perror("Can't identify zombie parent PID namespace");
+		return -1;
+	}
+	return child.st_dev == parent.st_dev && child.st_ino == parent.st_ino;
+}
+
+static unsigned int task_pidns_id(struct pstree_item *item)
+{
+	if (item->ids)
+		return item->ids->pid_ns_id;
+	if (item->pid->state == TASK_DEAD && item->zombie_parent_pidns &&
+	    item->parent && item->parent->ids)
+		return item->parent->ids->pid_ns_id;
+	return 0;
+}
+
 static bool task_in_nested_pidns(struct pstree_item *item)
 {
-	return item->ids && root_item->ids && item->ids->pid_ns_id != root_item->ids->pid_ns_id;
+	unsigned int id = task_pidns_id(item);
+
+	return id && root_item->ids && id != root_item->ids->pid_ns_id;
+}
+
+pid_t nested_ns_child_pid(struct pstree_item *item)
+{
+	if (!nested_ns_enabled())
+		return vpid(item);
+	if (!item->ids && item->pid->state == TASK_DEAD &&
+	    item->own_ns_pid != vpid(item) && !item->zombie_parent_pidns) {
+		pr_err("Nested zombie image lacks its verified parent PID namespace\n");
+		return 0;
+	}
+	if (item->own_ns_pid && item->parent && item->parent->ids &&
+	    item->parent->pid->state != TASK_HELPER &&
+	    item->parent->ids->pid_ns_id == task_pidns_id(item))
+		return item->own_ns_pid;
+	return vpid(item);
 }
 
