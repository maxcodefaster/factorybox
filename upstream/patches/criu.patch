+int seccomp_restore_bridge_init(void)
+{
+	char *bridge = getenv("SYSBOX_SECCOMP_BRIDGE_FD");
+
+	if (bridge) {
+		char *end;
+		long fd = strtol(bridge, &end, 10);
+		int type;
+		socklen_t len = sizeof(type);
+		if (*end || fd < 3 || fd > INT_MAX ||
+		    getsockopt(fd, SOL_SOCKET, SO_TYPE, &type, &len) || type != SOCK_SEQPACKET) {
+			pr_err("Invalid Sysbox seccomp bridge descriptor\n");
+			return -1;
+		}
+		if (install_service_fd(SECCOMP_BRIDGE_SK, fd) < 0)
+			return -1;
+		/* install_service_fd takes ownership. Before fd relocation it stores
+		 * the original descriptor, so closing it here destroys the bridge.
+		 */
+	}
+	return 0;
+}
