+
+static bool lazy_lineage_setting(const char *name)
+{
+	const char *value = getenv(name);
+	return value && !strcmp(value, "1");
+}
+
+bool lazy_inherit_owned_descendant(void)
+{
+	const char *reason;
+	struct lazy_lineage_settings settings = {
+		.runtime_id = getenv("RUNTIME_FORK_DESCENDANT_RUNTIME_ID"),
+		.images = getenv("RUNTIME_FORK_DESCENDANT_IMAGES"),
+		.parent = getenv("RUNTIME_FORK_DESCENDANT_PARENT"),
+		.socket = getenv("RUNTIME_FORK_LAZY_INHERIT_SOCKET"),
+		.daemon_pid = getenv("RUNTIME_FORK_LAZY_INHERIT_DAEMON_PID"),
+		.relative_parent = opts.img_parent, .freeze_cgroup = opts.freeze_cgroup,
+		.image_fd = get_service_fd(IMG_FD_OFF), .nested = opts.nested_ns,
+		.proof = lazy_lineage_setting("RUNTIME_FORK_DESCENDANT_INHERIT_PROOF"),
+		.capture = lazy_lineage_setting("RUNTIME_FORK_DESCENDANT_INHERIT_CAPTURE"),
+		.fresh = lazy_lineage_setting("RUNTIME_FORK_LAZY_INHERIT_FRESH"),
+		.scope = lazy_lineage_setting("SYSBOX_FORK_COLLECT_SCOPE"),
+		.identity = lazy_lineage_setting("RUNTIME_FORK_LAZY_IDENTITY"),
+		.wp = lazy_lineage_setting("RUNTIME_FORK_LAZY_WP"),
+	};
+	if (!lazy_lineage_guard(&settings, &reason)) {
+		pr_err("Owned descendant inheritance rejected at %s\n", reason);
+		return false;
+	}
+	return true;
+}
+
+static struct lazy_inherit_range inherited[LAZY_INHERIT_MAX_RANGES];
+static uint32_t inherited_count;
+static int inherited_native_pid = -1;
+static int inherited_parent_pid = -1;
+static uint64_t inherited_ptes[8192];
+static uint64_t inherited_pte_start, inherited_pte_end;
+
+/* Diagnostic only: preserve the original full writer while recording the
+ * actual fast-path decision at collection time. No second capture instant
+ * can be an exact oracle for kernel-updated rseq bytes.
+ */
+#define LAZY_ORACLE_MAGIC UINT64_C(0x4c494e484f524331)
+#define LAZY_ORACLE_MAX_RANGES 262144
+static int oracle_fd = -1;
+static int oracle_native_pid;
+static uint64_t oracle_image_pid, oracle_parent_pid, oracle_count;
+static uint64_t oracle_start, oracle_end;
+static struct { uint64_t start, end; } oracle_ranges[LAZY_ORACLE_MAX_RANGES];
+
+bool lazy_inherit_oracle_enabled(void)
+{
+	const char *value = getenv("RUNTIME_FORK_LAZY_INHERIT_ORACLE");
+	return value && (!strcmp(value, "1") || !strcmp(value, "2"));
+}
+
+bool lazy_inherit_stream_enabled(void)
+{
+	const char *value = getenv("RUNTIME_FORK_LAZY_INHERIT_ORACLE");
+	return value && !strcmp(value, "2");
+}
+
+static int oracle_flush_range(void)
+{
+	uint64_t range[2] = { oracle_start, oracle_end };
+	if (!oracle_end) return 0;
+	if (oracle_count == LAZY_ORACLE_MAX_RANGES ||
+	    write(oracle_fd, range, sizeof(range)) != sizeof(range))
+		return -1;
+	oracle_ranges[oracle_count].start = oracle_start;
+	oracle_ranges[oracle_count].end = oracle_end;
+	oracle_count++;
+	oracle_start = oracle_end = 0;
+	return 0;
+}
+
+int lazy_inherit_oracle_begin(int native_pid, unsigned long image_pid)
+{
+	uint64_t header[4] = {};
+	char name[64];
+	const char *value = getenv("RUNTIME_FORK_LAZY_INHERIT_ORACLE");
+	const char *capture = getenv("RUNTIME_FORK_PIPE_CAPTURE");
+	const char *cow = getenv("RUNTIME_FORK_COW_CAPTURE");
+	if (!value || !strcmp(value, "0")) return 0;
+	if ((strcmp(value, "1") && strcmp(value, "2")) || oracle_fd >= 0 || !lazy_inherit_active() ||
+	    opts.final_state != TASK_ALIVE || opts.track_mem || opts.lazy_pages ||
+	    opts.stream || opts.auto_dedup || opts.use_page_server ||
+	    !image_pid || image_pid > INT32_MAX)
+		return -1;
+	if (lazy_inherit_stream_enabled() &&
+	    ((capture && strcmp(capture, "0")) || (cow && strcmp(cow, "0"))))
+		return -1;
+	snprintf(name, sizeof(name), "lazy-oracle-%lu.bin", image_pid);
+	oracle_fd = openat(get_service_fd(IMG_FD_OFF), name,
+			  O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+	if (oracle_fd < 0) return -1;
+	oracle_native_pid = native_pid;
+	oracle_image_pid = image_pid;
+	oracle_parent_pid = inherited_parent_pid > 0 ? inherited_parent_pid : 0;
+	oracle_start = oracle_end = oracle_count = 0;
+	if (write(oracle_fd, header, sizeof(header)) != sizeof(header)) {
+		close(oracle_fd);
+		oracle_fd = -1;
+		return -1;
+	}
+	return 0;
+}
+
+int lazy_inherit_oracle_slice(uint64_t address, uint64_t limit, bool *parent, uint64_t *bytes)
+{
+	uint64_t count = oracle_count, low = 0, high;
+	if (!lazy_inherit_stream_enabled() || oracle_fd < 0 || !limit ||
+	    address % PAGE_SIZE || limit % PAGE_SIZE || limit > UINT64_MAX - address)
+		return -1;
+	if (oracle_end) {
+		if (count == LAZY_ORACLE_MAX_RANGES) return -1;
+		oracle_ranges[count].start = oracle_start;
+		oracle_ranges[count].end = oracle_end;
+		count++;
+	}
+	high = count;
+	while (low < high) {
+		uint64_t middle = low + (high - low) / 2;
+		if (oracle_ranges[middle].end <= address) low = middle + 1;
+		else high = middle;
+	}
+	*parent = low < count && oracle_ranges[low].start <= address;
+	*bytes = limit;
+	if (low < count) {
+		uint64_t boundary = *parent ? oracle_ranges[low].end : oracle_ranges[low].start;
+		if (boundary - address < *bytes) *bytes = boundary - address;
+	}
+	return *bytes && *bytes % PAGE_SIZE == 0 ? 0 : -1;
+}
+
+int lazy_inherit_oracle_page(int native_pid, uint64_t address)
+{
+	if (!lazy_inherit_oracle_enabled()) return 0;
+	if (oracle_fd < 0 || native_pid != oracle_native_pid || !oracle_parent_pid ||
+	    address & (PAGE_SIZE - 1) || address > UINT64_MAX - PAGE_SIZE ||
+	    (oracle_end && address < oracle_end))
+		return -1;
+	if (oracle_end && address != oracle_end && oracle_flush_range())
+		return -1;
+	if (!oracle_end) oracle_start = address;
+	oracle_end = address + PAGE_SIZE;
+	return 0;
+}
+
+int lazy_inherit_oracle_end(bool complete)
+{
+	uint64_t header[4];
+	int result = 0;
+	if (oracle_fd < 0) return 0;
+	if (complete) {
+		if (oracle_flush_range()) result = -1;
+		header[0] = LAZY_ORACLE_MAGIC;
+		header[1] = oracle_image_pid;
+		header[2] = oracle_parent_pid;
+		header[3] = oracle_count;
+		if (!result && (pwrite(oracle_fd, header, sizeof(header), 0) != sizeof(header) ||
+		    fsync(oracle_fd)))
+			result = -1;
+	}
+	if (close(oracle_fd)) result = -1;
+	oracle_fd = -1;
+	return result;
+}
+
+bool lazy_inherit_active(void)
+{
+	return getenv("RUNTIME_FORK_LAZY_INHERIT_SOCKET") != NULL;
+}
+
+static void alias_name(char *name, size_t size, unsigned long id)
+{
+	snprintf(name, size, "lazy-parent-%lu.bin", id);
+}
+
+int lazy_inherit_parent_id(int directory, unsigned long image_pid, unsigned long *parent_pid)
+{
+	struct { uint64_t magic, id; } alias;
+	struct stat status;
+	char name[64];
+	int fd, ret = -1;
+
+	*parent_pid = image_pid;
+	alias_name(name, sizeof(name), image_pid);
+	fd = openat(directory, name, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0) return errno == ENOENT ? 0 : -1;
+	if (fstat(fd, &status) || !S_ISREG(status.st_mode) || status.st_size != sizeof(alias)) goto out;
+	if (read(fd, &alias, sizeof(alias)) != sizeof(alias) || alias.magic != LAZY_INHERIT_MAGIC ||
+	    alias.id == 0 || alias.id > INT32_MAX) goto out;
+	*parent_pid = alias.id;
+	ret = 0;
+out:
+	close(fd);
+	return ret;
+}
+
+static const struct lazy_inherit_range *lazy_inherit_lookup(int native_pid, uint64_t address)
+{
+	uint32_t low = 0, high = inherited_count;
+	if (native_pid != inherited_native_pid) return NULL;
+	while (low < high) {
+		uint32_t middle = low + (high - low) / 2;
+		if (inherited[middle].end <= address) low = middle + 1;
+		else high = middle;
+	}
+	return low == inherited_count ? NULL : &inherited[low];
+}
+
+uint64_t lazy_inherit_next(int native_pid, uint64_t address, uint64_t limit)
+{
+	const struct lazy_inherit_range *range = lazy_inherit_lookup(native_pid, address);
+	uint64_t next;
+	if (!range || address >= limit) return limit;
+	next = address < range->start ? range->start : address;
+	return next < limit ? next : limit;
+}
+
+int lazy_inherit_missing(int native_pid, int pagemap_fd, uint64_t address, uint64_t limit)
+{
+	const struct lazy_inherit_range *range = lazy_inherit_lookup(native_pid, address);
+	size_t bytes, offset = 0;
+	uint64_t end, entry;
+	if (!range || address < range->start || address >= limit) return 0;
+	if (address < inherited_pte_start || address >= inherited_pte_end) {
+		end = address + sizeof(inherited_ptes) / sizeof(uint64_t) * PAGE_SIZE;
+		if (end > range->end) end = range->end;
+		if (end > limit) end = limit;
+		bytes = PAGE_PFN(end - address) * sizeof(uint64_t);
+		if (!bytes || bytes > sizeof(inherited_ptes)) return -1;
+		while (offset < bytes) {
+			ssize_t count = pread(pagemap_fd, (char *)inherited_ptes + offset, bytes - offset,
+					      PAGEMAP_PFN_OFF(address) + offset);
+			if (count < 0 && errno == EINTR) continue;
+			if (count <= 0) {
+				pr_perror("Reading bounded inherited pagemap");
+				return -1;
+			}
+			offset += count;
+		}
+		inherited_pte_start = address;
+		inherited_pte_end = end;
+	}
+	entry = inherited_ptes[PAGE_PFN(address - inherited_pte_start)];
+	if (range->kind == LAZY_RANGE_COPIED_WP)
+		return (entry & PME_PRESENT) && (entry & (UINT64_C(1) << 57)) &&
+			!(entry & (PME_SWAP | PME_GUARD_REGION));
+	return !(entry & (PME_PRESENT | PME_SWAP | PME_GUARD_REGION));
+}
+
+int lazy_inherit_prepare(int native_pid)
+{
+	struct lazy_inherit_request request = { .magic = LAZY_INHERIT_MAGIC, .native_pid = native_pid };
+	struct {
+		struct lazy_inherit_reply header;
+		struct lazy_inherit_range ranges[LAZY_INHERIT_MAX_RANGES];
+	} reply = {};
+	struct sockaddr_un address = { .sun_family = AF_UNIX };
+	struct timeval timeout = { .tv_sec = 5 };
+	struct ucred peer;
+	socklen_t peer_size = sizeof(peer);
+	struct stat parent;
+	union { struct cmsghdr align; char bytes[CMSG_SPACE(sizeof(int))]; } control = {};
+	struct iovec vector = { .iov_base = &request, .iov_len = sizeof(request) };
+	struct msghdr message = { .msg_iov = &vector, .msg_iovlen = 1,
+		.msg_control = control.bytes, .msg_controllen = sizeof(control.bytes) };
+	struct cmsghdr *rights;
+	const char *path = getenv("RUNTIME_FORK_LAZY_INHERIT_SOCKET");
+	const char *owner = getenv("RUNTIME_FORK_LAZY_INHERIT_DAEMON_PID");
+	int fd = -1, parentfd = -1, pidfd = -1, ret = -1, tries;
+	ssize_t bytes;
+	uint32_t i;
+	const char *stage = "settings";
+
+	inherited_count = 0;
+	inherited_native_pid = -1;
+	inherited_parent_pid = -1;
+	inherited_pte_start = inherited_pte_end = 0;
+	if (!path) return 0;
+	/* Local immutable payloads only. Resident pages always use current state. */
+	if (!owner || !opts.img_parent || opts.auto_dedup || opts.stream || opts.use_page_server || opts.track_mem)
+		return -1;
+	if (strlen(path) >= sizeof(address.sun_path)) return -1;
+	strcpy(address.sun_path, path);
+	stage = "parent_directory";
+	if (open_parent(get_service_fd(IMG_FD_OFF), &parentfd) || parentfd < 0 || fstat(parentfd, &parent)) goto out;
+	request.parent_dev = parent.st_dev;
+	request.parent_ino = parent.st_ino;
+	pidfd = syscall(SYS_pidfd_open, native_pid, 0);
+	if (pidfd < 0) goto out;
+	rights = CMSG_FIRSTHDR(&message);
+	rights->cmsg_level = SOL_SOCKET;
+	rights->cmsg_type = SCM_RIGHTS;
+	rights->cmsg_len = CMSG_LEN(sizeof(int));
+	memcpy(CMSG_DATA(rights), &pidfd, sizeof(int));
+	stage = "request_nonce";
+	if (getrandom(&request.nonce, sizeof(request.nonce), 0) != sizeof(request.nonce)) goto out;
+	for (tries = 0; tries < 100; tries++) {
+		stage = "connect";
+		fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+		if (fd < 0 || setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) ||
+		    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout)) ||
+		    connect(fd, (struct sockaddr *)&address, sizeof(address))) goto out;
+		stage = "daemon_credentials";
+		if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &peer, &peer_size) || peer.uid != geteuid() ||
+		    peer.pid != strtol(owner, NULL, 10)) goto out;
+		stage = "send_request";
+		if (sendmsg(fd, &message, MSG_NOSIGNAL) != sizeof(request)) goto out;
+		stage = "receive_reply";
+		bytes = recv(fd, &reply, sizeof(reply), MSG_TRUNC);
+		close(fd);
+		fd = -1;
+		if (bytes < sizeof(reply.header) || reply.header.magic != LAZY_INHERIT_MAGIC ||
+		    reply.header.nonce != request.nonce || reply.header.reserved) goto out;
+		if (reply.header.status == EAGAIN) { usleep(10000); continue; }
+		stage = "snapshot_reply";
+		if (reply.header.status || reply.header.count > LAZY_INHERIT_MAX_RANGES ||
+		    bytes != sizeof(reply.header) + reply.header.count * sizeof(reply.ranges[0])) goto out;
+		break;
+	}
+	if (tries == 100) goto out;
+	stage = "validate_ranges";
+	for (i = 0; i < reply.header.count; i++) {
+		struct lazy_inherit_range *range = &reply.ranges[i];
+		if (range->kind > LAZY_RANGE_COPIED_WP ||
+		    (range->kind == LAZY_RANGE_COPIED_WP &&
+		     (!getenv("RUNTIME_FORK_LAZY_WP") || strcmp(getenv("RUNTIME_FORK_LAZY_WP"), "1"))) ||
+		    range->start >= range->end || (range->start | range->end) & (PAGE_SIZE - 1) ||
+		    (i && range->start < reply.ranges[i - 1].end)) goto out;
+	}
+	if (reply.header.count) {
+		if (reply.header.image_pid <= 0) goto out;
+		memcpy(inherited, reply.ranges, reply.header.count * sizeof(inherited[0]));
