+/* The owned controller requests materialization before any recapture. A
+ * signalfd wakes the real nested epoll loop; no async signal handler changes
+ * IOVs. Existing UFFD remove/remap/fault bookkeeping remains authoritative.
+ * Successful daemon exit, not receipt of this request, is the barrier.
+ */
+static int lazy_capture_read_event(struct epoll_rfd *rfd)
+{
+	struct signalfd_siginfo info;
+	ssize_t bytes;
+
+	bytes = read(rfd->fd, &info, sizeof(info));
+	if (bytes != sizeof(info) ||
+	    (info.ssi_signo != SIGUSR1 && !(lazy_observe_enabled && info.ssi_signo == SIGUSR2))) {
+		pr_err("Invalid lazy capture materialization request\n");
+		return -1;
+	}
+	if (info.ssi_signo == SIGUSR2) {
+		if (lazy_observe_snapshot(false)) {
+			pr_perror("Writing owned lazy diagnostic snapshot");
+			return -1;
+		}
+		return 1;
+	}
+	lazy_capture_requested = true;
+	pr_info("Capture materialization requested\n");
+	return 1;
+}
