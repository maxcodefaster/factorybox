+#ifndef RUNTIME_FORK_LAZY_LINEAGE_GUARD_H
+#define RUNTIME_FORK_LAZY_LINEAGE_GUARD_H
+
+#include <stdbool.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <sys/vfs.h>
+#include <unistd.h>
+
+struct lazy_lineage_settings {
+	const char *runtime_id, *images, *parent, *socket, *daemon_pid;
+	const char *relative_parent, *freeze_cgroup;
+	int image_fd;
+	bool proof, capture, fresh, scope, nested, identity, wp;
+};
+
+static bool lazy_lineage_hex(const char *text, size_t count)
+{
+	size_t i;
+	for (i = 0; i < count; i++)
+		if (!((text[i] >= '0' && text[i] <= '9') ||
+		      (text[i] >= 'a' && text[i] <= 'f'))) return false;
+	return true;
+}
+
+/* A separate contract for an already restored, canonically identified runtime.
+ * The first-source exception in config.c remains independently constrained.
+ */
+static bool lazy_lineage_guard(const struct lazy_lineage_settings *s, const char **reason)
+{
+	char root[PATH_MAX], group[PATH_MAX], relative[PATH_MAX], actual[PATH_MAX];
+	struct stat directory, descriptor, parent, socket;
+	struct statfs fs;
+	const char *tail;
+	char *end;
+	long daemon;
+	size_t length;
+
+	*reason = "policy";
+	if (!s || !s->proof || !s->capture || !s->fresh || !s->scope ||
+	    !s->nested || !s->identity || !s->wp || !s->runtime_id ||
+	    !s->images || !s->parent || !s->socket || !s->daemon_pid ||
+	    !s->relative_parent || !s->freeze_cgroup) return false;
+	*reason = "runtime_identity";
+	if (!strcmp(s->runtime_id, "copy-sysbox")) {
+		snprintf(root, sizeof(root), "/experiment/sysbox-copy");
+		snprintf(group, sizeof(group), "/sys/fs/cgroup/criu-probe-sysbox-copy");
+	} else {
+		if (strlen(s->runtime_id) != 39 || strncmp(s->runtime_id, "branch-", 7) ||
+		    !lazy_lineage_hex(s->runtime_id + 7, 32)) return false;
+		snprintf(root, sizeof(root), "/experiment/branches/%s", s->runtime_id);
+		snprintf(group, sizeof(group), "/sys/fs/cgroup/criu-probe-%s", s->runtime_id);
+	}
+	if (strcmp(s->freeze_cgroup, group)) return false;
+	length = strlen(root);
+	*reason = "fresh_image_path";
+	if (strncmp(s->images, root, length) || s->images[length] != '/') return false;
+	tail = s->images + length + 1;
+	if (strlen(tail) != 39 || strncmp(tail, "images-", 7) ||
+	    !lazy_lineage_hex(tail + 7, 32) ||
+	    !realpath(s->images, actual) || strcmp(actual, s->images)) return false;
+	*reason = "image_descriptor";
+	if (s->image_fd < 0 || lstat(s->images, &directory) || fstat(s->image_fd, &descriptor) ||
+	    !S_ISDIR(directory.st_mode) || !S_ISDIR(descriptor.st_mode) ||
+	    directory.st_dev != descriptor.st_dev || directory.st_ino != descriptor.st_ino ||
+	    directory.st_uid != 165536 || directory.st_gid != 165536 ||
+	    (directory.st_mode & 07777) != 0700) return false;
+	*reason = "parent_path";
+	if (strncmp(s->parent, root, length) || s->parent[length] != '/' ||
+	    !strcmp(s->parent, s->images) || !realpath(s->parent, actual) ||
+	    strcmp(actual, s->parent)) return false;
+	if (snprintf(relative, sizeof(relative), "../%s", s->parent + length + 1) >= (int)sizeof(relative) ||
+	    strcmp(relative, s->relative_parent)) return false;
+	*reason = "readonly_parent";
+	if (lstat(s->parent, &parent) || !S_ISDIR(parent.st_mode) ||
+	    parent.st_uid != 165536 || parent.st_gid != 165536 ||
+	    (parent.st_mode & 07777) != 0700 || statfs(s->parent, &fs) ||
+	    !(fs.f_flags & ST_RDONLY)) return false;
+	*reason = "private_endpoint";
+	if (strncmp(s->socket, root, length) || s->socket[length] != '/') return false;
+	tail = s->socket + length + 1;
+	if (strlen(tail) != 39 || strncmp(tail, "i-", 2) ||
+	    !lazy_lineage_hex(tail + 2, 32) || strcmp(tail + 34, ".sock") ||
+	    strlen(s->socket) >= 108 || lstat(s->socket, &socket) ||
+	    !S_ISSOCK(socket.st_mode) || (socket.st_mode & 07777) != 0600 ||
+	    socket.st_uid != geteuid()) return false;
+	*reason = "daemon_identity";
+	errno = 0;
+	daemon = strtol(s->daemon_pid, &end, 10);
+	if (errno || end == s->daemon_pid || *end || daemon <= 1 || daemon > INT_MAX) return false;
+	*reason = "accepted";
+	return true;
+}
+#endif
