+int sysbox_async_begin(pid_t pid, struct parasite_ctl *ctl, struct vm_area_list *vmas, bool *previous)
+{
+	int fd = -1, device;
+	struct uffdio_api api = { .api = UFFD_API,
+		.features = UFFD_FEATURE_WP_ASYNC | UFFD_FEATURE_WP_UNPOPULATED | UFFD_FEATURE_PAGEFAULT_FLAG_WP };
+	struct vma_area *vma;
+
+	*previous = false;
+	if (keeper_call(pid, 1, -1, &fd))
+		return -1;
+	if (fd >= 0) {
+		list_for_each_entry(vma, &vmas->h, list) {
+			int registered = sysbox_async_register(fd, vma);
+			if (registered == -ESRCH)
+				break;
+			if (registered < 0) {
+				close(fd);
+				return -1;
+			}
+			if (registered == 1) {
+				*previous = true;
+				return fd;
+			}
+		}
+		close(fd);
+		fd = -1;
+	}
+	device = userns_call(open_tracking_device, UNS_FDOUT, NULL, 0, -1);
+	if (device < 0)
+		return -1;
+	fd = parasite_create_tracking_uffd(ctl, device);
+	close(device);
+	if (fd < 0)
+		return -1;
+	if (ioctl(fd, UFFDIO_API, &api) ||
+	    (api.features & (UFFD_FEATURE_WP_ASYNC | UFFD_FEATURE_WP_UNPOPULATED)) !=
+	    (UFFD_FEATURE_WP_ASYNC | UFFD_FEATURE_WP_UNPOPULATED)) {
+		pr_perror("Enable actual async write tracking for %d", pid);
+		close(fd);
+		return -1;
+	}
+	return fd;
+}
+
+int sysbox_async_register(int fd, struct vma_area *vma)
+{
+	struct uffdio_register registration = {
+		.range = { .start = vma->e->start, .len = vma_area_len(vma) },
+		.mode = UFFDIO_REGISTER_MODE_WP,
+	};
+	if (!vma_area_is_private(vma, kdat.task_size) || vma_entry_is(vma->e, VMA_AREA_VDSO) ||
+	    vma_entry_is(vma->e, VMA_AREA_AIORING) || vma->e->flags & MAP_HUGETLB)
+		return 0;
+	if (ioctl(fd, UFFDIO_REGISTER, &registration)) {
+		if (errno == ESRCH)
+			return -ESRCH;
+		/* Unsupported mappings and a different existing lazy uffd context
+		 * always get complete page payloads. Never infer cleanliness there. */
+		if (errno == EINVAL || errno == EBUSY || errno == EPERM)
+			return 0;
+		pr_perror("Register owned async-tracked VMA %llx", (unsigned long long)vma->e->start);
+		return -1;
+	}
+	return 1;
+}
