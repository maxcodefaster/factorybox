+static int open_tracking_device(void *arg, int fd, pid_t pid)
+{
+	(void)arg; (void)fd; (void)pid;
+	return open("/dev/userfaultfd", O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+}
