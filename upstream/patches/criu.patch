+int sysbox_async_reset_and_keep(int fd, pid_t pid, struct vm_area_list *vmas, bool reset)
+{
+	struct vma_area *vma;
+	unsigned tracked = 0, complete = 0;
+	int output, pagemap;
+	unsigned long long ranges = 0, bytes = 0;
+	struct page_region regions[256];
+	int result = -1;
+
+	/* A fixed parent always represents the original baseline. Resetting WP
+	 * after a child dump would mark changed pages clean relative to a newer
+	 * state, making the next child inherit stale bytes from that parent.
+	 * Keep dirty pages cumulative until a new baseline is established.
+	 */
+	if (!reset) {
+		if (keeper_call(pid, 2, fd, &output))
+			return -1;
+		pr_info("Async tracking cumulative pid=%d fixed parent retained without reset\n", pid);
+		return 0;
+	}
+	pagemap = open_proc(pid, "pagemap");
+	if (pagemap < 0)
+		return -1;
+
+	list_for_each_entry(vma, &vmas->h, list) {
+		int registered = sysbox_async_register(fd, vma);
+		unsigned long long cursor = vma->e->start;
+		if (registered < 0)
+			goto out;
+		if (!registered) {
+			complete++;
+			continue;
+		}
+		/* Whole-range WP and even PM_SCAN_WP_MATCHING can create markers
+		 * in absent PTEs. This kernel reports them as swapped payload pages.
+		 * Enumerate actual saved pages first, then protect only exact ranges.
+		 * A newly materialized page has no WP bit and is captured as dirty.
+		 */
+		while (cursor < vma->e->end) {
+			struct pm_scan_arg scan = {
+				.size = sizeof(scan), .start = cursor, .end = vma->e->end,
+				.vec = (uintptr_t)regions, .vec_len = 256,
+				.category_inverted = PAGE_IS_PFNZERO | PAGE_IS_FILE,
+				.category_mask = PAGE_IS_PFNZERO | PAGE_IS_FILE,
+				.category_anyof_mask = PAGE_IS_PRESENT | PAGE_IS_SWAPPED,
+				.return_mask = PAGE_IS_PRESENT | PAGE_IS_SWAPPED,
+			};
+			int count = ioctl(pagemap, PAGEMAP_SCAN, &scan);
+			if (count < 0 || count > 256 || scan.walk_end <= cursor || scan.walk_end > scan.end) {
+				pr_perror("Enumerate actual async baseline pages");
+				goto out;
+			}
+			for (int i = 0; i < count; i++) {
+				struct uffdio_writeprotect protect = {
+					.range = { .start = regions[i].start, .len = regions[i].end - regions[i].start },
+					.mode = UFFDIO_WRITEPROTECT_MODE_WP,
+				};
+				if (regions[i].start < cursor || regions[i].end > scan.walk_end || regions[i].end <= regions[i].start ||
+				    !(regions[i].categories & (PAGE_IS_PRESENT | PAGE_IS_SWAPPED)) ||
+				    ioctl(fd, UFFDIO_WRITEPROTECT, &protect)) {
+					pr_perror("Reset exact materialized async-tracked range");
+					goto out;
+				}
+				ranges++;
+				bytes += protect.range.len;
+			}
+			cursor = scan.walk_end;
+		}
+		tracked++;
+	}
+	if (keeper_call(pid, 2, fd, &output))
+		goto out;
+	pr_info("Async tracking baseline pid=%d tracked_vmas=%u complete_vmas=%u exact_ranges=%llu bytes=%llu retained outside source\n",
+		pid, tracked, complete, ranges, bytes);
+	result = 0;
+out:
+	close(pagemap);
+	return result;
+}
