+	snprintf(path, sizeof(path), "/proc/%d/pagemap", stage->lpi->identity.pid);
+	fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0)
+		return -1;
+	list_for_each_entry(iov, &stage->copied, l) {
+		unsigned long cursor = iov->start;
+		while (cursor < iov->end) {
+			unsigned long count = min((iov->end - cursor) / PAGE_SIZE,
+						   (unsigned long)(sizeof(ptes) / sizeof(ptes[0])));
+			size_t bytes = count * sizeof(ptes[0]), offset = 0;
+			unsigned long index = 0;
+			while (offset < bytes) {
+				ssize_t got = pread(fd, (char *)ptes + offset, bytes - offset,
+						    cursor / PAGE_SIZE * sizeof(ptes[0]) + offset);
+				if (got < 0 && errno == EINTR)
+					continue;
+				if (got <= 0)
+					goto out;
+				offset += got;
+			}
+			while (index < count) {
+				unsigned long begin;
+				struct lazy_epoch_wp protect;
+				while (index < count && (!(ptes[index] & (UINT64_C(1) << 63)) ||
+				       ptes[index] & ((UINT64_C(1) << 62) | (UINT64_C(1) << 58))))
+					index++;
+				begin = index;
+				while (index < count && ptes[index] & (UINT64_C(1) << 63) &&
+				       !(ptes[index] & ((UINT64_C(1) << 62) | (UINT64_C(1) << 58))))
+					index++;
+				if (begin == index)
+					continue;
+				if (fail_after && *calls >= fail_after) {
+					errno = EIO;
+					goto out;
+				}
+				protect = (struct lazy_epoch_wp){
+					.range = { .start = cursor + begin * PAGE_SIZE,
+						   .len = (index - begin) * PAGE_SIZE },
+					.mode = LAZY_EPOCH_WP_MODE,
+				};
+				if (ioctl(stage->lpi->lpfd.fd, LAZY_EPOCH_WRITEPROTECT, &protect))
+					goto out;
+				(*calls)++;
+				*pages += index - begin;
+			}
+			cursor += count * PAGE_SIZE;
+		}
+	}
+	result = 0;
+out:
+	close(fd);
+	return result;
+}
