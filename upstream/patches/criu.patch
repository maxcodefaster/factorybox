+			pr_err("Unsupported descendant of nested cgroup2 mount\n");
+			return -1;
+		}
+	}
+	root_fd = fdstore_get(nsid->mnt.root_fd_id);
+	if (root_fd < 0)
+		return -1;
+	snprintf(target, sizeof(target), "/proc/self/fd/%d%s", root_fd, cg->ns_mountpoint);
+	pr_info("Nested cgroup2 mount: flags=%x sb_flags=%x options=%s\n", cg->flags, cg->sb_flags, cg->options);
+	/* VFS rejects a same-superblock mount over an existing mount root.
+	 * This task owns the private mount namespace; no descendants or
+	 * sharing were accepted above. Detach only this old cgroup2 view. */
+	if (umount2(target, MNT_DETACH)) {
+		pr_perror("Can't detach old nested cgroup2 view");
+		goto out;
+	}
+
+	if (mount("cgroup2", target, "cgroup2", cg->sb_flags & ~(MS_PROPAGATE | MS_RDONLY), NULL)) {
+		pr_perror("Can't mount cgroup2 for nested cgroup namespace");
+		goto out;
+	}
+	/* Readonly is a per-mount restriction, not a new superblock setting. */
+	if (mount(NULL, target, NULL, MS_REMOUNT | MS_BIND | (cg->flags & MS_MNT_KNOWN_FLAGS), NULL)) {
+		pr_perror("Can't restore nested cgroup2 mount flags");
+		goto out;
+	}
+
+	pr_info("Restored cgroup2 view in nested cgroup namespace for image PID %d\n", vpid(item));
+	ret = 0;
+out:
+	close(root_fd);
+	return ret;
+}
+
+/*
+ * Standard mount-v2 assembles every same-userns mount tree in the outer
+ * task, before the inner PID namespaces exist. Its proc mounts therefore
+ * expose the outer PID namespace. Replace that tree in the inner reaper,
+ * before it forks children or restores files. Keep every saved mask and
+ * readonly bind beneath proc; proc-backed binds use the new proc instance.
+ * Unhandled sharing or multiple PID owners must fail, not weaken isolation.
+ */
+static bool nested_ancestor_proc_mask(struct mount_info *mi)
+{
+	struct ns_id *root_nsid;
+	struct mount_info *root_proc;
+	const char *allowed[] = { "/asound", "/bus", "/fs", "/irq", "/sysrq-trigger" };
+	int i;
+	bool allowed_root = false;
+
+	/* Sysbox masks these non-process proc entries by readonly binds from
+	 * the system container. Preserve the restored ancestor view, never
+	 * arbitrary foreign proc/PID trees or writable ancestor mounts.
+	 */
+	if (!(mi->flags & MS_RDONLY))
+		return false;
+	for (i = 0; i < ARRAY_SIZE(allowed); i++)
+		if (!strcmp(mi->root, allowed[i]))
+			allowed_root = true;
+	if (!allowed_root)
+		return false;
+	root_nsid = lookup_ns_by_id(root_item->ids->mnt_ns_id, &mnt_ns_desc);
+	if (!root_nsid)
+		return false;
+	for_each_ns_mount(root_proc, root_nsid)
+		if (root_proc->fstype->code == FSTYPE__PROC && !strcmp(root_proc->root, "/") &&
+		    root_proc->s_dev == mi->s_dev)
+			return true;
+	return false;
+}
+
+static int nested_proc_detached_mount(struct mount_info *proc)
+{
+	int fsfd, fd = -1;
+	char *options, *option, *next, *value;
+	unsigned int flags = proc->sb_flags | proc->flags;
+	unsigned int attrs = flags & (MS_RDONLY | MS_NOSUID | MS_NODEV | MS_NOEXEC);
+	unsigned int supported = MS_RDONLY | MS_NOSUID | MS_NODEV | MS_NOEXEC |
+		MS_RELATIME | MS_NOATIME | MS_NODIRATIME | MS_STRICTATIME | MS_PROPAGATE;
+
+	if (flags & ~supported) {
+		pr_err("Unsupported detached proc mount flags %x\n", flags);
+		return -1;
+	}
+	if (flags & MS_NOATIME)
+		attrs |= MOUNT_ATTR_NOATIME;
+	if (flags & MS_NODIRATIME)
+		attrs |= MOUNT_ATTR_NODIRATIME;
+	if (flags & MS_STRICTATIME)
+		attrs |= MOUNT_ATTR_STRICTATIME;
+	options = xstrdup(proc->options ? proc->options : "");
+	if (!options)
+		return -1;
+	fsfd = cr_fsopen("proc", FSOPEN_CLOEXEC);
+	if (fsfd < 0)
+		goto out;
+	for (option = strtok_r(options, ",", &next); option; option = strtok_r(NULL, ",", &next)) {
+		value = strchr(option, '=');
+		if (value)
+			*value++ = '\0';
+		if (cr_fsconfig(fsfd, value ? FSCONFIG_SET_STRING : FSCONFIG_SET_FLAG, option, value, 0))
+			goto out_close;
+	}
+	if (cr_fsconfig(fsfd, FSCONFIG_CMD_CREATE, NULL, NULL, 0))
+		goto out_close;
+	fd = cr_fsmount(fsfd, FSMOUNT_CLOEXEC, attrs);
+out_close:
+	close(fsfd);
+out:
+	xfree(options);
+	return fd;
+}
+
+int nested_ns_child_proc(struct pstree_item *item)
+{
+	struct ns_id *nsid;
+	struct mount_info *mi, *proc = NULL, *children[MAX_BIND_FDS];
+	struct pstree_item *other;
+	int fds[MAX_BIND_FDS], n = 0, i, j, root_fd, fresh_proc_fd = -1, ret = -1;
+	char target[PATH_MAX], source[PATH_MAX];
+	size_t len;
+
+	if (!nested_ns_enabled() || item == root_item ||
+	    !(rsti(item)->clone_flags & CLONE_NEWPID) || nested_ns_skip_mntns(item))
+		return 0;
+
+	nsid = lookup_ns_by_id(item->ids->mnt_ns_id, &mnt_ns_desc);
+	if (!nsid)
+		return -1;
+	for_each_pstree_item(other) {
+		if (other->ids && other->ids->mnt_ns_id == item->ids->mnt_ns_id &&
+		    other->ids->pid_ns_id != item->ids->pid_ns_id) {
+			pr_err("Nested proc restore needs one PID namespace per mount namespace\n");
+			return -1;
+		}
+	}
+	for_each_ns_mount(mi, nsid) {
+		if (mi->fstype->code != FSTYPE__PROC || strcmp(mi->root, "/"))
+			continue;
+		if (proc || mi->shared_id || mi->master_id) {
+			pr_err("Unsupported multiple or shared nested proc mounts\n");
+			return -1;
+		}
+		proc = mi;
+	}
+	if (!proc) {
+		pr_err("Nested PID namespace has no proc root mount\n");
+		return -1;
+	}
+	len = strlen(proc->ns_mountpoint);
+	for_each_ns_mount(mi, nsid) {
+		if (strncmp(mi->ns_mountpoint, proc->ns_mountpoint, len) || mi->ns_mountpoint[len] != '/')
+			continue;
+		if (n == MAX_BIND_FDS || mi->shared_id || mi->master_id) {
+			pr_err("Unsupported nested proc descendant mount\n");
+			return -1;
+		}
+		/* Parents must be attached before child mounts. */
+		for (j = n; j && strlen(children[j - 1]->ns_mountpoint) > strlen(mi->ns_mountpoint); j--)
+			children[j] = children[j - 1];
+		children[j] = mi;
+		n++;
+	}
+	for (i = 0; i < n; i++)
+		fds[i] = -1;
+	root_fd = fdstore_get(nsid->mnt.root_fd_id);
+	if (root_fd < 0)
+		return -1;
+
+	/* Pin non-proc masks before the fresh proc mount hides them. */
+	for (i = 0; i < n; i++) {
+		mi = children[i];
+		if (mi->fstype->code == FSTYPE__PROC) {
+			if (mi->s_dev == proc->s_dev)
+				continue;
+			if (!nested_ancestor_proc_mask(mi)) {
+				pr_err("Unsupported nested proc bind owner: root=%s target=%s flags=%x\n",
+				       mi->root, mi->ns_mountpoint, mi->flags);
+				goto out;
+			}
+			pr_info("Preserving readonly ancestor proc mask %s\n", mi->ns_mountpoint);
+		}
+		fds[i] = sys_open_tree(root_fd, mi->ns_mountpoint + 1,
+				      OPEN_TREE_CLONE | O_CLOEXEC | AT_SYMLINK_NOFOLLOW);
+		if (fds[i] < 0) {
+			pr_perror("Can't preserve nested proc mask %s", mi->ns_mountpoint);
+			goto out;
+		}
+	}
+
+	/* Replace the old instance after pinning its masks. Stacking a fresh
+	 * proc mount hides the old PID view but leaves it in the namespace;
+	 * another checkpoint would capture both instances at the same path.
+	 * Create the new mount while the existing proc tree is still visible:
+	 * Linux's userns proc visibility checks require that view. After detach,
+	 * attach by descriptors because /proc/self/fd temporarily disappears.
+	 */
+	fresh_proc_fd = nested_proc_detached_mount(proc);
+	if (fresh_proc_fd < 0) {
+		pr_perror("Can't create detached proc for nested PID namespace");
+		goto out;
+	}
+	snprintf(target, sizeof(target), "/proc/self/fd/%d%s", root_fd, proc->ns_mountpoint);
+	if (umount2(target, MNT_DETACH)) {
+		pr_perror("Can't detach the old nested proc tree");
+		goto out;
+	}
+	if (sys_move_mount(fresh_proc_fd, "", root_fd, proc->ns_mountpoint + 1, MOVE_MOUNT_F_EMPTY_PATH)) {
+		pr_perror("Can't attach fresh proc for nested PID namespace");
+		goto out;
+	}
+	for (i = 0; i < n; i++) {
+		mi = children[i];
+		if (mi->fstype->code == FSTYPE__PROC && mi->s_dev == proc->s_dev) {
+			snprintf(source, sizeof(source), "%s%s", proc->ns_mountpoint, mi->root);
+			fds[i] = sys_open_tree(root_fd, source + 1,
+					      OPEN_TREE_CLONE | O_CLOEXEC | AT_SYMLINK_NOFOLLOW);
+			if (fds[i] < 0) {
+				pr_perror("Can't bind from fresh nested proc");
+				goto out;
+			}
+		}
+		if (sys_move_mount(fds[i], "", root_fd, mi->ns_mountpoint + 1, MOVE_MOUNT_F_EMPTY_PATH)) {
+			pr_perror("Can't restore nested proc descendant %s", mi->ns_mountpoint);
+			goto out;
+		}
+		snprintf(target, sizeof(target), "/proc/self/fd/%d%s", root_fd, mi->ns_mountpoint);
+		if (mount(NULL, target, NULL, MS_REMOUNT | MS_BIND | (mi->flags & MS_MNT_KNOWN_FLAGS), NULL)) {
+			pr_perror("Can't restore nested proc descendant flags");
+			goto out;
+		}
+	}
+	pr_info("Restored proc tree in nested PID namespace for image PID %d\n", vpid(item));
+	ret = 0;
+out:
+	if (fresh_proc_fd >= 0)
+		close(fresh_proc_fd);
+	for (i = 0; i < n; i++)
+		if (fds[i] >= 0)
+			close(fds[i]);
+	close(root_fd);
+	return ret;
+}
 
