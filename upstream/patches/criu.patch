+static int lazy_inherit_read_event(struct epoll_rfd *rfd)
+{
+	struct lazy_inherit_request request = {};
+	struct {
+		struct lazy_inherit_reply header;
+		struct lazy_inherit_range ranges[LAZY_INHERIT_MAX_RANGES];
+	} reply = { .header = { .magic = LAZY_INHERIT_MAGIC, .status = EINVAL } };
+	struct lazy_pages_info *lpi, *next, *target = NULL;
+	struct lazy_iov *iov;
+	struct stat image;
+	struct ucred peer;
+	socklen_t peer_size = sizeof(peer);
+	struct timeval timeout = { .tv_sec = 2 };
+	union { struct cmsghdr align; char bytes[CMSG_SPACE(sizeof(int))]; } control = {};
+	struct iovec vector = { .iov_base = &request, .iov_len = sizeof(request) };
+	struct msghdr message = { .msg_iov = &vector, .msg_iovlen = 1,
+		.msg_control = control.bytes, .msg_controllen = sizeof(control.bytes) };
+	struct cmsghdr *rights;
+	int pidfd = -1;
+	bool bad_rights = false;
+	ssize_t received;
+	int client = accept4(rfd->fd, NULL, NULL, SOCK_CLOEXEC);
+	size_t length;
+
+	if (client < 0) return errno == EAGAIN ? 0 : -1;
+	if (setsockopt(client, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) ||
+	    setsockopt(client, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout)) ||
+	    getsockopt(client, SOL_SOCKET, SO_PEERCRED, &peer, &peer_size) || peer.uid != geteuid()) goto respond;
+	received = recvmsg(client, &message, MSG_TRUNC | MSG_CMSG_CLOEXEC);
+	for (rights = CMSG_FIRSTHDR(&message); rights; rights = CMSG_NXTHDR(&message, rights)) {
+		size_t count, i;
+		int *descriptors;
+		if (rights->cmsg_level != SOL_SOCKET || rights->cmsg_type != SCM_RIGHTS ||
+		    rights->cmsg_len < CMSG_LEN(sizeof(int))) { bad_rights = true; continue; }
+		count = (rights->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+		descriptors = (int *)CMSG_DATA(rights);
+		for (i = 0; i < count; i++) {
+			if (pidfd < 0) pidfd = descriptors[i];
+			else { close(descriptors[i]); bad_rights = true; }
+		}
+	}
+	if (received != sizeof(request) || bad_rights || pidfd < 0 ||
+	    message.msg_flags & (MSG_CTRUNC | MSG_TRUNC)) goto respond;
+	reply.header.nonce = request.nonce;
+	/* Resolve the task in the daemon's PID namespace, even when the
+	 * dumper observes it through a different nested /proc namespace.
+	 */
+	request.native_pid = lazy_identity_pid(pidfd);
+	if (request.magic != LAZY_INHERIT_MAGIC || request.reserved || request.native_pid <= 0 ||
+	    !restore_finished || opts.use_page_server || opts.stream || opts.auto_dedup ||
+	    fstat(lazy_epoch_image_dir(), &image) || request.parent_dev != image.st_dev ||
+	    request.parent_ino != image.st_ino) goto respond;
+	reply.header.status = EBUSY;
+	if (!lazy_inherit_frozen(request.native_pid)) goto respond;
+	list_for_each_entry_safe(lpi, next, &lpis, l) {
+		if (lazy_inherit_drain_uffd(lpi)) goto respond;
+		if (lpi->identity.pid == request.native_pid &&
+		    lazy_identity_pid(lpi->identity.pidfd) == request.native_pid) target = lpi;
+	}
+	if (!list_empty(&pending_lpis)) { reply.header.status = EAGAIN; goto respond; }
+	/* Fork-created MMs have no proven identity. Materialize these and any
+	 * unsafe original MM before acknowledging metadata for the frozen tree.
+	 */
+	list_for_each_entry_safe(lpi, next, &lpis, l) {
+		bool safe = lazy_identity_drain(&lpi->identity);
+		if (!safe) copied_disable(lpi);
+		if (lazy_inherit_materialize(lpi, !safe)) goto respond;
+	}
+	if (!list_empty(&pending_lpis)) { reply.header.status = EAGAIN; goto respond; }
+	if (target && !target->exited && lazy_identity_drain(&target->identity)) {
+		reply.header.image_pid = target->pid;
+		list_for_each_entry(iov, &target->iovs, l) {
+			if (iov->start != iov->img_start || iov->zero_fill || iov->fault_requested ||
+			    !list_empty(&target->reqs) || reply.header.count == LAZY_INHERIT_MAX_RANGES) goto respond;
+			reply.ranges[reply.header.count++] = (struct lazy_inherit_range){
+				iov->start, iov->end, LAZY_RANGE_MISSING };
+		}
+		if (lazy_wp_enabled() && !target->copied_tracking_disabled)
+			list_for_each_entry(iov, &target->copied, l) {
+				if (reply.header.count == LAZY_INHERIT_MAX_RANGES) break;
+				reply.ranges[reply.header.count++] = (struct lazy_inherit_range){
+					iov->start, iov->end, LAZY_RANGE_COPIED_WP };
+			}
+		qsort(reply.ranges, reply.header.count, sizeof(reply.ranges[0]), lazy_export_range_compare);
+		for (unsigned i = 1; i < reply.header.count; i++)
+			if (reply.ranges[i].start < reply.ranges[i - 1].end) goto respond;
+	}
+	if (!lazy_inherit_frozen(request.native_pid)) goto respond;
+	reply.header.status = 0;
+	pr_info("Frozen lazy export native_pid=%d parent_pid=%d ranges=%u\n",
+		request.native_pid, reply.header.image_pid, reply.header.count);
+respond:
+	if (pidfd >= 0) close(pidfd);
+	if (reply.header.status)
+		pr_warn("Lazy export rejected native_pid=%d status=%d\n", request.native_pid, reply.header.status);
+	if (reply.header.status) reply.header.count = 0;
+	length = sizeof(reply.header) + reply.header.count * sizeof(reply.ranges[0]);
+	if (send(client, &reply, length, MSG_NOSIGNAL) != length)
+		pr_warn("Lazy inheritance client disconnected\n");
+	close(client);
+	return 1;
+}
