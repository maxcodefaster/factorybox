+// One serial task at a time. This first integration keeps the original
+// writer and image format; it proves the real capture seam before a later
+// pipe-backed store is allowed to change when payload bytes are copied.
+static struct {
+	pid_t source, child;
+	long child_ns;
+	int pidfd, source_map, holder_map;
+	char group[128];
+	struct parasite_ctl *ctl;
+} hold;
+
+struct advice_restore {
+	unsigned long start, length;
+	int advice;
+};
+
+static int write_control(const char *group, const char *name, const char *value)
+{
+	char path[192];
+	size_t length = strlen(value);
+	int fd, ret;
+	if (snprintf(path, sizeof(path), "%s/%s", group, name) >= (int)sizeof(path))
+		return -1;
+	fd = open(path, O_WRONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	ret = write(fd, value, length) == (ssize_t)length ? 0 : -1;
+	if (close(fd))
+		ret = -1;
+	return ret;
+}
+
+static int clone_event(pid_t source, unsigned event, pid_t child, void *argument)
+{
+	char path[64], line[4096];
+	FILE *status;
+	if (argument != &hold || source != hold.source || hold.child ||
+	    event != PTRACE_EVENT_CLONE || child <= 0)
+		return -1;
+	hold.child = child;
+	snprintf(path, sizeof(path), "/proc/%d/status", child);
+	status = fopen(path, "re");
+	if (!status)
+		return -1;
+	while (fgets(line, sizeof(line), status)) {
+		char *token, *save = NULL;
+		if (strncmp(line, "NSpid:", 6))
+			continue;
+		for (token = strtok_r(line + 6, " \t\n", &save); token;
+		     token = strtok_r(NULL, " \t\n", &save))
+			hold.child_ns = strtol(token, NULL, 10);
+		break;
+	}
+	if (fclose(status) || hold.child_ns <= 0)
+		return -1;
+	hold.pidfd = syscall(SYS_pidfd_open, child, 0);
+	return hold.pidfd < 0 ? -1 : 0;
+}
+
+static int restore_advices(struct parasite_ctl *ctl, struct advice_restore *restore, int count)
+{
+	int failed = 0;
+	while (count--) {
+		long result;
+		struct advice_restore *entry = &restore[count];
+		if (compel_syscall(ctl, __NR(madvise, 0), &result, entry->start, entry->length,
+				  entry->advice, 0, 0, 0) || result)
+			failed = -1;
+	}
+	return failed;
+}
+
+pid_t cow_capture_source(void)
+{
+	return hold.source > 0 && hold.child > 0 && hold.pidfd >= 0 &&
+		hold.source_map >= 0 && hold.holder_map >= 0 ? hold.source : 0;
+}
+
+int cow_capture_shared_prefix(uint64_t address, size_t bytes, size_t *length, int *state)
+{
+	if (!cow_capture_source())
+		return -1;
+	return cow_pin_shared_prefix(hold.source_map, hold.holder_map, address, bytes, length, state);
+}
+
+int cow_capture_retire(struct parasite_ctl *ctl, pid_t source)
+{
+	sigset_t mask, previous;
+	int status = 0, failed = 0;
+	long result;
+	pid_t child, observed = -1;
+	if (!hold.source)
+		return 0;
+	if (hold.source != source || hold.ctl != ctl)
+		return -1;
+	sigemptyset(&mask);
+	sigaddset(&mask, SIGCHLD);
+	if (sigprocmask(SIG_BLOCK, &mask, &previous))
+		return -1;
+	child = hold.child;
+	// Stop the parasite first, so raw injected syscalls restore original
+	// source registers instead of abandoning an active RPC event loop.
+	if (compel_stop_daemon(ctl))
+		failed = -1;
+	// Release both proc-MM references before helper death and source thaw.
+	if (hold.source_map >= 0 && close(hold.source_map))
+		failed = -1;
+	if (hold.holder_map >= 0 && close(hold.holder_map))
+		failed = -1;
+	hold.source_map = hold.holder_map = -1;
+	if (child > 0) {
+		if (hold.pidfd >= 0 ?
+		    syscall(SYS_pidfd_send_signal, hold.pidfd, SIGKILL, NULL, 0) :
+		    ptrace(PTRACE_KILL, child, NULL, NULL))
+			failed = -1;
+		for (int attempt = 0; attempt < 4; attempt++) {
+			observed = waitpid(child, &status, __WALL);
+			if (observed != child || !WIFSTOPPED(status))
+				break;
+		}
+		if (observed != child || !WIFSIGNALED(status) ||
+		    WTERMSIG(status) != SIGKILL)
+			failed = -1;
+		if (hold.child_ns <= 0 ||
+		    compel_syscall(ctl, __NR(wait4, 0), &result, hold.child_ns, 0, __WCLONE, 0, 0, 0) ||
+		    result != hold.child_ns)
+			failed = -1;
+	}
+	if (hold.pidfd >= 0 && close(hold.pidfd))
+		failed = -1;
+	if (hold.group[0] && rmdir(hold.group))
+		failed = -1;
+	pr_warn("COW_CAPTURE_RETIRED source=%d child=%d result=%d\n", source, child, failed);
+	memset(&hold, 0, sizeof(hold));
+	if (sigprocmask(SIG_SETMASK, &previous, NULL))
+		failed = -1;
+	return failed;
+}
+
+int cow_capture_begin(struct parasite_ctl *ctl, pid_t source, struct vm_area_list *vmas)
