+static int lazy_epoch_stage_reader(struct lazy_epoch_stage *stage, int directory)
+{
+	struct lazy_pages_info *lpi = stage->lpi;
+	struct lazy_iov *iov;
+	struct cr_img *image;
+	int result;
+
+	result = open_page_read_at(directory, lpi->pid, &stage->reader, PR_TASK);
+	if (result != 1)
+		return -1;
+	stage->reader.io_complete = lpi->pr.io_complete;
+	page_read_disable_dedup(&stage->reader);
+	image = open_image_at(directory, CR_FD_MM, O_RSTR, lpi->pid);
+	if (!image)
+		return -1;
+	result = pb_read_one_eof(image, &stage->mm, PB_MM);
+	close_image(image);
+	if (result != 1 || !stage->mm)
+		return -1;
+
+	/* Missing source pages stay missing. Split only their metadata at new
+	 * pagemap boundaries so the unchanged single-entry reader stays safe.
+	 */
+	list_for_each_entry(iov, &lpi->iovs, l) {
+		unsigned long cursor = iov->start;
+		int index = 0;
+		if (iov->start != iov->img_start || iov->zero_fill || iov->fault_requested)
+			return -1;
+		while (cursor < iov->end) {
+			PagemapEntry *pe;
+			unsigned long end;
+			while (index < stage->reader.nr_pmes &&
+			       stage->reader.pmes[index]->vaddr + pagemap_len(stage->reader.pmes[index]) <= cursor)
+				index++;
+			if (index == stage->reader.nr_pmes)
+				return -1;
+			pe = stage->reader.pmes[index];
+			end = min(iov->end, pe->vaddr + pagemap_len(pe));
+			if (cursor < pe->vaddr || end <= cursor ||
+			    (!pagemap_present(pe) && !pagemap_in_parent(pe)) ||
+			    lazy_epoch_range(&stage->missing, &stage->missing_count, cursor, end))
+				return -1;
+			cursor = end;
+		}
+	}
+
+	/* A reset can only establish cleanliness for bytes in the new image.
+	 * Clip each known copied range to data and VMA boundaries. In particular,
+	 * never apply whole-VMA WP to absent PTEs.
+	 */
+	list_for_each_entry(iov, &lpi->copied, l) {
+		int pme, vma = 0;
+		for (pme = 0; pme < stage->reader.nr_pmes; pme++) {
+			PagemapEntry *pe = stage->reader.pmes[pme];
+			unsigned long start = max(iov->start, (unsigned long)pe->vaddr);
+			unsigned long end = min(iov->end, (unsigned long)pe->vaddr + pagemap_len(pe));
+			if (start >= end || (!pagemap_present(pe) && !pagemap_in_parent(pe)))
+				continue;
+			for (; vma < stage->mm->n_vmas && start < end; vma++) {
+				VmaEntry *entry = stage->mm->vmas[vma];
+				unsigned long tail;
+				if (start >= entry->end)
+					continue;
+				if (start < entry->start)
+					return -1;
+				tail = min(end, (unsigned long)entry->end);
+				if (lazy_epoch_range(&stage->copied, &stage->copied_count, start, tail))
+					return -1;
+				start = tail;
+				if (start == end)
+					break;
+			}
+			if (start != end)
+				return -1;
+		}
+	}
+	return 0;
+}
