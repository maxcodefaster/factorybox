+	    !owned || strcmp(owned, "1") || !compel_mode_native(ctl) || hold.source ||
+	    vmas->nr > 8192) {
+		pr_err("COW_CAPTURE_SCOPE_REJECTED source=%d: canonical frozen Sysbox ownership/native-mode proof is required\n",
