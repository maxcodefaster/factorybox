+#ifndef RUNTIME_FORK_RSEQ_PAGES_H
+#define RUNTIME_FORK_RSEQ_PAGES_H
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Split a captured span at real kernel-writable rseq page boundaries.
+ * The caller supplies the registration CRIU already read with ptrace.
+ */
+static inline int pipe_capture_clip_rseq(uint64_t address, uint64_t *bytes,
+					uint64_t pointer, uint64_t size,
+					uint64_t page_size, bool *private)
+{
+	uint64_t start, end;
+	if (!pointer) return 0;
+	if (!size || !page_size || (page_size & (page_size - 1)) ||
+	    pointer > UINT64_MAX - size ||
+	    pointer + size > UINT64_MAX - (page_size - 1))
+		return -1;
+	start = pointer & ~(page_size - 1);
+	end = (pointer + size + page_size - 1) & ~(page_size - 1);
+	if (address < start) {
+		if (*bytes > start - address) *bytes = start - address;
+	} else if (address < end) {
+		*private = false;
+		if (*bytes > end - address) *bytes = end - address;
+	}
+	return 0;
+}
+#endif
