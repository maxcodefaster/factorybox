+static bool lazy_epoch_read_file(int directory, const char *name, char *buffer, size_t capacity)
+{
+	int fd = openat(directory, name, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+	ssize_t count;
+	if (fd < 0)
+		return false;
+	do {
+		count = read(fd, buffer, capacity - 1);
+	} while (count < 0 && errno == EINTR);
+	close(fd);
+	if (count <= 0 || count >= capacity - 1)
+		return false;
+	buffer[count] = 0;
+	return true;
+}
+
+static bool lazy_epoch_cgroup_frozen(int fd)
+{
+	char events[256], freeze[32];
+	return lazy_epoch_read_file(fd, "cgroup.events", events, sizeof(events)) &&
+	       lazy_epoch_read_file(fd, "cgroup.freeze", freeze, sizeof(freeze)) &&
+	       !strcmp(freeze, "1\n") && strstr(events, "frozen 1\n") && strstr(events, "populated 1\n");
+}
+
+static bool lazy_epoch_cgroup_path(int fd, char *relative, size_t capacity)
+{
+	struct statfs filesystem;
+	char descriptor[64], path[PATH_MAX];
+	ssize_t count;
+	const char *prefix = "/sys/fs/cgroup";
+	size_t length = strlen(prefix);
+	if (fstatfs(fd, &filesystem) || filesystem.f_type != 0x63677270)
+		return false;
+	snprintf(descriptor, sizeof(descriptor), "/proc/self/fd/%d", fd);
+	count = readlink(descriptor, path, sizeof(path) - 1);
+	if (count <= 0 || count == sizeof(path) - 1)
+		return false;
+	path[count] = 0;
+	if (strncmp(path, prefix, length) || path[length] != '/' ||
+	    !path[length + 1] || strstr(path, " (deleted)") || strlen(path + length) >= capacity)
+		return false;
+	strcpy(relative, path + length);
+	return true;
+}
+
+static bool lazy_epoch_cgroup_member(int pid, const char *relative)
+{
+	char path[64], line[PATH_MAX];
+	FILE *file;
+	bool found = false;
+	size_t length = strlen(relative);
+	snprintf(path, sizeof(path), "/proc/%d/cgroup", pid);
+	file = fopen(path, "r");
+	if (!file)
+		return false;
+	while (fgets(line, sizeof(line), file))
+		if (!strncmp(line, "0::", 3)) {
+			line[strcspn(line, "\n")] = 0;
+			found = !strncmp(line + 3, relative, length) &&
+				(line[3 + length] == 0 || line[3 + length] == '/');
+			break;
+		}
+	fclose(file);
+	return found;
+}
+
+static bool lazy_epoch_source_frozen(int pid, int cgroup, const char *relative)
+{
+	return cgroup < 0 ? lazy_inherit_frozen(pid) : lazy_epoch_cgroup_member(pid, relative);
