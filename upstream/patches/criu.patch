+		free(restore);
+		return -1;
+	}
+	memset(&hold, 0, sizeof(hold));
+	hold.source = source;
+	hold.ctl = ctl;
+	hold.pidfd = -1;
+	hold.source_map = hold.holder_map = -1;
+	context = compel_infect_ctx(ctl);
+	if (context->fork_event) {
+		memset(&hold, 0, sizeof(hold));
+		free(restore);
+		sigprocmask(SIG_SETMASK, &previous, NULL);
+		return -1;
+	}
+	list_for_each_entry(vma, &vmas->h, list) {
+		int advice[] = {MADV_DONTFORK, MADV_WIPEONFORK};
+		int inverse[] = {MADV_DOFORK, MADV_KEEPONFORK};
+		// Match the existing memory dumper's eligibility. MAP_DROPPABLE
+		// is already skipped there and rejects KEEPONFORK by definition.
+		// Shared/AIO/kernel mappings retain their existing eager/special
+		// algorithms; this helper never changes their source VMA policy.
+		if (vma->e->flags & MAP_DROPPABLE) {
+			droppable++;
+			continue;
+		}
+		if (!vma_area_is_private(vma, kdat.task_size) ||
+		    vma_area_is(vma, VMA_AREA_GUARD) || vma_area_is(vma, VMA_AREA_VVAR) ||
