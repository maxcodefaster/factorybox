+#ifndef RUNTIME_FORK_LAZY_IDENTITY_H
+#define RUNTIME_FORK_LAZY_IDENTITY_H
+
+#include <linux/perf_event.h>
+
+/* Owned lazy-restore experiment only. No sampling, tracing, MM anchor task
+ * or global kernel setting. Unsupported/lost observations forbid inheritance.
+ */
+struct lazy_identity {
+	int pidfd;
+	int event;
+	int pid;
+	bool safe;
+	size_t map_size;
+	struct perf_event_mmap_page *page;
+	uint64_t lost;
+	unsigned execs;
+	unsigned exits;
+};
+
+static bool lazy_identity_enabled(void)
+{
+	const char *value = getenv("RUNTIME_FORK_LAZY_IDENTITY");
+	return value && !strcmp(value, "1");
+}
+
+static void lazy_identity_init(struct lazy_identity *identity)
+{
+	memset(identity, 0, sizeof(*identity));
+	identity->pidfd = identity->event = identity->pid = -1;
+}
+
+static void lazy_identity_stop_observer(struct lazy_identity *identity)
+{
+	if (identity->page) munmap(identity->page, identity->map_size);
+	if (identity->event >= 0) close(identity->event);
+	identity->page = NULL;
+	identity->event = -1;
+	identity->safe = false;
+}
+
+static void lazy_identity_fini(struct lazy_identity *identity)
+{
+	lazy_identity_stop_observer(identity);
+	if (identity->pidfd >= 0) close(identity->pidfd);
+	identity->pidfd = -1;
+}
+
+static int lazy_identity_pid(int pidfd)
+{
+	char path[64], line[256];
+	int pid = -1;
+	FILE *file;
+
+	snprintf(path, sizeof(path), "/proc/self/fdinfo/%d", pidfd);
+	file = fopen(path, "r");
+	if (!file) return -1;
+	while (fgets(line, sizeof(line), file))
+		if (sscanf(line, "Pid:\t%d", &pid) == 1) break;
+	fclose(file);
+	return pid > 0 ? pid : -1;
+}
+
+static int lazy_identity_start(struct lazy_identity *identity, int pidfd)
+{
+	struct perf_event_attr attributes = {0};
+	long page_bytes = sysconf(_SC_PAGESIZE);
+
+	identity->pidfd = pidfd;
+	identity->pid = lazy_identity_pid(pidfd);
+	if (identity->pid < 0 || page_bytes <= 0) return -1;
+	attributes.type = PERF_TYPE_SOFTWARE;
+	attributes.size = sizeof(attributes);
+	attributes.config = PERF_COUNT_SW_DUMMY;
+	attributes.disabled = 1;
+	attributes.comm = attributes.comm_exec = attributes.task = 1;
+	attributes.exclude_kernel = attributes.exclude_hv = 1;
+	attributes.read_format = PERF_FORMAT_LOST;
+	attributes.watermark = 1;
+	attributes.wakeup_watermark = 1;
+	identity->event = syscall(SYS_perf_event_open, &attributes, identity->pid, -1, -1, PERF_FLAG_FD_CLOEXEC);
+	if (identity->event < 0) return -1;
+	identity->map_size = (size_t)page_bytes * 9;
+	identity->page = mmap(NULL, identity->map_size, PROT_READ | PROT_WRITE, MAP_SHARED, identity->event, 0);
+	if (identity->page == MAP_FAILED) {
+		identity->page = NULL;
+		return -1;
+	}
+	if (ioctl(identity->event, PERF_EVENT_IOC_ENABLE, 0)) return -1;
+	identity->safe = true;
+	return 0;
+}
+
+static void lazy_identity_ring_copy(unsigned char *ring, size_t size, uint64_t position, void *target, size_t length)
+{
+	size_t start = position % size;
+	size_t first = length < size - start ? length : size - start;
+	memcpy(target, ring + start, first);
+	memcpy((unsigned char *)target + first, ring, length - first);
+}
+
+static bool lazy_identity_drain(struct lazy_identity *identity)
+{
+	struct perf_event_mmap_page *page = identity->page;
+	struct { uint64_t value, lost; } counters;
+	struct pollfd alive = { .fd = identity->pidfd, .events = POLLIN };
+	unsigned char *ring;
+	uint64_t head, tail;
+	size_t size;
+
+	if (!identity->safe || !page) return false;
+	if (poll(&alive, 1, 0) != 0) goto invalid;
+	size = page->data_size;
+	if (!size || page->data_offset > identity->map_size || size > identity->map_size - page->data_offset)
+		goto invalid;
+	ring = (unsigned char *)page + page->data_offset;
+	head = __atomic_load_n(&page->data_head, __ATOMIC_ACQUIRE);
+	tail = page->data_tail;
+	if (head < tail || head - tail > size) goto invalid;
+	while (tail < head) {
+		struct perf_event_header header;
+		unsigned char record[512];
+		if (head - tail < sizeof(header)) goto invalid;
+		lazy_identity_ring_copy(ring, size, tail, &header, sizeof(header));
+		if (header.size < sizeof(header) || header.size > sizeof(record) || header.size > head - tail)
+			goto invalid;
+		lazy_identity_ring_copy(ring, size, tail, record, header.size);
+		switch (header.type) {
+		case PERF_RECORD_COMM:
+			if (header.size < sizeof(header) + 2 * sizeof(uint32_t)) goto invalid;
+			if (header.misc & PERF_RECORD_MISC_COMM_EXEC) identity->execs++;
+			break;
+		case PERF_RECORD_EXIT:
+			identity->exits++;
+			break;
+		case PERF_RECORD_FORK:
+			if (header.size != sizeof(header) + 4 * sizeof(uint32_t) + sizeof(uint64_t)) goto invalid;
+			break;
+		case PERF_RECORD_LOST:
+			if (header.size >= sizeof(header) + 2 * sizeof(uint64_t))
+				memcpy(&identity->lost, record + sizeof(header) + sizeof(uint64_t), sizeof(uint64_t));
+			goto invalid;
+		default:
+			goto invalid;
+		}
+		tail += header.size;
+	}
+	__atomic_store_n(&page->data_tail, tail, __ATOMIC_RELEASE);
+	/* A full ring can suppress the LOST record until the next producer
+ * event. The synchronous native counter catches that loss at a freeze.
+ */
+	if (read(identity->event, &counters, sizeof(counters)) != sizeof(counters)) goto invalid;
+	identity->lost = counters.lost;
+	if (identity->lost || identity->execs || identity->exits) goto invalid;
+	return true;
+invalid:
+	identity->safe = false;
+	return false;
+}
+
+#endif
