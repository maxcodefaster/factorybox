+static bool lazy_inherit_frozen(int pid)
+{
+	struct dirent *entry;
+	char directory[64], path[128], line[256];
+	DIR *tasks;
+	bool safe = true;
+	unsigned count = 0;
+
+	snprintf(directory, sizeof(directory), "/proc/%d/task", pid);
+	tasks = opendir(directory);
+	if (!tasks) return false;
+	while ((entry = readdir(tasks))) {
+		FILE *file;
+		char *end, state = 0;
+		long tid = strtol(entry->d_name, &end, 10);
+		if (*end || tid <= 0) continue;
+		snprintf(path, sizeof(path), "/proc/%d/task/%ld/status", pid, tid);
+		file = fopen(path, "r");
+		if (!file) { safe = false; break; }
+		while (fgets(line, sizeof(line), file))
+			if (sscanf(line, "State:\t%c", &state) == 1) break;
+		fclose(file);
+		if (state != 't' && state != 'T') {
+			pr_warn("Lazy export thread not stopped pid=%d tid=%ld state=%c\n", pid, tid, state ? state : '?');
+			safe = false;
+			break;
+		}
+		count++;
+	}
+	closedir(tasks);
+	return safe && count;
+}
