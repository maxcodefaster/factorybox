+	    setsockopt(socket_fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout)) ||
+	    connect(socket_fd, (struct sockaddr *)&address, sizeof(address)) ||
+	    send_query(socket_fd, image_fd) ||
