+#ifndef RUNTIME_FORK_LAZY_STREAM_WRITER_H
+#define RUNTIME_FORK_LAZY_STREAM_WRITER_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <errno.h>
+#include <unistd.h>
+#include <sys/stat.h>
+
+#define LAZY_STREAM_MAX_SEGMENTS 262144U
+
+struct lazy_stream_segment {
+	uint64_t bytes;
+	bool local;
+};
+
+struct lazy_stream_writer {
+	int original_fd;
+	struct lazy_stream_segment *segments;
+	uint32_t count;
+	uint64_t pending, queued, original_bytes, local_bytes, inherited_bytes;
+};
+
+static inline int lazy_stream_append(struct lazy_stream_writer *writer, uint64_t bytes, bool local)
+{
+	if (!bytes || bytes % 4096 || writer->count == LAZY_STREAM_MAX_SEGMENTS ||
+	    bytes > UINT64_MAX - writer->pending || bytes > UINT64_MAX - writer->queued) {
+		errno = EINVAL;
+		return -1;
+	}
+	writer->segments[writer->count++] = (struct lazy_stream_segment){ bytes, local };
+	writer->pending += bytes;
+	writer->queued += bytes;
+	return 0;
+}
+
+static inline int lazy_stream_drain(struct lazy_stream_writer *writer, int pipe_fd, int local_fd, uint64_t bytes)
+{
+	unsigned char buffer[65536];
+	if (!bytes || bytes != writer->pending || writer->original_fd < 0 || local_fd < 0) {
+		errno = EINVAL;
+		return -1;
+	}
+	for (uint32_t index = 0; index < writer->count; index++) {
+		uint64_t remaining = writer->segments[index].bytes;
+		while (remaining) {
+			size_t wanted = remaining < sizeof(buffer) ? remaining : sizeof(buffer);
+			ssize_t got = read(pipe_fd, buffer, wanted);
+			int fds[2] = { writer->original_fd,
+				writer->segments[index].local ? local_fd : -1 };
+			if (got < 0 && errno == EINTR) continue;
+			if (got <= 0) { if (!got) errno = ENODATA; return -1; }
+			for (unsigned int output = 0; output < 2; output++) {
+				size_t offset = 0;
+				if (fds[output] < 0) continue;
+				while (offset < (size_t)got) {
+					ssize_t sent = write(fds[output], buffer + offset, got - offset);
+					if (sent < 0 && errno == EINTR) continue;
+					if (sent <= 0) { if (!sent) errno = EIO; return -1; }
+					offset += sent;
+				}
+			}
+			writer->original_bytes += got;
+			if (writer->segments[index].local) writer->local_bytes += got;
+			else writer->inherited_bytes += got;
+			remaining -= got;
+		}
+	}
+	writer->count = 0;
+	writer->pending = 0;
+	return 0;
+}
+
+static inline int lazy_stream_finish(struct lazy_stream_writer *writer, int local_fd)
+{
+	struct stat original, local;
+	if (writer->pending || writer->count || !writer->queued ||
+	    writer->original_bytes != writer->queued ||
+	    writer->local_bytes + writer->inherited_bytes != writer->original_bytes ||
+	    fstat(writer->original_fd, &original) || fstat(local_fd, &local) ||
+	    !S_ISREG(original.st_mode) || !S_ISREG(local.st_mode) ||
+	    original.st_size < 0 || local.st_size < 0 ||
+	    (uint64_t)original.st_size != writer->original_bytes ||
+	    (uint64_t)local.st_size != writer->local_bytes ||
+	    (original.st_dev == local.st_dev && original.st_ino == local.st_ino)) {
+		errno = EINVAL;
+		return -1;
+	}
+	return fsync(writer->original_fd) || fsync(local_fd) ? -1 : 0;
+}
+
+#endif
