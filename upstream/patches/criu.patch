+static int lazy_inherit_materialize(struct lazy_pages_info *lpi, bool all)
+{
+	struct timespec started, now;
+	clock_gettime(CLOCK_MONOTONIC, &started);
+	for (;;) {
+		struct lazy_iov *iov, *chosen = NULL;
+		unsigned long pages, length;
+		if (lpi->exited) return 0;
+		if (lpi->pr.sync(&lpi->pr) || !list_empty(&lpi->reqs)) return -1;
+		list_for_each_entry(iov, &lpi->iovs, l)
+			if (all || iov->start != iov->img_start || iov->zero_fill || iov->fault_requested) {
+				chosen = iov;
+				break;
+			}
+		if (!chosen) return 0;
+		if (chosen->zero_fill) {
+			if (uffd_zero(lpi, chosen->start, 1)) return -1;
+		} else {
+			length = min(chosen->end - chosen->start, (unsigned long)DEFAULT_XFER_LEN);
+			chosen = extract_range(chosen, chosen->start, chosen->start + length);
+			if (!chosen) return -1;
+			list_move(&chosen->l, &lpi->reqs);
+			pages = length / PAGE_SIZE;
+			if (uffd_handle_pages(lpi, chosen->img_start, pages, PR_ASYNC | PR_ASAP) < 0) return -1;
+		}
+		if (lazy_inherit_drain_uffd(lpi)) return -1;
+		clock_gettime(CLOCK_MONOTONIC, &now);
+		if (now.tv_sec - started.tv_sec >= 30) return -1;
