+static int prepare_lazy_epoch_control(void)
+{
+	struct sockaddr_un address = { .sun_family = AF_UNIX };
+	const char *path = getenv("RUNTIME_FORK_LAZY_EPOCH_SOCKET");
+	if (!path)
+		return 0;
+	if (!lazy_identity_enabled() || !lazy_wp_enabled() ||
+	    strlen(path) >= sizeof(address.sun_path) || opts.use_page_server || opts.stream || opts.auto_dedup)
+		return -1;
+	strcpy(address.sun_path, path);
+	lazy_epoch_rfd.fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+	if (lazy_epoch_rfd.fd < 0 || bind(lazy_epoch_rfd.fd, (struct sockaddr *)&address, sizeof(address)) ||
+	    chmod(path, 0600) || listen(lazy_epoch_rfd.fd, 4))
+		return -1;
+	lazy_epoch_rfd.read_event = lazy_epoch_read_event;
+	return epoll_add_rfd(epollfd, &lazy_epoch_rfd);
+}
