+static int prepare_lazy_capture_control(int epollfd)
+{
+	const char *mode = getenv("RUNTIME_FORK_LAZY_CAPTURE_CONTROL");
+	const char *observe = getenv("RUNTIME_FORK_LAZY_OBSERVE");
+	sigset_t signals;
+
+	if (observe && strcmp(observe, "0") && strcmp(observe, "1")) return -1;
+	lazy_observe_enabled = observe && !strcmp(observe, "1");
+	if (lazy_observe_enabled) {
+		lazy_observe_path = getenv("RUNTIME_FORK_LAZY_OBSERVE_PATH");
+		if (!mode || strcmp(mode, "1") || !lazy_observe_path ||
+		    strncmp(lazy_observe_path, "/experiment/", 12) ||
+		    strlen(lazy_observe_path) > PATH_MAX - 64 ||
+		    strstr(lazy_observe_path, "/../") || strstr(lazy_observe_path, "/./") ||
+		    opts.use_page_server || opts.stream || opts.auto_dedup) {
+			pr_err("Lazy observation requires owned local capture control/path\n");
+			return -1;
+		}
+	}
+	if (!mode || !strcmp(mode, "0"))
+		return 0;
+	if (strcmp(mode, "1")) {
+		pr_err("RUNTIME_FORK_LAZY_CAPTURE_CONTROL must be 0 or 1\n");
+		return -1;
+	}
+	sigemptyset(&signals);
+	sigaddset(&signals, SIGUSR1);
+	if (lazy_observe_enabled) sigaddset(&signals, SIGUSR2);
+	if (sigprocmask(SIG_BLOCK, &signals, NULL)) {
+		pr_perror("Blocking capture materialization signal");
+		return -1;
+	}
+	lazy_capture_rfd.fd = signalfd(-1, &signals, SFD_CLOEXEC | SFD_NONBLOCK);
+	if (lazy_capture_rfd.fd < 0) {
+		pr_perror("Creating capture materialization signalfd");
+		return -1;
+	}
+	lazy_capture_rfd.read_event = lazy_capture_read_event;
+	if (epoll_add_rfd(epollfd, &lazy_capture_rfd)) {
+		close_safe(&lazy_capture_rfd.fd);
+		return -1;
+	}
+	return 0;
+}
