+static void lazy_epoch_free_ranges(struct list_head *head)
+{
+	struct lazy_iov *iov, *next;
+	list_for_each_entry_safe(iov, next, head, l) {
+		list_del(&iov->l);
+		xfree(iov);
+	}
+}
+
+static int lazy_epoch_range(struct list_head *head, unsigned *count,
+			    unsigned long start, unsigned long end)
+{
+	struct lazy_iov *iov;
+	if (start >= end || (start | end) & (PAGE_SIZE - 1) ||
+	    *count == LAZY_INHERIT_MAX_RANGES)
+		return -1;
+	iov = xzalloc(sizeof(*iov));
+	if (!iov)
+		return -1;
+	iov->start = iov->img_start = start;
+	iov->end = end;
+	list_add_tail(&iov->l, head);
+	(*count)++;
+	return 0;
+}
