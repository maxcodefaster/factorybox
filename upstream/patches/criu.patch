+static void lazy_epoch_stage_fini(struct lazy_epoch_stage *stage)
+{
+	lazy_epoch_free_ranges(&stage->missing);
+	lazy_epoch_free_ranges(&stage->copied);
+	if (stage->reader.close)
+		stage->reader.close(&stage->reader);
+	if (stage->mm)
+		mm_entry__free_unpacked(stage->mm, NULL);
