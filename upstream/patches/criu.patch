+static int lazy_epoch_reset(struct lazy_epoch_stage *stage, uint64_t *pages, unsigned *calls)
+{
+	uint64_t ptes[8192];
+	struct lazy_iov *iov;
+	char path[64];
+	int fd, result = -1;
+	const char *fail = getenv("RUNTIME_FORK_EPOCH_TEST_FAIL_AFTER");
