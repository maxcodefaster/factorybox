+
+/* The keeper stays outside the captured cgroup. Closing the last uffd would
+ * silently stop write tracking, so every accepted baseline retains it there.
+ * PID start time protects against PID reuse; an exec invalidates the old mm
+ * and makes registration return ESRCH. No baseline is inherited in that case.
+ */
+static int keeper_call(pid_t pid, int op, int input, int *output)
+{
+	struct sockaddr_un address = { .sun_family = AF_UNIX, .sun_path = TRACK_SOCKET };
+	struct proc_pid_stat st;
+	struct track_message request, response;
+	char control[CMSG_SPACE(sizeof(int))] = {0};
+	struct iovec iov;
+	struct msghdr message = {0};
+	struct cmsghdr *cmsg;
+	struct timeval timeout = { .tv_sec = 2 };
+	int sock = -1, ret = -1, received = -1;
+
+	*output = -1;
+	if (parse_pid_stat(pid, &st))
+		return -1;
+	request = (struct track_message){ .op = op, .pid = pid, .ticks = st.start_time };
+	sock = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+	if (sock < 0 || setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) ||
+	    setsockopt(sock, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout)) ||
+	    connect(sock, (struct sockaddr *)&address, sizeof(address)))
+		goto out;
+	iov = (struct iovec){ .iov_base = &request, .iov_len = sizeof(request) };
+	message.msg_iov = &iov;
+	message.msg_iovlen = 1;
+	if (input >= 0) {
+		message.msg_control = control;
+		message.msg_controllen = sizeof(control);
+		cmsg = CMSG_FIRSTHDR(&message);
+		cmsg->cmsg_level = SOL_SOCKET;
+		cmsg->cmsg_type = SCM_RIGHTS;
+		cmsg->cmsg_len = CMSG_LEN(sizeof(int));
+		memcpy(CMSG_DATA(cmsg), &input, sizeof(input));
+	}
+	if (sendmsg(sock, &message, MSG_NOSIGNAL) != sizeof(request))
+		goto out;
+	memset(control, 0, sizeof(control));
+	iov = (struct iovec){ .iov_base = &response, .iov_len = sizeof(response) };
+	message = (struct msghdr){ .msg_iov = &iov, .msg_iovlen = 1,
+		.msg_control = control, .msg_controllen = sizeof(control) };
+	if (recvmsg(sock, &message, MSG_CMSG_CLOEXEC) != sizeof(response))
+		goto out;
+	cmsg = CMSG_FIRSTHDR(&message);
+	if (cmsg) {
+		if (cmsg->cmsg_level != SOL_SOCKET || cmsg->cmsg_type != SCM_RIGHTS ||
+		    cmsg->cmsg_len != CMSG_LEN(sizeof(int)))
+			goto out;
+		memcpy(&received, CMSG_DATA(cmsg), sizeof(received));
+	}
+	if (message.msg_flags & (MSG_TRUNC | MSG_CTRUNC) || response.pid != request.pid ||
+	    response.ticks != request.ticks || response.reserved || response.op < 0 || response.op > 1 ||
+	    (op == 1 && (response.op == 1) != (received >= 0)) || (op == 2 && (response.op != 1 || received >= 0)))
+		goto out;
+	*output = received;
+	received = -1;
+	ret = 0;
+out:
+	if (received >= 0)
+		close(received);
+	if (sock >= 0)
+		close(sock);
+	if (ret)
+		pr_perror("Owned tracking keeper request failed for %d", pid);
+	return ret;
+}
