+static int lazy_inherit_drain_uffd(struct lazy_pages_info *lpi)
+{
+	unsigned count;
+	for (count = 0; count < 65536 && !lpi->exited; count++) {
+		struct pollfd pending = { .fd = lpi->lpfd.fd, .events = POLLIN };
+		int ret = poll(&pending, 1, 0);
+		if (ret < 0) return -1;
+		if (!ret) return 0;
+		if (pending.revents & POLLIN) {
+			if (handle_uffd_event(&lpi->lpfd) < 0) return -1;
+		} else if (pending.revents & POLLHUP) {
+			return handle_exit(lpi);
+		} else return -1;
+	}
+	return lpi->exited ? 0 : -1;
+}
