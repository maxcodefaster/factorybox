+	for (index = 0; index < count; index++)
+		copied_disable(stages[index].lpi);
+	disabled = true;
+	for (index = 0; index < count; index++)
+		if (lazy_epoch_reset(&stages[index], &reply.reset_pages, &calls)) {
+			reply.status = errno ? errno : EIO;
+			goto respond;
+		}
+	if (cgroup >= 0 && !lazy_epoch_cgroup_frozen(cgroup)) {
+		reply.status = EBUSY;
+		goto respond;
+	}
+	for (index = 0; index < count; index++)
+		if (!lazy_identity_drain(&stages[index].lpi->identity) ||
+		    !lazy_epoch_source_frozen(stages[index].lpi->identity.pid, cgroup, cgroup_relative)) {
+			reply.status = EBUSY;
+			goto respond;
+		}
+	for (index = 0; index < count; index++) {
+		struct page_read previous = stages[index].lpi->pr;
+		struct lazy_iov *iov;
+		lpi = stages[index].lpi;
+		INIT_LIST_HEAD(&previous.async);
+		lazy_epoch_free_ranges(&lpi->iovs);
+		list_splice_tail_init(&stages[index].missing, &lpi->iovs);
+		list_splice_tail_init(&stages[index].copied, &lpi->copied);
+		lpi->pr = stages[index].reader;
+		INIT_LIST_HEAD(&lpi->pr.async);
+		memset(&stages[index].reader, 0, sizeof(stages[index].reader));
+		lpi->copied_tracking_disabled = false;
+		list_for_each_entry(iov, &lpi->iovs, l)
+			reply.missing_pages += (iov->end - iov->start) / PAGE_SIZE;
+		reply.copied_ranges += stages[index].copied_count;
+		previous.close(&previous);
+	}
+	if (lazy_epoch_dfd >= 0)
+		close(lazy_epoch_dfd);
+	lazy_epoch_dfd = descriptors[1];
+	descriptors[1] = -1;
+	lazy_epoch_generation++;
+	lazy_epoch_nonce = request.nonce;
+	disabled = false;
+	reply.image_pid = target->pid;
+	reply.roots = count;
+	reply.status = 0;
+	pr_info("Source epoch rebased generation=%llu roots=%u reset_pages=%llu missing_pages=%llu\n",
+		(unsigned long long)lazy_epoch_generation, count,
+		(unsigned long long)reply.reset_pages, (unsigned long long)reply.missing_pages);
+respond:
+	saved_errno = errno;
+	reply.generation = lazy_epoch_generation;
+	reply.tracking_disabled = disabled;
+	for (index = 0; index < count; index++)
+		lazy_epoch_stage_fini(&stages[index]);
+	if (parentfd >= 0)
+		close(parentfd);
+	for (index = 0; index < 3; index++)
+		if (descriptors[index] >= 0)
+			close(descriptors[index]);
+	if (send(client, &reply, sizeof(reply), MSG_NOSIGNAL) != sizeof(reply))
+		pr_warn("Source epoch client disconnected after status=%d generation=%llu\n",
+			reply.status, (unsigned long long)reply.generation);
+	close(client);
+	errno = saved_errno;
+	return 1;
+}
