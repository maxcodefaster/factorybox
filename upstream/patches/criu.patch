+	unsigned long required = UFFD_FEATURE_WP_ASYNC | UFFD_FEATURE_WP_UNPOPULATED;
+	return enabled && !strcmp(enabled, "1") && kdat.has_pagemap_scan &&
+	       kdat.has_uffd && (kdat.uffd_features & required) == required;
+}
+
+bool sysbox_async_enabled(void)
+{
