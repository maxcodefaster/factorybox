+/* ip route save includes kernel-computed link state. Linux rejects DEAD and
+ * LINKDOWN in a route create request and recomputes them from restored links.
+ * Clear only these status bits in the private restore copy, preserving every
+ * route and its attributes and leaving the immutable checkpoint unchanged.
+ */
+static int prepare_route_dump(FILE *file)
+{
+	uint32_t magic;
+	long end, pos;
+
+	if (fseek(file, 0, SEEK_END) || (end = ftell(file)) < 0 || fseek(file, 0, SEEK_SET))
+		return -1;
+	if (fread(&magic, 1, sizeof(magic), file) != sizeof(magic) || magic != 0x45311224) {
+		pr_err("Invalid ip route dump header\n");
+		return -1;
+	}
+	pos = sizeof(magic);
+	while (pos < end) {
+		struct nlmsghdr header;
+		struct rtmsg route;
+		unsigned int saved;
+
+		if (fread(&header, 1, sizeof(header), file) != sizeof(header) ||
+		    header.nlmsg_type != RTM_NEWROUTE || header.nlmsg_len < NLMSG_LENGTH(sizeof(route)) ||
+		    header.nlmsg_len > end - pos || fread(&route, 1, sizeof(route), file) != sizeof(route)) {
+			pr_err("Invalid ip route dump record at %ld\n", pos);
+			return -1;
+		}
+		saved = route.rtm_flags;
+		route.rtm_flags &= ~(RTNH_F_DEAD | RTNH_F_LINKDOWN);
+		if (route.rtm_flags != saved) {
+			pr_debug("Route restore recomputes status flags: saved=%x requested=%x\n", saved, route.rtm_flags);
+			if (fseek(file, pos + NLMSG_HDRLEN, SEEK_SET) ||
+			    fwrite(&route, 1, sizeof(route), file) != sizeof(route))
+				return -1;
+		}
+		pos += header.nlmsg_len;
+		if (fseek(file, pos, SEEK_SET))
+			return -1;
+	}
+	return 0;
+}
