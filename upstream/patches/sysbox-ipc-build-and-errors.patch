--- /dev/null
+++ b/sysboxFsGrpc/factorybox_rpc_errors_linux_test.go
@@ -0,0 +1,126 @@
+//go:build linux
+
+package sysboxFsGrpc
+
+import (
+	"bytes"
+	"context"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	pb "github.com/nestybox/sysbox-ipc/sysboxFsGrpc/sysboxFsProtobuf"
+	"github.com/sirupsen/logrus"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+type factoryboxRejectingServer struct {
+	Server
+	calls atomic.Int32
+}
+
+func (s *factoryboxRejectingServer) reject() (*pb.Response, error) {
+	s.calls.Add(1)
+	return nil, status.Error(codes.FailedPrecondition, "fixture rejection")
+}
+
+func (s *factoryboxRejectingServer) ContainerPreRegistration(context.Context, *pb.ContainerData) (*pb.Response, error) {
+	return s.reject()
+}
+
+func (s *factoryboxRejectingServer) ContainerRegistration(context.Context, *pb.ContainerData) (*pb.Response, error) {
+	return s.reject()
+}
+
+func (s *factoryboxRejectingServer) ContainerUpdate(context.Context, *pb.ContainerData) (*pb.Response, error) {
+	return s.reject()
+}
+
+func TestFactoryboxRPCFailuresKeepCauseAndFormattedWarning(t *testing.T) {
+	if os.Getenv("FACTORYBOX_UPSTREAM_CONTAINER") != "1" {
+		t.Skip("requires the owned Linux test container and its private /run")
+	}
+	if _, err := os.Lstat(sysFsGrpcSockAddr); !os.IsNotExist(err) {
+		t.Fatalf("test socket must be absent before binding: %v", err)
+	}
+	if err := os.MkdirAll(filepath.Dir(sysFsGrpcSockAddr), 0700); err != nil {
+		t.Fatal(err)
+	}
+	listener, err := net.ListenUnix("unix", &net.UnixAddr{Name: sysFsGrpcSockAddr, Net: "unix"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	listener.SetUnlinkOnClose(false)
+	socketInfo, err := os.Lstat(sysFsGrpcSockAddr)
+	if err != nil {
+		listener.Close()
+		t.Fatal(err)
+	}
+	service := &factoryboxRejectingServer{}
+	server := grpc.NewServer()
+	pb.RegisterSysboxStateChannelServer(server, service)
+	exited := make(chan error, 1)
+	go func() { exited <- server.Serve(listener) }()
+	t.Cleanup(func() {
+		server.Stop()
+		select {
+		case err := <-exited:
+			if err != nil && err != grpc.ErrServerStopped {
+				t.Error(err)
+			}
+		case <-time.After(time.Second):
