+struct detached_proc_restore {
+	struct list_head list;
+	DetachedProcMount *image;
+	mutex_t lock;
+	int fdstore_id;
+};
+
+static LIST_HEAD(detached_proc_mounts);
+
+static int collect_detached_proc(struct reg_file_info *rfi)
+{
+	DetachedProcMount *image = rfi->rfe->detached_proc;
+	struct detached_proc_restore *mount;
+	struct ns_id *pidns;
+
+	if (!image)
+		return 0;
+	pidns = lookup_ns_by_id(image->pid_ns_id, &pid_ns_desc);
+	if (!nested_ns_enabled() || !pidns || !root_item->ids->has_user_ns_id ||
+	    image->user_ns_id != root_item->ids->user_ns_id || !image->mount_id ||
+	    strcmp(rfi->rfe->name, "/") || rfi->rfe->flags != O_PATH ||
+	    !rfi->rfe->has_mode || !S_ISDIR(rfi->rfe->mode) || rfi->rfe->has_mnt_id ||
+	    rfi->rfe->ext || strlen(image->options) > 1024) {
+		pr_err("Invalid detached proc root image\n");
+		return -1;
+	}
+	list_for_each_entry(mount, &detached_proc_mounts, list) {
+		DetachedProcMount *other = mount->image;
+
+		if (other->mount_id != image->mount_id)
+			continue;
+		if (other->pid_ns_id != image->pid_ns_id || other->user_ns_id != image->user_ns_id ||
+		    other->flags != image->flags || strcmp(other->options, image->options)) {
+			pr_err("Inconsistent detached proc mount images\n");
+			return -1;
+		}
+		rfi->detached_proc = mount;
+		return 0;
+	}
+	mount = shmalloc(sizeof(*mount));
+	if (!mount)
+		return -1;
+	memset(mount, 0, sizeof(*mount));
+	mount->image = image;
+	mount->fdstore_id = -1;
+	mutex_init(&mount->lock);
+	list_add_tail(&mount->list, &detached_proc_mounts);
+	rfi->detached_proc = mount;
+	return 0;
+}
+
+static int open_detached_proc(struct reg_file_info *rfi)
+{
+	struct detached_proc_restore *mount = rfi->detached_proc;
+	DetachedProcMount *image = mount->image;
+	int root = -1, fd = -1;
+
+	mutex_lock(&mount->lock);
+	if (mount->fdstore_id < 0) {
+		if (current->ids->pid_ns_id != image->pid_ns_id ||
+		    current->ids->user_ns_id != image->user_ns_id) {
+			pr_err("Detached proc descriptor master is in a different namespace\n");
+			goto out;
+		}
+		root = nested_ns_mount_detached_proc(image->flags, image->options);
+		if (root < 0)
+			goto out;
+		mount->fdstore_id = fdstore_add(root);
+		if (mount->fdstore_id < 0)
+			goto out;
+	} else {
+		root = fdstore_get(mount->fdstore_id);
+		if (root < 0)
+			goto out;
+	}
+	/*
+	 * Preserve the fsmount file itself. Reopening its path loses the
+	 * kernel's FMODE_NEED_UNMOUNT reference; fdstore teardown would
+	 * dissolve the anonymous mount while the restored directory still
+	 * appears readable. Canonical O_PATH roots of the same detached
+	 * mount currently share this open file description.
+	 */
+	fd = root;
+	root = -1;
+	if (fd >= 0 && restore_fown(fd, rfi->rfe->fown)) {
+		close(fd);
+		fd = -1;
+	}
+out:
+	close_safe(&root);
+	mutex_unlock(&mount->lock);
+	return fd;
+}
