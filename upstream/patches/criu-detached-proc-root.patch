+struct detached_proc_probe {
+	int fd;
+	unsigned int flags;
+	char *options;
+};
+
+/*
+ * Inspect a clone in a disposable private mount namespace. Attaching the
+ * original would change the stopped workload. Reading its fd link gives
+ * only "/", so neither its flags nor hidepid/subset options can be inferred
+ * from that link or from the workload's mountinfo.
+ */
+static int probe_detached_proc(void *arg)
+{
+	struct detached_proc_probe *probe = arg;
+	struct mount_info *list = NULL, *mi;
+	char target[] = "/tmp/criu-detached-proc.XXXXXX";
+	int clone = -1, ret = -1;
+	bool attached = false;
+
+	if (unshare(CLONE_NEWNS) || mount(NULL, "/", NULL, MS_REC | MS_PRIVATE, NULL)) {
+		pr_perror("Can't isolate detached proc inspection");
+		return -1;
+	}
+	if (!mkdtemp(target))
+		return -1;
+	clone = sys_open_tree(probe->fd, "", OPEN_TREE_CLONE | OPEN_TREE_CLOEXEC | AT_EMPTY_PATH | AT_RECURSIVE);
+	if (clone < 0 || sys_move_mount(clone, "", AT_FDCWD, target, MOVE_MOUNT_F_EMPTY_PATH)) {
+		pr_perror("Can't inspect a clone of the detached proc root");
+		goto out;
+	}
+	attached = true;
+	list = parse_mountinfo(getpid(), NULL, false);
+	for (mi = list; mi; mi = mi->next) {
+		const char *point = mi->ns_mountpoint + 1;
+
+		if (!strncmp(point, target, strlen(target)) && point[strlen(target)] == '/') {
+			pr_err("Detached proc tree has unsupported descendant mounts\n");
+			goto out;
+		}
+	}
+	for (mi = list; mi; mi = mi->next) {
+		if (strcmp(mi->ns_mountpoint + 1, target))
+			continue;
+		if (mi->fstype->code != FSTYPE__PROC || strcmp(mi->root, "/") ||
+		    mi->shared_id || mi->master_id)
+			break;
+		probe->flags = mi->flags | mi->sb_flags;
+		probe->options = xstrdup(mi->options ? mi->options : "");
+		if (probe->options)
+			ret = 0;
+		break;
+	}
+out:
+	while (list) {
+		mi = list->next;
+		mnt_entry_free(list);
+		list = mi;
+	}
+	if (attached && umount2(target, MNT_DETACH))
+		ret = -1;
+	close_safe(&clone);
+	if (rmdir(target))
+		ret = -1;
+	return ret;
+}
+
+static int dump_detached_proc(int lfd, const struct fd_parms *p, const struct fd_link *link,
+			      DetachedProcMount *image)
+{
+	struct detached_proc_probe probe = { .fd = lfd };
+	struct ns_id *pidns, *userns;
+	struct stat proc_pidns, task_pidns, task_userns;
+	int proc_nsfd;
+	char path[64];
+
+	if (!nested_ns_enabled() || p->mnt_id <= 0 || p->fs_type != PROC_SUPER_MAGIC ||
+	    !S_ISDIR(p->stat.st_mode) || p->stat.st_ino != 1 ||
+	    p->flags != O_PATH || strcmp(link->name + 1, "/"))
+		return -1;
+	proc_nsfd = openat(lfd, "1/ns/pid", O_RDONLY | O_CLOEXEC);
+	if (proc_nsfd < 0)
+		return -1;
+	if (fstat(proc_nsfd, &proc_pidns)) {
+		close(proc_nsfd);
+		return -1;
+	}
+	close(proc_nsfd);
+	snprintf(path, sizeof(path), "/proc/%d/ns/pid", p->pid);
+	if (stat(path, &task_pidns))
+		return -1;
+	snprintf(path, sizeof(path), "/proc/%d/ns/user", p->pid);
+	if (stat(path, &task_userns))
+		return -1;
+	pidns = lookup_ns_by_kid(proc_pidns.st_ino, &pid_ns_desc);
+	userns = lookup_ns_by_kid(task_userns.st_ino, &user_ns_desc);
+	if (!pidns || !userns || proc_pidns.st_ino != task_pidns.st_ino ||
+	    userns->id != root_item->ids->user_ns_id) {
+		pr_err("Detached proc root has an unsupported PID/user namespace owner\n");
+		return -1;
+	}
+	if (call_in_child_process(probe_detached_proc, &probe)) {
+		xfree(probe.options);
+		return -1;
+	}
+	image->mount_id = p->mnt_id;
+	image->pid_ns_id = pidns->id;
+	image->user_ns_id = userns->id;
+	image->flags = probe.flags;
+	image->options = probe.options;
+	pr_info("Dumping detached proc root mount=%d pidns=%u flags=%#x options=%s\n",
+		p->mnt_id, pidns->id, image->flags, image->options);
+	return 0;
+}
