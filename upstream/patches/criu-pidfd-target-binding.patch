+/*
+ * An innermost NSpid is not a PID in an ancestor opener's namespace. Numeric
+ * translation also cannot preserve tasks whose outer PID was not settable.
+ * The identified restored task therefore creates each original description
+ * on itself. The existing fdstore transfers that kernel object, rather than
+ * looking up an unrelated same-numbered task from the descriptor's owner.
+ *
+ * This precedes the shared-fd-table barrier. Every task finishes temporary fd
+ * use before the table owner restores it. Store IDs and readiness are shared;
+ * no cross-task numeric PID or new descriptor transport is introduced.
+ */
+int prepare_pidfd_targets(struct pstree_item *task)
+{
+	struct pidfd_info *info;
+
+	list_for_each_entry(info, &pidfd_targets, target_list) {
+		struct fdinfo_list_entry *master;
+		int fd, id;
+
+		if (info->pidfe->target_vpid != vpid(task))
+			continue;
+		master = try_file_master(&info->d);
+		if (!master) {
+			pr_err("Bound pidfd has no original file owner\n");
+			return -1;
+		}
+		fd = pidfd_open(getpid(), info->pidfe->flags);
+		if (fd < 0) {
+			pr_perror("Can't materialize pidfd for its exact restored task");
+			return -1;
+		}
+		id = fdstore_add(fd);
+		close(fd);
+		if (id < 0)
+			return -1;
+		info->fdstore_id = id;
+		futex_set_and_wake(&info->fdstore_ready, 1);
+		if (set_fds_event(master->pid))
+			return -1;
+	}
+	return 0;
+}
