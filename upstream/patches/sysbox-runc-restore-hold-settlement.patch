+//go:build linux
+
+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"time"
+)
+
+type factoryboxHoldCounterFailure struct {
+	frozen, populated               uint64
+	frozenPresent, populatedPresent bool
+}
+
+func (failure *factoryboxHoldCounterFailure) Error() string {
+	return fmt.Sprintf("restored original cgroup is not populated and frozen: frozen=%d populated=%d frozen_present=%t populated_present=%t",
+		failure.frozen, failure.populated, failure.frozenPresent, failure.populatedPresent)
+}
+
+func factoryboxHoldAfterDetach(group *os.File) error {
+	// Ptrace detach may briefly clear the completed-freeze counter while the
+	// original request remains set. Never re-freeze or expose the application.
+	// Wait only for this exact populated, pending acknowledgement. Empty,
+	// malformed, replaced or explicitly thawed state still refuses.
+	for deadline := time.Now().Add(2 * time.Second); ; {
+		request, err := factoryboxHoldRead(group, "cgroup.freeze")
+		if err != nil {
+			return err
+		}
+		if strings.TrimSpace(string(request)) != "1" {
+			return fmt.Errorf("original cgroup freeze request is no longer held")
+		}
+		err = factoryboxHoldConfirmed(group)
+		if err == nil {
+			return nil
+		}
+		var pending *factoryboxHoldCounterFailure
+		if !errors.As(err, &pending) || !pending.frozenPresent || !pending.populatedPresent ||
+			pending.frozen != 0 || pending.populated != 1 || time.Now().After(deadline) {
+			return err
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
