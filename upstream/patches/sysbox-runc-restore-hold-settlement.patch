+//go:build linux
+
+package main
+
+import (
+	"encoding/binary"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func TestFactoryboxRestoreHoldAfterDetachRefusals(t *testing.T) {
+	for _, row := range []struct{ name, request, events string }{
+		{"thaw-request", "0", "populated 1\nfrozen 1\n"},
+		{"missing-request", "", "populated 1\nfrozen 1\n"},
+		{"empty-group", "1", "populated 0\nfrozen 0\n"},
+		{"missing-counter", "1", "frozen 0\n"},
+		{"invalid-counter", "1", "populated 1\nfrozen bad\n"},
+	} {
+		t.Run(row.name, func(t *testing.T) {
+			path := t.TempDir()
+			if row.request != "" {
+				if err := os.WriteFile(filepath.Join(path, "cgroup.freeze"), []byte(row.request), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if err := os.WriteFile(filepath.Join(path, "cgroup.events"), []byte(row.events), 0600); err != nil {
+				t.Fatal(err)
+			}
+			group, err := os.Open(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer group.Close()
+			if err := factoryboxHoldAfterDetach(group); err == nil {
+				t.Fatal("post-detach guard accepted a withdrawn request or unowned/incomplete state")
+			}
+		})
+	}
+}
+
+func TestFactoryboxRestoreHoldAfterDetachAcknowledgement(t *testing.T) {
+	path := t.TempDir()
+	if err := os.WriteFile(filepath.Join(path, "cgroup.freeze"), []byte("1"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(path, "cgroup.events"), []byte("populated 1\nfrozen 0\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	group, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer group.Close()
+	done := make(chan error, 1)
+	go func() {
+		time.Sleep(10 * time.Millisecond)
+		next := filepath.Join(path, "next")
+		if err := os.WriteFile(next, []byte("populated 1\nfrozen 1\n"), 0600); err != nil {
+			done <- err
+			return
+		}
+		done <- os.Rename(next, filepath.Join(path, "cgroup.events"))
+	}()
+	if err := factoryboxHoldAfterDetach(group); err != nil {
+		t.Fatal("still-requested native acknowledgement was not allowed to settle", err)
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	request, err := os.ReadFile(filepath.Join(path, "cgroup.freeze"))
+	if err != nil || string(request) != "1" {
+		t.Fatal("settlement changed the original freeze request", err)
+	}
+}
+
+func TestFactoryboxRestoreHoldAfterDetachNative(t *testing.T) {
+	if os.Getenv("FACTORYBOX_NATIVE_HOLD_SETTLEMENT") != "1" {
+		t.Skip("explicit native post-detach hold control")
+	}
+	directory := t.TempDir()
+	program := `#include <stdint.h>
+#include <sys/mman.h>
+#include <fcntl.h>
+#include <unistd.h>
+int main(int argc,char **argv){if(argc!=2)return 2;int fd=open(argv[1],O_RDWR);if(fd<0)return 3;volatile uint64_t *c=mmap(0,4096,PROT_READ|PROT_WRITE,MAP_SHARED,fd,0);if(c==MAP_FAILED)return 4;close(fd);for(;;)(*c)++;}`
+	source, executable := filepath.Join(directory, "counter.c"), filepath.Join(directory, "counter")
+	if err := os.WriteFile(source, []byte(program), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if out, err := exec.Command("cc", "-O2", source, "-o", executable).CombinedOutput(); err != nil {
+		t.Fatal("compile native counter", err, string(out))
+	}
+	counterPath := filepath.Join(directory, "counter.data")
+	if err := os.WriteFile(counterPath, make([]byte, 4096), 0600); err != nil {
+		t.Fatal(err)
+	}
+	counterFile, err := os.OpenFile(counterPath, os.O_RDWR, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	memory, err := unix.Mmap(int(counterFile.Fd()), 0, 4096, unix.PROT_READ|unix.PROT_WRITE, unix.MAP_SHARED)
+	counterFile.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Munmap(memory)
+	count := func() uint64 { return binary.LittleEndian.Uint64(memory) }
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	command := exec.Command(executable, counterPath)
+	if err := command.Start(); err != nil {
+		t.Fatal(err)
+	}
+	pid := command.Process.Pid
+	pidfd, err := unix.PidfdOpen(pid, 0)
+	if err != nil {
+		command.Process.Kill()
+		command.Wait()
+		t.Fatal(err)
+	}
+	defer unix.Close(pidfd)
+	path := fmt.Sprintf("/sys/fs/cgroup/hold-settle-%d", os.Getpid())
+	if err := os.Mkdir(path, 0700); err != nil {
+		unix.PidfdSendSignal(pidfd, unix.SIGKILL, nil, 0)
+		command.Wait()
+		t.Fatal(err)
+	}
+	group, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer group.Close()
+	traced := false
+	defer func() {
+		if traced {
+			unix.PtraceDetach(pid)
+		}
+		os.WriteFile(filepath.Join(path, "cgroup.freeze"), []byte("0"), 0600)
+		if err := unix.PidfdSendSignal(pidfd, unix.SIGKILL, nil, 0); err != nil {
+			t.Error("kill only exact owned counter", err)
+		}
+		command.Wait()
+		if err := os.Remove(path); err != nil {
+			t.Error("remove only exact owned counter group", err)
+		}
+	}()
+	if err := os.WriteFile(filepath.Join(path, "cgroup.procs"), []byte(fmt.Sprint(pid)), 0600); err != nil {
+		t.Fatal(err)
+	}
+	membership, err := os.ReadFile(fmt.Sprintf("/proc/%d/cgroup", pid))
+	if err != nil || strings.TrimSpace(string(membership)) != "0::/"+filepath.Base(path) {
+		t.Fatal("counter did not enter its exact owned cgroup", err)
+	}
+	waitHeld := func() {
+		t.Helper()
+		for deadline := time.Now().Add(2 * time.Second); ; {
+			if err := factoryboxHoldConfirmed(group); err == nil {
+				return
+			} else if time.Now().After(deadline) {
+				t.Fatal("native freeze acknowledgement did not settle", err)
+			}
+			time.Sleep(time.Microsecond)
+		}
+	}
+	var maximum time.Duration
+	for cycle := 0; cycle < 4096; cycle++ {
+		if err := unix.PtraceSeize(pid); err != nil {
+			t.Fatal(err)
+		}
+		traced = true
+		if err := unix.PtraceInterrupt(pid); err != nil {
+			t.Fatal(err)
+		}
+		var status unix.WaitStatus
+		if waited, err := unix.Wait4(pid, &status, unix.WALL, nil); err != nil || waited != pid || !status.Stopped() {
+			t.Fatal("owned counter did not reach its ptrace stop", err)
+		}
+		if err := os.WriteFile(filepath.Join(path, "cgroup.freeze"), []byte("1"), 0600); err != nil {
+			t.Fatal(err)
+		}
+		waitHeld()
+		before := count()
+		if err := unix.PtraceDetach(pid); err != nil {
+			t.Fatal(err)
+		}
+		traced = false
+		started := time.Now()
+		heldErr := factoryboxHoldAfterDetach(group)
+		maximum = max(maximum, time.Since(started))
+		request, readErr := os.ReadFile(filepath.Join(path, "cgroup.freeze"))
+		waitHeld()
+		if readErr != nil || strings.TrimSpace(string(request)) != "1" || count() != before {
+			t.Fatal("application progressed or the original freeze request changed before activation", readErr)
+		}
+		if heldErr != nil {
+			t.Fatalf("post-detach guard rejected a still-requested freeze without application progress at cycle %d: %v", cycle, heldErr)
+		}
+		if err := os.WriteFile(filepath.Join(path, "cgroup.freeze"), []byte("0"), 0600); err != nil {
+			t.Fatal(err)
+		}
+		for deadline := time.Now().Add(time.Second); count() == before; {
+			if time.Now().After(deadline) {
+				t.Fatal("counter did not progress after explicit activation")
+			}
+		}
+	}
+	t.Logf("4096 exact ptrace-detach holds preserve the application counter until explicit thaw; maximum guard observation %s", maximum)
+}
