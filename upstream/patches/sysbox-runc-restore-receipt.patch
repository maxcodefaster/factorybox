@@ -0,0 +1,55 @@
+//go:build linux
+
+package main
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/opencontainers/runc/libcontainer"
+)
+
+func TestFactoryboxRestoreReceipt(t *testing.T) {
+	root := t.TempDir()
+	if err := os.MkdirAll(root+"/objects/forked", 0700); err != nil {
+		t.Fatal(err)
+	}
+	owner := strings.Repeat("a", 32)
+	request := factoryboxRestoreRequest{Version: 1, Owner: owner, Root: root, SandboxID: "forked", State: []byte("opaque saved state")}
+	state := &libcontainer.State{BaseState: libcontainer.BaseState{ID: "fbx-" + owner,
+		InitProcessPid: os.Getpid(), InitProcessStartTime: 12345, Created: time.Now().UTC()}}
+	if err := factoryboxRestoreComplete(request, state); err != nil {
+		t.Fatal(err)
+	}
+	path := root + "/objects/forked/restore-result.json"
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var result factoryboxRestoreResult
+	if err := json.Unmarshal(data, &result); err != nil {
+		t.Fatal(err)
+	}
+	raw, err := json.Marshal(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	hash := sha256.Sum256(raw)
+	if result.RequestSHA256 != hex.EncodeToString(hash[:]) || result.Owner != owner ||
+		result.PID != state.InitProcessPid || result.ProcessStart != "12345" || result.CompletedAt == "" {
+		t.Fatal("restore receipt is not bound to its exact request and original process")
+	}
+	if err := factoryboxRestoreComplete(request, state); err == nil {
+		t.Fatal("restore receipt overwritten")
+	}
+	again, err := os.ReadFile(path)
+	if err != nil || !bytes.Equal(data, again) {
+		t.Fatal("duplicate publication changed the original receipt", err)
+	}
+}
