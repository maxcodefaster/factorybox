+
+// Rebind only an exited, retained registration. FUSE servers and their cached
+// file contents keep the same container object; process and mount views change.
+// css is locked by ContainerRegister throughout preparation and commit.
+func (css *containerStateService) rebindStoppedContainer(curr, next *container) error {
+	if curr.uidFirst != next.uidFirst || curr.uidSize != next.uidSize ||
+		curr.gidFirst != next.gidFirst || curr.gidSize != next.gidSize ||
+		!slices.Equal(curr.procRoPaths, next.procRoPaths) ||
+		!slices.Equal(curr.procMaskPaths, next.procMaskPaths) {
+		return fmt.Errorf("retained registration cannot change ID mappings or proc protections")
+	}
+	if curr.initPidFd <= 0 {
+		return fmt.Errorf("retained registration has no original process descriptor")
+	}
+	fds := []unix.PollFd{{Fd: int32(curr.initPidFd), Events: unix.POLLIN}}
+	if _, err := unix.Poll(fds, 0); err != nil {
+		return err
+	}
+	if fds[0].Revents&unix.POLLIN == 0 || fds[0].Revents&unix.POLLNVAL != 0 {
+		return fmt.Errorf("retained registration still has a live original process")
+	}
+	oldPeers := css.netnsTable[curr.netnsInode]
+	if len(oldPeers) != 1 || oldPeers[0] != curr {
+		return fmt.Errorf("retained shared network namespace rebind is not supported")
+	}
+	newFD, err := libpidfd.Open(int(next.initPid), 0)
+	if err != nil {
+		return err
+	}
+	committed := false
+	defer func() {
+		if !committed {
+			unix.Close(int(newFD))
+		}
+	}()
+	proc := css.prs.ProcessCreate(next.initPid, next.uidFirst, next.gidFirst)
+	uidMap, err := proc.UidMap()
+	if err != nil {
+		return err
+	}
+	gidMap, err := proc.GidMap()
+	if err != nil {
+		return err
+	}
+	if len(uidMap) != 1 || uidMap[0].ID != 0 || uidMap[0].ParentID != int64(next.uidFirst) || uidMap[0].Count != int64(next.uidSize) ||
+		len(gidMap) != 1 || gidMap[0].ID != 0 || gidMap[0].ParentID != int64(next.gidFirst) || gidMap[0].Count != int64(next.gidSize) {
+		return fmt.Errorf("restored process does not have the saved ID mappings")
+	}
+	netns, err := proc.NetNsInode()
+	if err != nil {
+		return err
+	}
+	if peers := css.netnsTable[netns]; len(peers) > 0 && (len(peers) != 1 || peers[0] != curr) {
+		return fmt.Errorf("restored network namespace is owned by another registration")
+	}
+	userns, err := proc.UserNsInode()
+	if err != nil {
+		return err
+	}
+	root := proc.RootInode()
+	if root == 0 {
+		return fmt.Errorf("restored process root is unavailable")
+	}
+	mip, err := css.mts.NewMountInfoParser(curr, proc, true, true, true)
+	if err != nil {
+		return err
+	}
+	curr.intLock.Lock()
+	oldFD := curr.initPidFd
+	delete(css.netnsTable, curr.netnsInode)
+	curr.initPid, curr.initPidFd, curr.initProc = next.initPid, newFD, proc
+	curr.rootInode, curr.usernsInode, curr.netnsInode = root, userns, netns
+	curr.mountInfoParser = mip
+	css.netnsTable[netns] = []*container{curr}
+	committed = true
+	curr.intLock.Unlock()
+	unix.Close(int(oldFD))
+	logrus.Infof("Retained container registration rebound: %s initPid=%d", curr.id, next.initPid)
 	return nil
 }
 
