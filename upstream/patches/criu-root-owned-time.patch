+int join_root_owned_time_namespace(struct pstree_item *item)
+{
+	struct pstree_item *parent;
+	struct ns_id *ns;
+	int fd, ret;
+
+	if (!nested_ns_enabled() || !item->parent || !item->ids || !item->ids->has_time_ns_id)
+		return 0;
+	parent = item->parent;
+	while (parent && !parent->ids)
+		parent = parent->parent;
+	if (parent && parent->ids->time_ns_id == item->ids->time_ns_id)
+		return 0;
+	ns = lookup_ns_by_id(item->ids->time_ns_id, &time_ns_desc);
+	if (!ns || ns->time.nsfd_id < 0) {
+		pr_err("Missing restored time namespace %u for task %d\n", item->ids->time_ns_id, vpid(item));
+		return -1;
+	}
+	fd = fdstore_get(ns->time.nsfd_id);
+	if (fd < 0)
+		return -1;
+	ret = switch_ns_by_fd(fd, &time_ns_desc, NULL);
+	close(fd);
+	return ret;
+}
