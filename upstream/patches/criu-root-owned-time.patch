+int prepare_root_owned_time_namespaces(void)
+{
+	struct ns_id *ns;
+	struct pstree_item *item;
+	unsigned int root_id;
+	int fd, status;
+	pid_t child;
+
+	if (!nested_ns_enabled())
+		return 0;
+	root_id = root_item->ids->time_ns_id;
+	for_each_pstree_item(item) {
+		if (item->ids && item->ids->has_time_ns_id && item->ids->time_ns_id != root_id &&
+		    item->ids->user_ns_id != root_item->ids->user_ns_id) {
+			pr_err("Nested time image requires root user namespace membership\n");
+			return -1;
+		}
+	}
+	for (ns = ns_ids; ns; ns = ns->next) {
+		if (ns->nd != &time_ns_desc)
+			continue;
+		ns->time.nsfd_id = -1;
+		if (ns->id == root_id) {
+			fd = open_proc(PROC_SELF, "ns/time");
+			if (fd < 0)
+				return -1;
+			ns->time.nsfd_id = fdstore_add(fd);
+			close(fd);
+			if (ns->time.nsfd_id < 0)
+				return -1;
+			continue;
+		}
+		if (ns->type == NS_CRIU)
+			continue;
+		child = fork();
+		if (child < 0)
+			return -1;
+		if (!child) {
+			close_pid_proc();
+			if (prepare_relative_time_namespace(ns->id)) {
+				pr_perror("Can't prepare relative time namespace %u", ns->id);
+				_exit(1);
+			}
+			fd = open_proc(PROC_SELF, "ns/time");
+			if (fd < 0)
+				_exit(1);
+			ns->time.nsfd_id = fdstore_add(fd);
+			close(fd);
+			_exit(ns->time.nsfd_id < 0 ? 1 : 0);
+		}
+		if (waitpid(child, &status, 0) != child || !WIFEXITED(status) || WEXITSTATUS(status))
+			return -1;
+	}
+	return 0;
+}
