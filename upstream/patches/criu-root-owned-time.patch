+static int read_offsets(pid_t pid, struct timespec *mono, struct timespec *boot)
+{
+	FILE *file;
+	int fd, i, seen = 0;
+	char clock[32];
+	long long sec;
+	long nsec;
+
+	fd = open_proc(pid, "timens_offsets");
+	if (fd < 0)
+		return -1;
+	file = fdopen(fd, "r");
+	if (!file) {
+		close(fd);
+		return -1;
+	}
+	for (i = 0; i < 2; i++) {
+		struct timespec *target;
+		if (fscanf(file, "%31s %lld %ld", clock, &sec, &nsec) != 3)
+			goto fail;
+		if (!strcmp(clock, "monotonic")) {
+			target = mono;
+			seen |= 1;
+		} else if (!strcmp(clock, "boottime")) {
+			target = boot;
+			seen |= 2;
+		} else
+			goto fail;
+		target->tv_sec = sec;
+		target->tv_nsec = nsec;
+	}
+	fclose(file);
+	return seen == 3 ? 0 : -1;
+fail:
+	fclose(file);
+	return -1;
+}
 
