+static int prepare_relative_time_namespace(int id)
+{
+	struct cr_img *img;
+	TimensEntry *entry = NULL;
+	struct timespec mono, boot;
+	int fd = -1, ret = -1;
+
+	img = open_image(CR_FD_TIMENS, O_RSTR, id);
+	if (!img)
+		return -1;
+	if (pb_read_one(img, &entry, PB_TIMENS) < 0) {
+		close_image(img);
+		return -1;
+	}
+	close_image(img);
+	if (!entry->has_relative_monotonic_sec || !entry->has_relative_monotonic_nsec ||
+	    !entry->has_relative_boottime_sec || !entry->has_relative_boottime_nsec ||
+	    read_offsets(PROC_SELF, &mono, &boot))
+		goto out;
+	mono.tv_sec += entry->relative_monotonic_sec;
+	mono.tv_nsec += entry->relative_monotonic_nsec;
+	boot.tv_sec += entry->relative_boottime_sec;
+	boot.tv_nsec += entry->relative_boottime_nsec;
+	normalize_timespec(&mono);
+	normalize_timespec(&boot);
+	if (unshare(CLONE_NEWTIME))
+		goto out;
+	fd = open_proc_rw(PROC_SELF, "timens_offsets");
+	if (fd < 0)
+		goto out;
+	if (dprintf(fd, "%d %lld %ld\n", CLOCK_MONOTONIC, (long long)mono.tv_sec, mono.tv_nsec) < 0 ||
+	    dprintf(fd, "%d %lld %ld\n", CLOCK_BOOTTIME, (long long)boot.tv_sec, boot.tv_nsec) < 0)
+		goto out;
+	close_safe(&fd);
+	fd = open_proc(PROC_SELF, "ns/time_for_children");
+	if (fd < 0 || switch_ns_by_fd(fd, &time_ns_desc, NULL))
+		goto out;
+	ret = 0;
+out:
+	close_safe(&fd);
+	timens_entry__free_unpacked(entry, NULL);
+	return ret;
+}
