diff --git a/linuxUtils/shm_probe_linux.go b/linuxUtils/shm_probe_linux.go
--- /dev/null
+++ b/linuxUtils/shm_probe_linux.go
@@ -0,0 +1,136 @@
+//go:build linux
+
+package linuxUtils
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"runtime"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+const (
+	shmProbeArgument = "--sysbox-internal-shm-userns-probe"
+	shmProbeEnv      = "_SYSBOX_INTERNAL_SHM_USERNS_PROBE"
+	shmProbeHostID   = 165536
+	shmProbeMapSize  = 65536
+)
+
+// A fresh executable has its own Go runtime and libc thread state. Never call
+// Go or setxid callbacks in the child of CreateUsernsProcess's raw clone.
+func init() {
+	if len(os.Args) == 2 && os.Args[1] == shmProbeArgument && os.Getenv(shmProbeEnv) == "1" {
+		os.Exit(runShmProbe())
+	}
+}
+
+func shmProbeCommand(ctx context.Context) (*exec.Cmd, func(), error) {
+	files := []*os.File{}
+	closeFiles := func() {
+		for _, file := range files {
+			file.Close()
+		}
+	}
+	for _, namespace := range []string{"user", "ipc", "mnt"} {
+		file, err := os.Open("/proc/self/ns/" + namespace)
+		if err != nil {
+			closeFiles()
+			return nil, func() {}, err
+		}
+		files = append(files, file)
+	}
+	command := exec.CommandContext(ctx, "/proc/self/exe", shmProbeArgument)
+	command.Env = append(os.Environ(), shmProbeEnv+"=1")
+	command.ExtraFiles = files
+	command.SysProcAttr = &syscall.SysProcAttr{
+		Cloneflags:                 unix.CLONE_NEWUSER | unix.CLONE_NEWIPC | unix.CLONE_NEWNS,
+		UidMappings:                []syscall.SysProcIDMap{{ContainerID: 0, HostID: shmProbeHostID, Size: shmProbeMapSize}},
+		GidMappings:                []syscall.SysProcIDMap{{ContainerID: 0, HostID: shmProbeHostID, Size: shmProbeMapSize}},
+		GidMappingsEnableSetgroups: false,
+		Credential:                 &syscall.Credential{Uid: 0, Gid: 0, NoSetGroups: true},
+		Pdeathsig:                  unix.SIGKILL,
+	}
+	command.WaitDelay = time.Second
+	return command, closeFiles, nil
+}
+
+func shmSysctlUserNamespaced() (bool, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	command, closeFiles, err := shmProbeCommand(ctx)
+	if err != nil {
+		return false, err
+	}
+	defer closeFiles()
+	// Pdeathsig follows the creating OS thread. Retain it through Wait.
+	runtime.LockOSThread()
+	err = command.Run()
+	runtime.UnlockOSThread()
+	if ctx.Err() != nil {
+		return false, fmt.Errorf("shm namespace probe: %w", ctx.Err())
+	}
+	if err == nil {
+		return true, nil
+	}
+	var exit *exec.ExitError
+	if errors.As(err, &exit) && exit.ExitCode() == 2 {
+		return false, nil
+	}
+	return false, fmt.Errorf("shm namespace probe: %w", err)
+}
+
+func runShmProbe() int {
+	if os.Getuid() != 0 || os.Geteuid() != 0 || os.Getgid() != 0 || os.Getegid() != 0 {
+		return 1
+	}
+	for _, name := range []string{"uid_map", "gid_map"} {
+		data, err := os.ReadFile("/proc/self/" + name)
+		if err != nil {
+			return 1
+		}
+		fields := strings.Fields(string(data))
+		if len(fields) != 3 {
+			return 1
+		}
+		for index, expected := range []int{0, shmProbeHostID, shmProbeMapSize} {
+			value, err := strconv.Atoi(fields[index])
+			if err != nil || value != expected {
+				return 1
+			}
+		}
+	}
+	for index, namespace := range []string{"user", "ipc", "mnt"} {
+		inherited := os.NewFile(uintptr(3+index), "parent "+namespace+" namespace")
+		before, err := inherited.Stat()
+		var filesystem unix.Statfs_t
+		fsErr := unix.Fstatfs(int(inherited.Fd()), &filesystem)
+		inherited.Close()
+		current, statErr := os.Stat("/proc/self/ns/" + namespace)
+		if err != nil || fsErr != nil || filesystem.Type != unix.NSFS_MAGIC ||
+			statErr != nil || os.SameFile(before, current) {
+			return 1
+		}
+	}
+	// Preserve the upstream empirical test. Opening is sufficient: no sysctl
+	// value is read, rewritten or temporarily changed by this helper.
+	for _, path := range []string{
+		"/proc/sys/kernel/shmmni", "/proc/sys/kernel/shmmax", "/proc/sys/kernel/shmall",
+	} {
+		file, err := os.OpenFile(path, os.O_RDWR, 0)
+		if err != nil {
+			return 2
+		}
+		if err := file.Close(); err != nil {
+			return 1
+		}
+	}
+	return 0
+}
diff --git a/linuxUtils/shm_probe_linux_test.go b/linuxUtils/shm_probe_linux_test.go
--- /dev/null
+++ b/linuxUtils/shm_probe_linux_test.go
@@ -0,0 +1,55 @@
+//go:build linux
+
+package linuxUtils
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"runtime"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func TestShmProbeRefusesUnmappedProcess(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	command := exec.CommandContext(ctx, "/proc/self/exe", shmProbeArgument)
+	command.Env = append(os.Environ(), shmProbeEnv+"=1")
+	err := command.Run()
+	var exit *exec.ExitError
+	if !errors.As(err, &exit) || exit.ExitCode() != 1 || ctx.Err() != nil {
+		t.Fatal("unmapped helper invocation did not refuse promptly", err)
+	}
+}
+
+func TestShmProbeRefusesSharedNamespaces(t *testing.T) {
+	if os.Getenv("FACTORYBOX_NATIVE_SHM_PROBE") != "1" {
+		t.Skip("requires the owned Linux namespace fixture")
+	}
+	for _, namespace := range []struct {
+		name string
+		flag uintptr
+	}{{"ipc", unix.CLONE_NEWIPC}, {"mount", unix.CLONE_NEWNS}} {
+		t.Run(namespace.name, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			command, closeFiles, err := shmProbeCommand(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer closeFiles()
+			command.SysProcAttr.Cloneflags &^= namespace.flag
+			runtime.LockOSThread()
+			err = command.Run()
+			runtime.UnlockOSThread()
+			var exit *exec.ExitError
+			if !errors.As(err, &exit) || exit.ExitCode() != 1 || ctx.Err() != nil {
+				t.Fatal("helper accepted a shared parent namespace or did not exit promptly", err)
+			}
+		})
+	}
+}
diff --git a/linuxUtils/factorybox_shm_probe_linux_test.go b/linuxUtils/factorybox_shm_probe_linux_test.go
--- /dev/null
+++ b/linuxUtils/factorybox_shm_probe_linux_test.go
@@ -0,0 +1,31 @@
+//go:build linux
+
+package linuxUtils
+
+import (
+	"os"
+	"runtime"
+	"testing"
+)
+
+// This is the actual public startup probe, compiled with the native libc.
+// Repeating it exposes a child which inherited the parent's setxid thread state.
+func TestFactoryboxShmProbeNative(t *testing.T) {
+	if os.Getenv("FACTORYBOX_NATIVE_SHM_PROBE") != "1" {
+		t.Skip("requires the owned Linux namespace fixture")
+	}
+	runtime.GOMAXPROCS(2)
+	var first bool
+	for index := 0; index < 32; index++ {
+		supported, err := ShmSysctlUserNamespaced()
+		if err != nil {
+			t.Fatalf("probe %d failed: %v", index, err)
+		}
+		if index == 0 {
+			first = supported
+		} else if supported != first {
+			t.Fatal("same private namespace probe changed its support result")
+		}
+		t.Logf("probe %d completed, supported=%t", index, supported)
+	}
+}
