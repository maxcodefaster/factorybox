+
+func TestFactoryboxSnapshotFrozenExportAndIndependentImport(t *testing.T) {
+	if os.Getenv("FACTORYBOX_UPSTREAM_CONTAINER") != "1" {
+		t.Skip("requires the owned private-cgroup native fixture")
+	}
+	var nonce [16]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		t.Fatal(err)
+	}
+	id := "fbx-" + hex.EncodeToString(nonce[:])
+	group := "/sys/fs/cgroup/" + id
+	if err := os.Mkdir(group, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(group+"/init.scope", 0700); err != nil {
+		t.Fatal(err)
+	}
+	process := exec.Command("/bin/sleep", "60")
+	if err := process.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		os.WriteFile(group+"/cgroup.freeze", []byte("0"), 0600)
+		process.Process.Kill()
+		process.Wait()
+		os.Remove(group + "/init.scope")
+		os.Remove(group)
+	}()
+	if err := os.WriteFile(group+"/init.scope/cgroup.procs", []byte(strconv.Itoa(process.Process.Pid)), 0600); err != nil {
+		t.Fatal(err)
+	}
+	fd, err := libpidfd.Open(process.Process.Pid, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(int(fd))
+	original := &container{id: id, initPid: uint32(process.Process.Pid), initPidFd: fd,
+		regCompleted: true, netnsInode: 55, ctime: time.Unix(123, 0),
+		uidFirst: 100000, uidSize: 65536, gidFirst: 100000, gidSize: 65536,
+		procRoPaths: []string{"/proc/bus"}, procMaskPaths: []string{"/proc/keys"},
+		dataStore: map[string][]byte{"/proc/sys/kernel/panic": []byte("17\n")}}
+	fuse := &mocks.FuseServerServiceIface{}
+	css := &containerStateService{idTable: map[string]*container{id: original},
+		netnsTable: map[domain.Inode][]*container{55: {original}}, fss: fuse}
+	if _, err := css.ContainerSnapshot(id, original.initPid); err == nil {
+		t.Fatal("live unfrozen source exported")
+	}
+	if err := os.WriteFile(group+"/cgroup.freeze", []byte("1"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(time.Second)
+	for {
+		events, err := os.ReadFile(group + "/cgroup.events")
+		if err == nil && strings.Contains(string(events), "frozen 1\n") {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("native source freeze was not observed", err)
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if _, err := css.ContainerSnapshot(id, original.initPid+1); err == nil {
+		t.Fatal("wrong original PID accepted")
+	}
+	css.netnsTable[55] = append(css.netnsTable[55], &container{id: "peer"})
+	if _, err := css.ContainerSnapshot(id, original.initPid); err == nil {
+		t.Fatal("shared namespace exported")
+	}
+	css.netnsTable[55] = []*container{original}
+	exported, err := css.ContainerSnapshot(id, original.initPid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	immutable := append([]byte(nil), exported...)
+	original.dataStore["/proc/sys/kernel/panic"][0] = '9'
+	original.procRoPaths[0] = "/changed"
+	delete(css.idTable, id)
+	target := "fbx-" + strings.Repeat("c", 32)
+	var restored *container
+	fuse.On("CreateFuseServer", mock.Anything, mock.Anything).Run(func(args mock.Arguments) {
+		restored = args.Get(0).(*container)
+		if args.Get(0) != args.Get(1) {
+			t.Fatal("snapshot target shares another container's state")
+		}
+	}).Return(nil).Once()
+	if err := css.ContainerSnapshotPreRegister(target, exported); err != nil {
+		t.Fatal(err)
+	}
+	if restored == nil || !restored.ctime.Equal(time.Unix(123, 0)) || restored.forkSource != id ||
+		restored.uidFirst != 100000 || restored.gidSize != 65536 ||
+		restored.initPid != 0 || restored.initPidFd != 0 || restored.regCompleted ||
+		string(restored.dataStore["/proc/sys/kernel/panic"]) != "17\n" ||
+		restored.procRoPaths[0] != "/proc/bus" || restored.procMaskPaths[0] != "/proc/keys" {
+		t.Fatal("snapshot target lost captured values, protections or independent process identity")
+	}
+	restored.dataStore["/proc/sys/kernel/panic"][0] = 'X'
+	if !bytes.Equal(exported, immutable) {
+		t.Fatal("target mutation changed the saved snapshot")
+	}
+	if err := css.ContainerSnapshotPreRegister(target, exported); err == nil {
+		t.Fatal("duplicate target replaced existing state")
+	}
+	registration := &container{id: target, uidFirst: 200000, uidSize: restored.uidSize,
+		gidFirst: restored.gidFirst, gidSize: restored.gidSize,
+		procRoPaths: restored.procRoPaths, procMaskPaths: restored.procMaskPaths}
+	if err := css.ContainerRegister(registration); err == nil ||
+		!strings.Contains(err.Error(), "saved ID mappings or proc protections") {
+		t.Fatal("snapshot registration changed its saved mapping/protections", err)
+	}
+	failed := "fbx-" + strings.Repeat("d", 32)
+	fuse.On("CreateFuseServer", mock.Anything, mock.Anything).Return(errors.New("fixture failure")).Once()
+	if err := css.ContainerSnapshotPreRegister(failed, exported); err == nil || css.idTable[failed] != nil {
+		t.Fatal("failed snapshot FUSE creation retained target state")
+	}
+	fuse.AssertExpectations(t)
+}
+
+func TestFactoryboxSnapshotRejectsMalformedState(t *testing.T) {
+	valid := factoryboxStateSnapshot{Version: 1, Source: "fbx-" + strings.Repeat("a", 32),
+		Ctime: time.Unix(123, 0), UIDFirst: 100000, UIDSize: 65536, GIDFirst: 100000, GIDSize: 65536,
+		Data: map[string][]byte{"/proc/sys/kernel/panic": []byte("17")}}
+	encoded, _ := json.Marshal(valid)
+	css := &containerStateService{}
+	if err := css.ContainerSnapshotPreRegister(valid.Source, encoded); err == nil {
+		t.Fatal("source identity reused for target")
+	}
+	for _, bad := range [][]byte{nil, []byte("{}"), append(append([]byte(nil), encoded...), []byte("{}")...),
+		[]byte(strings.Replace(string(encoded), `"version":1`, `"version":2`, 1)),
+		[]byte(strings.Replace(string(encoded), `"uid_first":100000`, `"uid_first":0`, 1)),
+		[]byte(strings.Replace(string(encoded), `"/proc/sys/kernel/panic"`, `"../foreign"`, 1)),
+		[]byte(strings.Replace(string(encoded), `"version":1`, `"unknown":1,"version":1`, 1)),
+		bytes.Repeat([]byte("x"), factoryboxSnapshotLimit+1)} {
+		if _, err := decodeFactoryboxSnapshot(bad); err == nil {
+			t.Fatal("malformed, unknown, unsafe or oversized snapshot accepted")
+		}
+	}
+}
