+package state
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path"
+	"regexp"
+	"strings"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+const factoryboxSnapshotLimit = 1 << 20
+
+var factoryboxSnapshotID = regexp.MustCompile(`^fbx-[0-9a-f]{32}$`)
+
+// Process, namespace and FUSE-server handles are deliberately absent. A
+// restored target must create its own identities through normal registration.
+type factoryboxStateSnapshot struct {
+	Version       int               `json:"version"`
+	Source        string            `json:"source"`
+	Ctime         time.Time         `json:"ctime"`
+	UIDFirst      uint32            `json:"uid_first"`
+	UIDSize       uint32            `json:"uid_size"`
+	GIDFirst      uint32            `json:"gid_first"`
+	GIDSize       uint32            `json:"gid_size"`
+	ProcRoPaths   []string          `json:"proc_ro_paths"`
+	ProcMaskPaths []string          `json:"proc_mask_paths"`
+	Data          map[string][]byte `json:"data"`
+}
+
+func decodeFactoryboxSnapshot(data []byte) (*factoryboxStateSnapshot, error) {
+	if len(data) == 0 || len(data) > factoryboxSnapshotLimit {
+		return nil, fmt.Errorf("FUSE snapshot is absent or exceeds bound")
+	}
+	var snapshot factoryboxStateSnapshot
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&snapshot); err != nil {
+		return nil, err
+	}
+	if err := decoder.Decode(new(any)); err != io.EOF {
+		return nil, fmt.Errorf("FUSE snapshot contains trailing data")
+	}
+	if snapshot.Version != 1 || !factoryboxSnapshotID.MatchString(snapshot.Source) ||
+		snapshot.Ctime.IsZero() || snapshot.UIDFirst == 0 || snapshot.GIDFirst == 0 ||
+		snapshot.UIDSize == 0 || snapshot.GIDSize == 0 ||
+		uint64(snapshot.UIDFirst)+uint64(snapshot.UIDSize) > 1<<32 ||
+		uint64(snapshot.GIDFirst)+uint64(snapshot.GIDSize) > 1<<32 ||
+		len(snapshot.Data) > 4096 || len(snapshot.ProcRoPaths)+len(snapshot.ProcMaskPaths) > 4096 {
+		return nil, fmt.Errorf("invalid FUSE snapshot identity, mapping or size")
+	}
+	for _, paths := range [][]string{snapshot.ProcRoPaths, snapshot.ProcMaskPaths} {
+		for _, name := range paths {
+			if !path.IsAbs(name) || path.Clean(name) != name || len(name) > 4096 {
+				return nil, fmt.Errorf("invalid saved proc protection path")
+			}
+		}
+	}
+	for name := range snapshot.Data {
+		if !path.IsAbs(name) || path.Clean(name) != name || len(name) > 4096 {
+			return nil, fmt.Errorf("invalid saved virtual file path")
+		}
+	}
+	return &snapshot, nil
+}
+
+func factoryboxFrozenSnapshotSource(original *container, pid uint32) error {
+	if !factoryboxSnapshotID.MatchString(original.id) || !original.regCompleted ||
+		original.initPidFd <= 0 || pid <= 1 || original.initPid != pid {
+		return fmt.Errorf("FUSE snapshot source is not its original completed registration")
+	}
+	fds := []unix.PollFd{{Fd: int32(original.initPidFd), Events: unix.POLLIN}}
+	if n, err := unix.Poll(fds, 0); err != nil || n != 0 {
+		return fmt.Errorf("FUSE snapshot source pidfd has exited or is invalid: %v", err)
+	}
+	group := "/sys/fs/cgroup/" + original.id
+	membership, err := os.ReadFile(fmt.Sprintf("/proc/%d/cgroup", pid))
+	if err != nil || strings.TrimSpace(string(membership)) != "0::/"+original.id+"/init.scope" {
+		return fmt.Errorf("FUSE snapshot original PID changed its cgroup: %v", err)
+	}
+	freeze, err := os.ReadFile(group + "/cgroup.freeze")
+	if err != nil || strings.TrimSpace(string(freeze)) != "1" {
+		return fmt.Errorf("FUSE snapshot source freeze is not requested: %v", err)
+	}
+	events, err := os.ReadFile(group + "/cgroup.events")
+	if err != nil {
+		return err
+	}
+	seen := map[string]string{}
+	for _, line := range strings.Split(strings.TrimSpace(string(events)), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) != 2 || seen[fields[0]] != "" {
+			return fmt.Errorf("invalid FUSE snapshot source cgroup events")
+		}
+		seen[fields[0]] = fields[1]
+	}
+	if seen["frozen"] != "1" || seen["populated"] != "1" {
+		return fmt.Errorf("FUSE snapshot source is not completely frozen and populated")
+	}
+	return nil
+}
+
+func (css *containerStateService) ContainerSnapshot(id string, pid uint32) ([]byte, error) {
+	css.Lock()
+	defer css.Unlock()
+	original := css.idTable[id]
+	if original == nil {
+		return nil, fmt.Errorf("FUSE snapshot source does not exist")
+	}
+	if err := factoryboxFrozenSnapshotSource(original, pid); err != nil {
+		return nil, err
+	}
+	peers := css.netnsTable[original.netnsInode]
+	if len(peers) != 1 || peers[0] != original {
+		return nil, fmt.Errorf("FUSE snapshot cannot share its network namespace state")
+	}
+	original.intLock.RLock()
+	defer original.intLock.RUnlock()
+	snapshot := factoryboxStateSnapshot{Version: 1, Source: id, Ctime: original.ctime,
+		UIDFirst: original.uidFirst, UIDSize: original.uidSize,
+		GIDFirst: original.gidFirst, GIDSize: original.gidSize,
+		ProcRoPaths: original.procRoPaths, ProcMaskPaths: original.procMaskPaths,
+		Data: original.dataStore}
+	data, err := json.Marshal(snapshot)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := decodeFactoryboxSnapshot(data); err != nil {
+		return nil, err
+	}
+	return data, nil
+}
+
+func (css *containerStateService) ContainerSnapshotPreRegister(id string, data []byte) error {
+	snapshot, err := decodeFactoryboxSnapshot(data)
+	if err != nil {
+		return err
+	}
+	if !factoryboxSnapshotID.MatchString(id) || id == snapshot.Source {
+		return fmt.Errorf("FUSE snapshot target must have an independent Factorybox identity")
+	}
+	return css.preRegister(id, "", "", snapshot)
+}
