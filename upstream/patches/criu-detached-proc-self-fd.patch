+static int dump_detached_proc(int lfd, const struct fd_parms *p, const struct fd_link *link,
+			      DetachedProcMount *image)
+{
+	struct fd_parms root_parms = *p;
+	struct fd_link root_link = { .name = "./", .len = 2 };
+	pid_t pid;
+	int root, mount_id, ret = -1;
+
+	if (!strcmp(link->name + 1, "/"))
+		return dump_detached_proc_root(lfd, p, link, image);
+	if (!nested_ns_enabled() || p->mnt_id <= 0 || p->fs_type != PROC_SUPER_MAGIC ||
+	    !S_ISDIR(p->stat.st_mode) || !detached_proc_readable_dir(p->flags, p->pos) ||
+	    !detached_proc_self_fd_dir(link->name + 1, &pid))
+		return -1;
+	if (nested_ns_dump_own_pid(p->pid, -1) != pid) {
+		pr_err("Detached proc directory is not the file owner's own fd table\n");
+		return -1;
+	}
+
+	/* Walk only this canonical directory's own proc ancestry. Never replace
+	 * the saved handle with a different visible proc mount. */
+	root = openat(lfd, "../../../..", O_PATH | O_CLOEXEC);
+	if (root < 0)
+		return -1;
+	if (fstat(root, &root_parms.stat) || get_fd_mntid(root, &mount_id) ||
+	    mount_id != p->mnt_id || root_parms.stat.st_dev != p->stat.st_dev)
+		goto out;
+	root_parms.flags = O_PATH;
+	root_parms.pos = 0;
+	ret = dump_detached_proc_root(root, &root_parms, &root_link, image);
+out:
+	close(root);
+	return ret;
+}
