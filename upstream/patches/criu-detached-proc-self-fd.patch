+static bool detached_proc_self_fd_dir(const char *path, pid_t *pid)
+{
+	char expected[64], *end;
+	long value;
+
+	if (!path || path[0] != '/')
+		return false;
+	errno = 0;
+	value = strtol(path + 1, &end, 10);
+	if (errno || end == path + 1 || value <= 0 || value > INT_MAX)
+		return false;
+	snprintf(expected, sizeof(expected), "/%ld/task/%ld/fd", value, value);
+	if (strcmp(path, expected))
+		return false;
+	*pid = (pid_t)value;
+	return true;
+}
+
+static bool detached_proc_readable_dir(unsigned int flags, off_t pos)
+{
+	/* F_GETFL can include kernel O_LARGEFILE when libc defines it as zero.
+	 * Keep the original bits and constrain access and creation separately. */
+	return pos == 0 &&
+	       (flags & (O_ACCMODE | O_DIRECTORY | O_PATH)) == (O_RDONLY | O_DIRECTORY) &&
+	       !(flags & (O_CREAT | O_EXCL | O_TRUNC | O_CLOEXEC)) &&
+	       (flags & O_TMPFILE) != O_TMPFILE;
+}
