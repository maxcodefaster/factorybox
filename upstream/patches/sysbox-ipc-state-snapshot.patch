+package sysboxFsGrpc
+
+import (
+	"bytes"
+	"testing"
+	"time"
+
+	"github.com/golang/protobuf/proto"
+	pb "github.com/nestybox/sysbox-ipc/sysboxFsGrpc/sysboxFsProtobuf"
+)
+
+func TestFactoryboxSnapshotSurvivesWireEncoding(t *testing.T) {
+	input := &ContainerData{Id: "fbx-target", Ctime: time.Unix(123, 0),
+		ForkState: []byte(`{"version":1,"data":{"/proc/sys/kernel/panic":"MTc="}}`)}
+	wire, err := containerDataToPbData(input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := proto.Marshal(wire)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded pb.ContainerData
+	if err := proto.Unmarshal(encoded, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	output, err := pbDatatoContainerData(&decoded)
+	if err != nil || output.Id != input.Id || !bytes.Equal(output.ForkState, input.ForkState) {
+		t.Fatal("snapshot bytes or target identity changed on the wire", err)
+	}
+	server := &Server{Callbacks: CallbacksMap{ContainerSnapshotMessage: func(_ interface{}, data *ContainerData) error {
+		data.ForkState = append([]byte(nil), input.ForkState...)
+		return nil
+	}}}
+	response, err := server.ContainerSnapshot(nil, wire)
+	if err != nil || !response.Success || !bytes.Equal(response.State, input.ForkState) {
+		t.Fatal("snapshot callback did not return its exact bytes", err)
+	}
+	if _, err := server.ContainerSnapshot(nil, nil); err == nil {
+		t.Fatal("nil snapshot request accepted")
+	}
+}
