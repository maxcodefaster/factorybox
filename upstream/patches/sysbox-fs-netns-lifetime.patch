+
+func pinContainerNetns(pid uint32, expected domain.Inode) (*os.File, error) {
+	file, err := os.Open(fmt.Sprintf("/proc/%d/ns/net", pid))
+	if err != nil {
+		return nil, err
+	}
+	var stat unix.Stat_t
+	if err := unix.Fstat(int(file.Fd()), &stat); err != nil {
+		file.Close()
+		return nil, err
+	}
+	if expected == 0 || stat.Ino != expected {
+		file.Close()
+		return nil, fmt.Errorf("network namespace identity changed for pid %d: expected=%d actual=%d", pid, expected, stat.Ino)
+	}
+	return file, nil
 }
 
