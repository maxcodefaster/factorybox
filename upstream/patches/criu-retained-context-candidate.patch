+
+static volatile sig_atomic_t child_pid;
+static int lifetime_write = -1;
+static int *active_phase;
+static int emergency_freezer = -1;
+static int original_pids[4];
+static unsigned long long original_starts[4];
+static char recovery_nonce[65];
+static char capture_token[33];
+#define RETAINED_THREADS 512
+struct retained_thread {
+	int tid, tgid;
+	unsigned long long start;
+};
+static struct retained_thread original_tree[RETAINED_THREADS];
+static int original_count;
+
+static unsigned long long process_field(int pid, int wanted)
+{
+	char path[64], data[4096], *end, *value, *next;
+	FILE *file;
+	int field;
+	snprintf(path, sizeof(path), "/proc/%d/stat", pid);
+	file = fopen(path, "r");
+	if (!file)
+		return 0;
+	if (!fgets(data, sizeof(data), file)) {
+		fclose(file);
+		return 0;
+	}
+	fclose(file);
+	end = strrchr(data, ')');
+	if (!end)
+		return 0;
+	value = strtok_r(end + 2, " ", &next);
+	for (field = 3; value && field < wanted; field++)
+		value = strtok_r(NULL, " ", &next);
+	return value ? strtoull(value, NULL, 10) : 0;
+}
+
+static ssize_t private_record(int directory, const char *name, char *data, size_t capacity)
+{
+	struct stat stat;
+	int fd = openat(directory, name, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+	ssize_t count;
+	if (fd < 0)
+		return -1;
+	if (fstat(fd, &stat) || !S_ISREG(stat.st_mode) || stat.st_uid ||
+	    (stat.st_mode & 0777) != 0600 || stat.st_nlink != 1 ||
+	    stat.st_size <= 0 || stat.st_size >= (off_t)capacity) {
+		close(fd);
+		return -1;
+	}
+	do {
+		count = read(fd, data, capacity - 1);
+	} while (count < 0 && errno == EINTR);
+	close(fd);
+	if (count != stat.st_size)
+		return -1;
+	data[count] = '\0';
+	return count;
+}
+
+static int private_number(int directory, const char *name, const char *key)
+{
+	char data[4096], needle[128], *value;
+	if (private_record(directory, name, data, sizeof(data)) < 0)
+		return -1;
+	snprintf(needle, sizeof(needle), "\"%s\":", key);
+	value = strstr(data, needle);
+	return value ? atoi(value + strlen(needle)) : -1;
+}
+
+static int original_token(int directory)
+{
+	char data[4096], *value;
+	const char *needle = "\"token\":\"";
+	if (private_record(directory, "guard-armed.json", data, sizeof(data)) < 0)
+		return -1;
+	value = strstr(data, needle);
+	if (!value)
+		return -1;
+	value += strlen(needle);
+	if (strspn(value, "0123456789abcdef") != 32 || value[32] != '"')
+		return -1;
+	memcpy(capture_token, value, 32);
+	capture_token[32] = '\0';
+	return 0;
+}
+
+static int metadata(int directory, const char *name, const char *data)
+{
+	char temporary[192];
+	int fd;
+	size_t length = strlen(data);
+	int failed;
+	snprintf(temporary, sizeof(temporary), ".%s.writing.%d", name, getpid());
+	fd = openat(directory, temporary, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+	if (fd < 0)
+		return -1;
+	failed = write(fd, data, length) != (ssize_t)length || fsync(fd);
+	if (close(fd))
+		failed = 1;
+	/* CRIU dumps one process at a time. Only the current arm is replaced;
+	 * a dead writer leaves that final, complete generation immutable. */
+	if (!failed && !strcmp(name, "criu-retained-arm.json")) {
+		struct stat previous;
+		if (!fstatat(directory, name, &previous, AT_SYMLINK_NOFOLLOW)) {
+			if (!S_ISREG(previous.st_mode) || previous.st_uid ||
+			    (previous.st_mode & 0777) != 0600 || previous.st_nlink != 1)
+				failed = 1;
+		} else if (errno != ENOENT) {
+			failed = 1;
+		}
+	}
+	if (!failed && syscall(SYS_renameat2, directory, temporary, directory, name,
+			       strcmp(name, "criu-retained-arm.json") ? 1 : 0))
+		failed = 1;
+	if (failed)
+		unlinkat(directory, temporary, 0);
+	if (fsync(directory))
+		failed = 1;
+	return failed ? -1 : 0;
+}
+
+static int granted(int directory)
+{
+	char data[4096], expected[384];
+	ssize_t count = private_record(directory, "criu-retained-request.json", data, sizeof(data));
+	/* Version one is exactly the canonical retainedCaptureRequest emitted by
+	 * the original Go guard. Compare one complete read, including token and
+	 * newline, so partial files, duplicate keys and trailing data cannot grant. */
+	int length = snprintf(expected, sizeof(expected),
+			      "{\"version\":1,\"token\":\"%s\",\"controller_pid\":%d,"
+			      "\"guard_pid\":%d,\"nonce\":\"%s\"}\n",
+			      capture_token, original_pids[2], original_pids[3], recovery_nonce);
+	return count == length && length > 0 && length < (int)sizeof(expected) &&
+	       !memcmp(data, expected, length);
+}
+
+static int frozen(int group, int want)
+{
+	int fd, attempt;
+	char value = want ? '1' : '0';
+	fd = openat(group, "cgroup.freeze", O_WRONLY | O_NOFOLLOW | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	if (write(fd, &value, 1) != 1) {
+		close(fd);
+		return -1;
+	}
+	close(fd);
+	for (attempt = 0; attempt < 500; attempt++) {
+		char data[4096] = {0};
+		ssize_t count;
+		fd = openat(group, "cgroup.events", O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+		if (fd < 0)
+			return -1;
+		count = read(fd, data, sizeof(data) - 1);
+		close(fd);
+		if (count < 0)
+			return -1;
+		if (strstr(data, "populated 1\n") && strstr(data, want ? "frozen 1\n" : "frozen 0\n"))
+			return 0;
+		usleep(1000);
+	}
+	return -1;
+}
+
+static void expired(int signal)
+{
+	(void)signal;
+	if (emergency_freezer >= 0 && write(emergency_freezer, "1", 1) != 1)
+		_exit(125);
+	_exit(124);
+}
+
+static int read_source_tree(int group, struct retained_thread *threads, size_t capacity, int depth,
+			    int *count, int *directories, uint64_t mount)
+{
+	char data[4096] = {0}, *value, *next;
+	int fd;
+	ssize_t bytes;
+	DIR *entries;
+	struct dirent *entry;
+	struct statx identity;
+	struct statfs filesystem;
+	if (depth > 32 || ++*directories > 4096 ||
+	    fstatfs(group, &filesystem) || filesystem.f_type != CGROUP2_SUPER_MAGIC ||
+	    statx(group, "", AT_EMPTY_PATH, STATX_MNT_ID, &identity) ||
+	    !(identity.stx_mask & STATX_MNT_ID) || identity.stx_mnt_id != mount)
+		return -1;
+	fd = openat(group, "cgroup.threads", O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	bytes = read(fd, data, sizeof(data) - 1);
+	close(fd);
+	if (bytes < 0 || bytes == (ssize_t)sizeof(data) - 1)
+		return -1;
+	value = strtok_r(data, " \n", &next);
+	while (value) {
+		char path[64], line[256];
+		int tgid = 0, tid = atoi(value);
+		FILE *status;
+		if (tid <= 1 || *count == (int)capacity) {
+			pr_info("[FBX-RECOVERY] invalid or excessive tid=%d count=%d\n", tid, *count);
+			return -1;
+		}
+		snprintf(path, sizeof(path), "/proc/%d/status", tid);
+		status = fopen(path, "r");
+		if (!status)
+			return -1;
+		while (fgets(line, sizeof(line), status))
+			if (sscanf(line, "Tgid: %d", &tgid) == 1)
+				break;
+		fclose(status);
+		if (tgid <= 1)
+			return -1;
+		threads[*count].tid = tid;
+		threads[*count].tgid = tgid;
+		threads[*count].start = process_field(tid, 22);
+		if (!threads[*count].start)
+			return -1;
+		(*count)++;
+		value = strtok_r(NULL, " \n", &next);
+	}
+	entries = fdopendir(openat(group, ".", O_RDONLY | O_DIRECTORY | O_CLOEXEC));
+	if (!entries)
+		return -1;
+	while ((entry = readdir(entries))) {
+		struct stat child;
+		int next_group, failed;
+		if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, ".."))
+			continue;
+		if (fstatat(group, entry->d_name, &child, AT_SYMLINK_NOFOLLOW)) {
+			closedir(entries);
+			return -1;
+		}
+		if (!S_ISDIR(child.st_mode))
+			continue;
+		next_group = openat(group, entry->d_name, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+		if (next_group < 0) {
+			closedir(entries);
+			return -1;
+		}
+		failed = read_source_tree(next_group, threads, capacity, depth + 1, count, directories, mount);
+		close(next_group);
+		if (failed) {
+			closedir(entries);
+			return -1;
+		}
+	}
+	closedir(entries);
+	return 0;
+}
+
+static int thread_order(const void *left, const void *right)
+{
+	const struct retained_thread *a = left, *b = right;
+	return (a->tid > b->tid) - (a->tid < b->tid);
+}
+
+static int source_threads(int group, struct retained_thread *threads, size_t capacity)
+{
+	struct statx identity;
+	int count = 0, directories = 0;
+	if (statx(group, "", AT_EMPTY_PATH, STATX_MNT_ID, &identity) ||
+	    !(identity.stx_mask & STATX_MNT_ID) || !identity.stx_mnt_id ||
+	    read_source_tree(group, threads, capacity, 0, &count, &directories, identity.stx_mnt_id))
+		return -1;
+	qsort(threads, count, sizeof(*threads), thread_order);
+	for (int index = 1; index < count; index++)
+		if (threads[index - 1].tid == threads[index].tid)
+			return -1;
+	return count;
+}
+
+static int admitted_tree(void)
+{
+	struct pstree_item *item;
+	int expected = 0, matched = 0, index, thread;
+	for_each_pstree_item(item) {
+		if (item->pid->state != TASK_ALIVE)
+			return -1;
+		expected += item->nr_threads;
+		for (thread = 0; thread < item->nr_threads; thread++) {
+			for (index = 0; index < original_count; index++)
+				if (original_tree[index].tid == item->threads[thread].real &&
+				    original_tree[index].tgid == item->pid->real) {
+					matched++;
+					break;
+				}
+		}
+	}
+	return expected == original_count && matched == original_count ? 0 : -1;
+}
+
+static int captured_vpid(int pid)
+{
+	struct pstree_item *item;
+	for_each_pstree_item(item)
+		if (item->pid->real == pid)
+			return vpid(item);
+	return -1;
+}
+
+static int unchanged_tree(int group)
+{
+	struct retained_thread actual[RETAINED_THREADS];
+	int index, count = source_threads(group, actual, RETAINED_THREADS);
+	if (count != original_count)
+		return -1;
+	for (index = 0; index < count; index++)
+		if (actual[index].tid != original_tree[index].tid ||
+		    actual[index].tgid != original_tree[index].tgid ||
+		    actual[index].start != original_tree[index].start)
+			return -1;
+	return 0;
+}
+
+static int dead(int pidfd, int milliseconds)
+{
+	struct pollfd event = {.fd = pidfd, .events = POLLIN};
+	return poll(&event, 1, milliseconds) == 1 && (event.revents & POLLIN);
+}
+
+static int injected_maps(int pid)
+{
+	char path[64], line[4096];
+	FILE *file;
+	int count = 0;
+	snprintf(path, sizeof(path), "/proc/%d/maps", pid);
+	file = fopen(path, "r");
+	if (!file)
+		return -1;
+	while (fgets(line, sizeof(line), file))
+		if (strstr(line, "CRIUMFD"))
+			count++;
+	fclose(file);
+	return count;
+}
+
+static void retain_fds(int *keep, size_t count)
+{
+	DIR *list = opendir("/proc/self/fd");
+	struct dirent *entry;
+	if (!list)
+		_exit(20);
+	while ((entry = readdir(list))) {
+		int fd, retain = 0;
+		size_t index;
+		if (entry->d_name[0] == '.')
+			continue;
+		fd = atoi(entry->d_name);
+		if (fd == dirfd(list))
+			continue;
+		for (index = 0; index < count; index++)
+			retain |= keep[index] == fd;
+		if (!retain)
+			close(fd);
+	}
+	closedir(list);
+}
+
+static void recover(struct parasite_ctl *ctl, int group, int evidence, int life,
+		    int ready, int *parents, int source, unsigned long long source_start, int active)
+{
+	char record[64 << 10], log_name[80], command;
+	int log, original_log = log_get_fd(), count = original_count, result = -1, index, used;
+	int keep[] = {group, evidence, life, ready, parents[0], parents[1], parents[2], parents[3],
+		      parents[4], compel_rpc_sock(ctl), original_log, 1, 2};
+	struct sigaction action = {.sa_handler = SIG_DFL};
+	struct pollfd events[2] = {{.fd = life, .events = POLLIN}, {.fd = parents[0], .events = POLLIN}};
+	user_regs_struct_t expected = ctl->orig.regs, actual;
+	k_rtsigset_t expected_mask = ctl->orig.sigmask, actual_mask;
+	int maps = -1, registers_match = 0, mask_match = 0, authorized = 0, processes = 0;
+	sigemptyset(&action.sa_mask);
+	if (sigaction(SIGCHLD, &action, NULL))
+		_exit(21);
+	snprintf(log_name, sizeof(log_name), "criu-retained-%d.log", active);
+	log = openat(evidence, log_name, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+	if (log < 0 || original_log < 0 || dup2(log, original_log) < 0 ||
+	    dup2(log, STDOUT_FILENO) < 0 || dup2(log, STDERR_FILENO) < 0)
+		_exit(22);
+	retain_fds(keep, sizeof(keep) / sizeof(keep[0]));
+	used = snprintf(record, sizeof(record),
+		 "{\"version\":3,\"mode\":\"process_tree_retained\",\"source_pid\":%d,"
+		 "\"source_start\":\"%llu\",\"helper_pid\":%d,\"helper_start\":\"%llu\","
+		 "\"tracer_pid\":%d,\"tracer_start\":\"%llu\",\"worker_pid\":%d,\"worker_start\":\"%llu\","
+		 "\"controller_pid\":%d,\"controller_start\":\"%llu\",\"guard_pid\":%d,"
+		 "\"guard_start\":\"%llu\",\"nonce\":\"%s\",\"active_pid\":%d,"
+		 "\"active_start\":\"%llu\",\"active_vpid\":%d,\"tree\":[",
+		 source, source_start, getpid(), process_field(getpid(), 22),
+		 original_pids[0], original_starts[0], original_pids[1], original_starts[1],
+		 original_pids[2], original_starts[2], original_pids[3], original_starts[3], recovery_nonce,
+		 active, process_field(active, 22), captured_vpid(active));
+	if (used < 0 || used >= (int)sizeof(record))
+		_exit(23);
+	for (index = 0; index < count; index++) {
+		int length = snprintf(record + used, sizeof(record) - used,
+				      "%s{\"tid\":%d,\"tgid\":%d,\"start\":\"%llu\"}",
+				      index ? "," : "", original_tree[index].tid,
+				      original_tree[index].tgid, original_tree[index].start);
+		if (length < 0 || length >= (int)sizeof(record) - used)
+			_exit(23);
+		used += length;
+		processes += original_tree[index].tid == original_tree[index].tgid;
+	}
+	if (used < 0 || used >= (int)sizeof(record) - 4)
+		_exit(23);
+	memcpy(record + used, "]}\n", 4);
+	if (metadata(evidence, "criu-retained-arm.json", record) || write(ready, "R", 1) != 1)
+		_exit(23);
+	close(ready);
+	/* All inherited RPC/stdout descriptors were closed above, so the
+	 * original tracer's death cannot leave the Go worker blocked. */
+	for (;;) {
+		int ready = poll(events, 2, 15000);
+		if (ready <= 0)
+			_exit(24);
+		if (events[0].revents & POLLIN) {
+			if (read(life, &command, 1) == 1 && command == 'C')
+				_exit(0);
+		}
+		if (events[1].revents & POLLIN)
+			break;
+	}
+	if (!__atomic_load_n(active_phase, __ATOMIC_ACQUIRE))
+		_exit(25);
+	/* The failed worker must have completed its hold and network rollback.
+	 * A live original guard may then grant this exact retained nonce.
+	 * Older diagnostic callers still require both controllers to exit. */
+	if (!dead(parents[1], 10000))
+		_exit(26);
+	for (index = 0; index < 2000; index++) {
+		if (!dead(parents[3], 0) && granted(evidence)) {
+			authorized = 1;
+			break;
+		}
+		if (dead(parents[2], 0) && dead(parents[3], 0))
+			break;
+		usleep(5000);
+	}
+	if (index == 2000)
+		_exit(26);
+	if (dead(parents[4], 0) || process_field(source, 22) != source_start)
+		_exit(27);
+	emergency_freezer = openat(group, "cgroup.freeze", O_WRONLY | O_NOFOLLOW | O_CLOEXEC);
+	action.sa_handler = expired;
+	if (emergency_freezer < 0 || sigaction(SIGALRM, &action, NULL))
+		_exit(28);
+	alarm(10);
+	if (frozen(group, 1))
+		goto finish;
+	if (count <= 0 || unchanged_tree(group))
+		goto finish;
+	for (index = 0; index < count; index++) {
+		int tid = original_tree[index].tid;
+		if (ptrace(PTRACE_SEIZE, tid, NULL, PTRACE_O_TRACESYSGOOD) ||
+		    (tid != active && ptrace(PTRACE_INTERRUPT, tid, NULL, NULL)))
+			goto finish;
+	}
+	if (frozen(group, 0))
+		goto finish;
+	for (index = 0; index < count; index++) {
+		int status;
+		int tid = original_tree[index].tid;
+		if (tid != active &&
+		    (waitpid(tid, &status, __WALL) != tid || !WIFSTOPPED(status)))
+			goto finish;
+	}
+	if (compel_cure(ctl))
+		goto finish;
+	registers_match = !ptrace_get_regs(active, &actual) && !memcmp(&actual, &expected, sizeof(expected));
+	mask_match = !ptrace(PTRACE_GETSIGMASK, active, sizeof(actual_mask), &actual_mask) &&
+		     !memcmp(&actual_mask, &expected_mask, sizeof(expected_mask));
+	maps = 0;
+	for (index = 0; index < count; index++) {
+		if (original_tree[index].tid == original_tree[index].tgid) {
+			int current = injected_maps(original_tree[index].tgid);
+			if (current < 0) {
+				maps = -1;
+				break;
+			}
+			maps += current;
+		}
+	}
+	if (!registers_match || !mask_match || maps != 0 || unchanged_tree(group) || frozen(group, 1))
+		goto finish;
+	for (index = 0; index < count; index++)
+		if (compel_resume_task(original_tree[index].tid, COMPEL_TASK_ALIVE, COMPEL_TASK_ALIVE))
+			goto finish;
+	result = 0;
+finish:
+	if (frozen(group, 1))
+		result = -1;
+	alarm(0);
+	snprintf(record, sizeof(record),
+		 "{\"version\":3,\"passed\":%s,\"source_pid\":%d,\"source_start\":\"%llu\","
+		 "\"helper_pid\":%d,\"threads\":%d,\"registers_match\":%s,"
+		 "\"signal_mask_match\":%s,\"injected_maps_after\":%d,\"source_held\":true,"
+		 "\"guard_authorized\":%s,\"nonce\":\"%s\",\"active_pid\":%d,\"processes\":%d}\n",
+		 result == 0 ? "true" : "false", source, source_start, getpid(), count,
+		 registers_match ? "true" : "false", mask_match ? "true" : "false", maps,
+		 authorized ? "true" : "false", recovery_nonce, active, processes);
+	metadata(evidence, "criu-retained-result.json", record);
+	_exit(result == 0 ? 0 : 1);
+}
+
+int factorybox_retained_begin(struct parasite_ctl *ctl, int pid)
+{
+	int group = -1, evidence = -1, life[2], ready[2], parents[5], worker, controller, guard;
+	int index, child;
+	unsigned char random_nonce[32];
+	struct stat info;
+	struct statfs filesystem;
+	sigset_t blocked, previous;
+	const char *scope = getenv("SYSBOX_FORK_COLLECT_SCOPE");
+	const char *reason = "scope";
+	pr_info("[FBX-RECOVERY] consider pid=%d root=%d state=%d scope=%s freezer=%s\n",
+		pid, root_item->pid->real, root_item->pid->state, scope ? scope : "(null)",
+		opts.freeze_cgroup ? opts.freeze_cgroup : "(null)");
+	if (!scope || strcmp(scope, "1") || !opts.freeze_cgroup ||
+	    strncmp(opts.freeze_cgroup, "/sys/fs/cgroup/fbx-", 19) ||
+	    root_item->pid->state != TASK_ALIVE)
+		return 0;
+	group = open(opts.freeze_cgroup, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	reason = "cgroup filesystem";
+	if (group < 0 || fstatfs(group, &filesystem) || filesystem.f_type != CGROUP2_SUPER_MAGIC)
+		goto skip;
+	original_count = source_threads(group, original_tree, RETAINED_THREADS);
+	reason = "complete living process tree";
+	if (original_count <= 0 || admitted_tree())
+		goto skip;
+	evidence = openat(get_service_fd(IMG_FD_OFF), "../guard",
+			  O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	reason = "private evidence directory";
+	if (evidence < 0 || fstat(evidence, &info) || info.st_uid || (info.st_mode & 0777) != 0700)
+		goto skip;
+	worker = getppid();
+	controller = process_field(worker, 4);
+	guard = private_number(evidence, "guard-armed.json", "helper_pid");
+	reason = "original worker/controller/guard";
+	if (worker <= 1 || controller <= 1 || guard <= 1 || original_token(evidence))
+		goto skip;
+	original_pids[0] = getpid();
+	original_pids[1] = worker;
+	original_pids[2] = controller;
+	original_pids[3] = guard;
+	for (index = 0; index < 4; index++) {
+		original_starts[index] = process_field(original_pids[index], 22);
+		if (!original_starts[index])
+			goto skip;
+	}
+	if (getrandom(random_nonce, sizeof(random_nonce), 0) != sizeof(random_nonce))
+		goto skip;
+	for (index = 0; index < 32; index++)
+		snprintf(recovery_nonce + index * 2, 3, "%02x", random_nonce[index]);
+	parents[0] = syscall(SYS_pidfd_open, getpid(), 0);
+	parents[1] = syscall(SYS_pidfd_open, worker, 0);
+	parents[2] = syscall(SYS_pidfd_open, controller, 0);
+	parents[3] = syscall(SYS_pidfd_open, guard, 0);
+	parents[4] = syscall(SYS_pidfd_open, root_item->pid->real, 0);
+	for (index = 0; index < 5; index++)
+		if (parents[index] < 0)
+			goto close_parents;
+	active_phase = mmap(NULL, 4096, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+	if (active_phase == MAP_FAILED) {
+		active_phase = NULL;
+		goto close_parents;
+	}
+	__atomic_store_n(active_phase, 1, __ATOMIC_RELEASE);
+	if (socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0, life))
+		goto close_map;
+	if (pipe2(ready, O_CLOEXEC))
+		goto close_pipe;
+	sigemptyset(&blocked);
+	sigaddset(&blocked, SIGCHLD);
+	if (sigprocmask(SIG_BLOCK, &blocked, &previous))
+		goto close_ready;
+	child = fork();
+	if (child == 0) {
+		close(life[1]);
+		close(ready[0]);
+		sigprocmask(SIG_SETMASK, &previous, NULL);
+		recover(ctl, group, evidence, life[0], ready[1], parents, root_item->pid->real,
+			process_field(root_item->pid->real, 22), pid);
+		_exit(29);
+	}
+	child_pid = child > 0 ? child : 0;
+	close(life[0]);
+	close(ready[1]);
+	if (child > 0) {
+		char acknowledgement;
+		struct pollfd armed = {.fd = ready[0], .events = POLLIN};
+		if (poll(&armed, 1, 2000) != 1 || read(ready[0], &acknowledgement, 1) != 1 ||
+		    acknowledgement != 'R') {
+			int status;
+			pr_warn("[FBX-RECOVERY] child did not acknowledge its armed context\n");
+			kill(child, SIGKILL);
+			waitpid(child, &status, 0);
+			child_pid = 0;
+			close(ready[0]);
+			close(life[1]);
+			sigprocmask(SIG_SETMASK, &previous, NULL);
+			goto close_map;
+		}
+		close(ready[0]);
+		sigprocmask(SIG_SETMASK, &previous, NULL);
+		lifetime_write = life[1];
+		for (index = 0; index < 5; index++)
+			close(parents[index]);
+		close(group);
+		close(evidence);
+		return 0;
+	}
+	close(ready[0]);
+	sigprocmask(SIG_SETMASK, &previous, NULL);
+	close(life[1]);
+close_map:
+	munmap(active_phase, 4096);
+	active_phase = NULL;
+	goto close_parents;
+close_ready:
+	close(ready[0]);
+	close(ready[1]);
+close_pipe:
+	close(life[0]);
+	close(life[1]);
+	goto close_map;
+close_parents:
+	for (index = 0; index < 5; index++)
+		if (parents[index] >= 0)
+			close(parents[index]);
+skip:
+	pr_info("[FBX-RECOVERY] skipped %s errno=%d\n", reason, errno);
+	if (group >= 0)
+		close(group);
+	if (evidence >= 0)
+		close(evidence);
+	return 0;
+}
+
+void factorybox_retained_disable(void)
+{
+	if (active_phase)
+		__atomic_store_n(active_phase, 0, __ATOMIC_RELEASE);
+}
+
+int factorybox_retained_child(int pid)
+{
+	return child_pid > 1 && pid == child_pid;
+}
+
+void factorybox_retained_end(void)
+{
+	int status;
+	if (child_pid > 1) {
+		if (send(lifetime_write, "C", 1, MSG_NOSIGNAL) != 1)
+			pr_warn("Retained-context diagnostic child already stopped\n");
+		close(lifetime_write);
+		waitpid(child_pid, &status, 0);
+		child_pid = 0;
+		lifetime_write = -1;
+	}
+	if (active_phase) {
+		munmap(active_phase, 4096);
+		active_phase = NULL;
+	}
+}
