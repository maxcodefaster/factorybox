+func TestFactoryboxRestoreLockPreservesDescriptor(t *testing.T) {
+	root := t.TempDir()
+	file, err := os.OpenFile(root+"/.lock", os.O_CREATE|os.O_EXCL|os.O_RDWR, 0600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+	for iteration := 0; iteration < 4; iteration++ {
+		if err := factoryboxRestoreLock(root, int(file.Fd())); err != nil {
+			t.Fatal(err)
+		}
+		runtime.GC()
+	}
+	if _, err := file.Stat(); err != nil {
+		t.Fatal("lock validation closed its caller's descriptor", err)
+	}
+}
+
+func TestFactoryboxRestoreConfig(t *testing.T) {
+	source := "fbx-" + strings.Repeat("a", 32)
+	owner := strings.Repeat("b", 32)
+	request := factoryboxRestoreRequest{SourceID: source, SourceRootfs: "/original/rootfs",
+		Owner: owner, Root: "/owned/controller", SandboxID: "forked", Filesystem: "/owned/fork/filesystem", Images: "/owned/fork/images"}
+	sbox := sysbox.NewSysbox(source, true, true)
+	sbox.Fs.Reg = true
+	config := configs.Config{Rootfs: request.SourceRootfs, RootfsUidShiftType: sh.IDMappedMount,
+		Cgroups:     &configs.Cgroup{Path: "/" + source, Resources: &configs.Resources{Freezer: configs.Frozen}},
