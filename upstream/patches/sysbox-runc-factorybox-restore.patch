+//go:build linux
+
+package factoryboxrestore
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	sh "github.com/nestybox/sysbox-libs/idShiftUtils"
+	"github.com/nestybox/sysbox-runc/libcontainer/internal/userns"
+	"github.com/opencontainers/runc/libcontainer/configs"
+	"github.com/opencontainers/runc/libcontainer/utils"
+	"golang.org/x/sys/unix"
+)
+
+func factoryboxRestoreCgroup(id string, labels []string, root string) bool {
+	_, annotations := utils.Annotations(labels)
+	owner := annotations["io.factorybox.owner"]
+	return regexp.MustCompile(`^[0-9a-f]{32}$`).MatchString(owner) && id == "fbx-"+owner && root == "/"+id
+}
+
+// FactoryboxRoot maps the private copy of an admitted saved overlay.
+// The caller creates a new mount namespace after FUSE pre-registration.
+func FactoryboxRoot(config configs.Config, bundle, manager, images string) error {
+	if config.Cgroups == nil || !factoryboxRestoreCgroup(strings.TrimPrefix(config.Cgroups.Path, "/"), config.Labels, config.Cgroups.Path) ||
+		config.Rootfs != bundle+"/rootfs" || config.RootfsUidShiftType != sh.IDMappedMount ||
+		filepath.Clean(bundle) != bundle || !filepath.IsAbs(bundle) ||
+		filepath.Dir(images) != filepath.Dir(bundle) || filepath.Base(images) != "images" ||
+		len(config.UidMappings) != 1 || len(config.GidMappings) != 1 {
+		return fmt.Errorf("restore overlay is outside its persisted Factorybox request")
+	}
+	current, err := os.Readlink("/proc/self/ns/mnt")
+	if err != nil {
+		return err
+	}
+	outer, err := os.Readlink("/proc/1/ns/mnt")
+	if err != nil || current == outer {
+		return fmt.Errorf("restore requires a private mount namespace: %v", err)
+	}
+	handles := &userns.Handles{}
+	defer handles.Release()
+	mapping, err := handles.Get(userns.Mapping{UIDMappings: config.UidMappings, GIDMappings: config.GidMappings})
+	if err != nil {
+		return err
+	}
+	defer mapping.Close()
+	if err := experimentIDMap(mapping, bundle, "lower"); err != nil {
+		return fmt.Errorf("map restored lower layer: %w", err)
+	}
+	for _, mount := range config.Mounts {
+		if !mount.IDMappedMount {
+			continue
+		}
+		relative, err := filepath.Rel(manager, mount.Source)
+		parts := strings.Split(relative, string(filepath.Separator))
+		if err != nil || len(parts) != 2 || parts[1] != strings.TrimPrefix(config.Cgroups.Path, "/") ||
+			filepath.Clean(mount.Source) != mount.Source {
+			return fmt.Errorf("restored ID-mapped bind is outside its private manager volumes")
+		}
+		if err := experimentIDMap(mapping, manager, relative); err != nil {
+			return fmt.Errorf("map restored manager volume: %w", err)
+		}
+	}
+	if err := unix.Unmount(config.Rootfs, 0); err != nil {
+		return err
+	}
+	work := bundle + "/restore-work"
+	if err := os.Mkdir(work, 0700); err != nil {
+		return err
+	}
+	return unix.Mount("overlay", config.Rootfs, "overlay", 0, "lowerdir="+bundle+"/lower,upperdir="+bundle+"/upper,workdir="+work)
+}
