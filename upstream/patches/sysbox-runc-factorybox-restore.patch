+	encode(config)
+	if _, err := factoryboxRestoreConfig(request, "fbx-"+owner); err == nil {
+		t.Fatal("foreign source root accepted")
+	}
+	config.Rootfs = request.SourceRootfs
+	config.Namespaces = append(config.Namespaces, configs.Namespace{Type: configs.NEWNET, Path: "/external/netns"})
+	encode(config)
