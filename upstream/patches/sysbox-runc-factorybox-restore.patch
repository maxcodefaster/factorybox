+)
+
+func TestFactoryboxRestoreCgroup(t *testing.T) {
+	owner := strings.Repeat("a", 32)
+	id := "fbx-" + owner
+	if !factoryboxRestoreCgroup(id, []string{"io.factorybox.owner=" + owner}, "/"+id) {
+		t.Fatal("canonical owned target rejected")
+	}
+	for _, test := range []struct{ id, owner, root string }{
+		{id, owner, "/" + id + "/child"},
+		{id, owner, "/foreign"},
+		{id, strings.Repeat("b", 32), "/" + id},
+		{"fbx-" + strings.Repeat("A", 32), strings.Repeat("A", 32), "/fbx-" + strings.Repeat("A", 32)},
+		{"fbx-", owner, "/fbx-"},
+	} {
+		if factoryboxRestoreCgroup(test.id, []string{"io.factorybox.owner=" + test.owner}, test.root) {
+			t.Fatalf("foreign target accepted: %+v", test)
+		}
+	}
+}
