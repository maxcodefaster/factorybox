+static int factorybox_add_directory(unsigned int id, const char *encoded)
+{
+	size_t length = strlen(encoded), index;
+	char *path;
+	if (!length || length % 2 || length / 2 >= PATH_MAX ||
+	    strspn(encoded, "0123456789abcdef") != length)
+		return -1;
+	path = xmalloc(length / 2 + 1);
+	if (!path)
+		return -1;
+	for (index = 0; index < length; index += 2) {
+		char pair[3] = { encoded[index], encoded[index + 1], 0 };
+		path[index / 2] = strtoul(pair, NULL, 16);
+		if (!path[index / 2])
+			goto error;
+	}
+	path[length / 2] = 0;
+	if (path[0] != '/')
+		goto error;
+	if (factorybox_directory_count == factorybox_directory_capacity) {
+		unsigned int capacity = factorybox_directory_capacity ? factorybox_directory_capacity * 2 : 32;
+		struct factorybox_directory *grown;
+		if (capacity < factorybox_directory_capacity)
+			goto error;
+		grown = xrealloc(factorybox_directories, (size_t)capacity * sizeof(*grown));
+		if (!grown)
+			goto error;
+		factorybox_directories = grown;
+		factorybox_directory_capacity = capacity;
+	}
+	factorybox_directories[factorybox_directory_count].id = id;
+	factorybox_directories[factorybox_directory_count++].path = path;
+	return 0;
+error:
+	xfree(path);
+	return -1;
+}
