+static int factorybox_count(const char **cursor, const char *prefix, unsigned int *value)
+{
+	char *end;
+	unsigned long parsed;
+	size_t length = strlen(prefix);
+	if (strncmp(*cursor, prefix, length))
+		return -1;
+	*cursor += length;
+	if (**cursor < '0' || **cursor > '9')
+		return -1;
+	errno = 0;
+	parsed = strtoul(*cursor, &end, 10);
+	if (errno || parsed > UINT_MAX)
+		return -1;
+	*cursor = end;
+	*value = parsed;
+	return 0;
+}
