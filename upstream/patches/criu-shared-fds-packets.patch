+static int factorybox_descriptor_budget(unsigned int additional)
+{
+	struct rlimit limit;
+	struct dirent *entry;
+	DIR *directory;
+	unsigned long long open = 0;
+	if (getrlimit(RLIMIT_NOFILE, &limit))
+		return -1;
+	directory = opendir("/proc/self/fd");
+	if (!directory)
+		return -1;
+	while ((entry = readdir(directory)))
+		if (strcmp(entry->d_name, ".") && strcmp(entry->d_name, ".."))
+			open++;
+	closedir(directory);
+	/* Keep the same control-plane reserve as the original worker store. */
+	return limit.rlim_cur < open + 64 || additional > limit.rlim_cur - open - 64 ? -1 : 0;
+}
