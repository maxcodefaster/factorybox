+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestFactoryboxResumeRejectsForeignLayout(t *testing.T) {
+	owner := strings.Repeat("a", 32)
+	request := factoryboxResumeRequest{Version: 1, SandboxID: "workspace", Owner: owner, Root: "/owned",
+		Filesystem: "/owned/filesystem", ManagerRoot: "/owned/manager", SnapshotID: strings.Repeat("b", 32),
+		Images: "/foreign/images"}
+	if err := factoryboxResumeIdentity(request, "/owned/runtime", "fbx-"+owner, nil); err == nil ||
+		!strings.Contains(err.Error(), "outside its persisted runtime") {
+		t.Fatal("foreign resume image path was not rejected before filesystem access", err)
+	}
+	request.Images = "/owned/objects/workspace/resumes/" + request.SnapshotID + "/images"
+	request.SandboxID = "../foreign"
+	if err := factoryboxResumeIdentity(request, "/owned/runtime", "fbx-"+owner, nil); err == nil ||
+		!strings.Contains(err.Error(), "outside its persisted runtime") {
+		t.Fatal("foreign logical identity was not rejected before filesystem access", err)
+	}
+}
