+type factoryboxResumeRequest struct {
+	Version        int    `json:"version"`
+	SandboxID      string `json:"sandbox_id"`
+	Owner          string `json:"owner"`
+	Root           string `json:"root"`
+	Filesystem     string `json:"filesystem"`
+	Images         string `json:"images"`
+	ManagerRoot    string `json:"manager_root"`
+	SnapshotID     string `json:"snapshot_id"`
+	ConfigSHA256   string `json:"config_sha256"`
+	RuntimeCreated string `json:"runtime_created"`
+}
+
+type factoryboxResumeRecord struct {
+	Version        int    `json:"version"`
+	ID             string `json:"id"`
+	Owner          string `json:"owner"`
+	RuntimeID      string `json:"runtime_id"`
+	ConfigSHA256   string `json:"config_sha256"`
+	Rootfs         string `json:"rootfs"`
+	InputBundle    string `json:"input_bundle"`
+	RuntimeCreated string `json:"runtime_created"`
+	Phase          string `json:"phase"`
+	BootID         string `json:"boot_id"`
+	Cgroup         *struct {
+		Device  uint64 `json:"device"`
+		Inode   uint64 `json:"inode"`
+		MountID uint64 `json:"mount_id"`
+	} `json:"cgroup"`
+	Pause *struct {
+		SnapshotID  string `json:"snapshot_id"`
+		CompletedAt string `json:"completed_at"`
+		Resume      *struct {
+			Attempted bool `json:"attempted"`
+		} `json:"resume"`
+	} `json:"pause"`
+}
+
+func factoryboxResumeIdentity(request factoryboxResumeRequest, runtimeRoot, target string, originalGroup *os.File) error {
+	if os.Geteuid() != 0 || request.Version != 1 ||
+		!regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}$`).MatchString(request.SandboxID) ||
+		!regexp.MustCompile(`^[0-9a-f]{32}$`).MatchString(request.Owner) ||
+		!regexp.MustCompile(`^[0-9a-f]{32}$`).MatchString(request.SnapshotID) ||
+		target != "fbx-"+request.Owner || !factoryboxRestorePath(request.Root) ||
+		runtimeRoot != request.Root+"/runtime" || !factoryboxRestorePath(request.Filesystem) ||
+		!factoryboxRestorePath(request.ManagerRoot) ||
+		request.Images != request.Root+"/objects/"+request.SandboxID+"/resumes/"+request.SnapshotID+"/images" {
+		return fmt.Errorf("resume request is outside its persisted runtime")
+	}
+	fd, err := unix.Openat2(unix.AT_FDCWD, request.Root+"/objects/"+request.SandboxID+"/record.json", &unix.OpenHow{
+		Flags: unix.O_RDONLY | unix.O_CLOEXEC, Resolve: unix.RESOLVE_NO_SYMLINKS})
+	if err != nil {
+		return err
+	}
+	file := os.NewFile(uintptr(fd), "original resume record")
+	data, readErr := io.ReadAll(io.LimitReader(file, (1<<20)+1))
+	if err := errors.Join(readErr, file.Close()); err != nil {
+		return err
+	}
+	if len(data) > 1<<20 {
+		return fmt.Errorf("resume record exceeds bound")
+	}
+	var record factoryboxResumeRecord
+	if err := json.Unmarshal(data, &record); err != nil {
+		return err
+	}
+	boot, err := os.ReadFile("/proc/sys/kernel/random/boot_id")
+	if err != nil {
+		return err
+	}
+	if record.Version != 1 || record.ID != request.SandboxID || record.Owner != request.Owner ||
+		record.RuntimeID != target || record.ConfigSHA256 != request.ConfigSHA256 ||
+		record.Rootfs != request.Filesystem+"/rootfs" || record.InputBundle != request.Filesystem ||
+		record.RuntimeCreated != request.RuntimeCreated || record.Phase != "resuming" ||
+		strings.TrimSpace(string(boot)) != record.BootID || record.Cgroup == nil ||
+		record.Pause == nil || record.Pause.SnapshotID != request.SnapshotID || record.Pause.CompletedAt == "" ||
+		record.Pause.Resume == nil || !record.Pause.Resume.Attempted {
+		return fmt.Errorf("resume differs from its original operation intent")
+	}
+	config, err := os.ReadFile(request.Root + "/objects/" + request.SandboxID + "/config.json")
+	if err != nil {
+		return err
+	}
+	digest := sha256.Sum256(config)
+	if hex.EncodeToString(digest[:]) != request.ConfigSHA256 {
+		return fmt.Errorf("resume OCI config changed")
+	}
+	group, err := unix.Open("/sys/fs/cgroup/"+target, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return err
+	}
+	defer unix.Close(group)
+	identity := group
+	if originalGroup != nil {
+		identity = int(originalGroup.Fd())
+	}
+	var saved, current unix.Stat_t
+	var extended unix.Statx_t
+	var filesystem unix.Statfs_t
+	if err := errors.Join(unix.Fstat(identity, &saved), unix.Fstat(group, &current),
+		unix.Statx(identity, "", unix.AT_EMPTY_PATH, unix.STATX_MNT_ID, &extended), unix.Fstatfs(identity, &filesystem)); err != nil {
+		return err
+	}
+	if filesystem.Type != unix.CGROUP2_SUPER_MAGIC || extended.Mask&unix.STATX_MNT_ID == 0 ||
+		uint64(saved.Dev) != record.Cgroup.Device || saved.Ino != record.Cgroup.Inode ||
+		extended.Mnt_id != record.Cgroup.MountID || saved.Dev != current.Dev || saved.Ino != current.Ino {
+		return fmt.Errorf("resume original cgroup identity changed")
+	}
+	return factoryboxRestoreLock(request.Root, 4)
+}
+
+func factoryboxResumeContainer(context *cli.Context, request factoryboxResumeRequest) (libcontainer.Container, error) {
+	container, err := getContainer(context)
+	if err != nil {
+		return nil, err
+	}
+	status, err := container.Status()
+	if err != nil || status != libcontainer.Stopped {
+		return nil, fmt.Errorf("resume requires its stopped original runtime: %v", err)
+	}
+	config := container.Config()
+	_, annotations := utils.Annotations(config.Labels)
+	state, err := container.State()
+	if err != nil {
+		return nil, err
+	}
+	hooks := 0
+	for _, entries := range config.Hooks {
+		hooks += len(entries)
+	}
+	if annotations["io.factorybox.owner"] != request.Owner || config.Rootfs != request.Filesystem+"/rootfs" ||
+		config.Cgroups == nil || config.Cgroups.Path != "/fbx-"+request.Owner ||
+		config.RootfsUidShiftType != sh.IDMappedMount || config.RootfsCloned || hooks != 0 ||
+		len(config.ShiftfsMounts) != 0 || len(config.UidMappings) != 1 || len(config.GidMappings) != 1 ||
+		state.Created.UTC().Format(time.RFC3339Nano) != request.RuntimeCreated ||
+		state.Sysbox.Id != "fbx-"+request.Owner || state.Sysbox.Fs == nil || !state.Sysbox.Fs.Reg {
+		return nil, fmt.Errorf("saved resume runtime identity or configuration differs")
+	}
+	for _, namespace := range config.Namespaces {
+		if namespace.Path != "" {
+			return nil, fmt.Errorf("resume cannot join external namespaces")
+		}
+	}
+	return container, nil
+}
+
+var factoryboxResumeCommand = cli.Command{
+	Name: "factorybox-resume",
+	Action: func(context *cli.Context) error {
+		if err := checkArgs(context, 1, exactArgs); err != nil {
+			return err
+		}
+		var request factoryboxResumeRequest
+		if err := factoryboxRestoreRead(5, &request); err != nil {
+			return err
+		}
+		target := context.Args().First()
+		if err := factoryboxResumeIdentity(request, context.GlobalString("root"), target, nil); err != nil {
+			return err
+		}
+		if _, err := factoryboxResumeContainer(context, request); err != nil {
+			return err
+		}
+		groupFD, err := unix.Open("/sys/fs/cgroup/"+target, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+		if err != nil {
+			return err
+		}
+		group := os.NewFile(uintptr(groupFD), "original resume cgroup")
+		defer group.Close()
+		fd, err := unix.MemfdCreate("factorybox-resume", unix.MFD_CLOEXEC|unix.MFD_ALLOW_SEALING)
+		if err != nil {
+			return err
+		}
+		file := os.NewFile(uintptr(fd), "prepared resume request")
+		defer file.Close()
+		if err := json.NewEncoder(file).Encode(request); err != nil {
+			return err
+		}
+		if _, err := file.Seek(0, 0); err != nil {
+			return err
+		}
+		if _, err := unix.FcntlInt(file.Fd(), unix.F_ADD_SEALS, factoryboxRestoreSeals); err != nil {
+			return err
+		}
+		lock := os.NewFile(4, "inherited resume operation lock")
+		defer lock.Close()
+		command := exec.Command("/proc/self/exe", "--root", context.GlobalString("root"), "--criu", context.GlobalString("criu"),
+			"factorybox-resume-prepared", target)
+		command.SysProcAttr = &syscall.SysProcAttr{Cloneflags: unix.CLONE_NEWNS}
+		command.ExtraFiles = []*os.File{file, lock, group}
+		command.Stdin, command.Stdout, command.Stderr = os.Stdin, os.Stdout, os.Stderr
+		return command.Run()
+	},
+}
+
+var factoryboxPreparedResumeCommand = cli.Command{
+	Name: "factorybox-resume-prepared", Hidden: true,
+	Action: func(context *cli.Context) error {
+		if err := checkArgs(context, 1, exactArgs); err != nil {
+			return err
+		}
+		var request factoryboxResumeRequest
+		if err := factoryboxRestoreRead(3, &request); err != nil {
+			return err
+		}
+		target := context.Args().First()
+		group := os.NewFile(5, "original resume cgroup")
+		defer group.Close()
+		if err := factoryboxResumeIdentity(request, context.GlobalString("root"), target, group); err != nil {
+			return err
+		}
+		container, err := factoryboxResumeContainer(context, request)
+		if err != nil {
+			return err
+		}
+		if err := unix.Mount("", "/", "", unix.MS_PRIVATE|unix.MS_REC, ""); err != nil {
+			return err
+		}
+		if err := factoryboxrestore.FactoryboxResumeRoot(container.Config(), request.Filesystem, request.ManagerRoot, request.SnapshotID); err != nil {
+			return err
+		}
+		options := &libcontainer.CriuOpts{SysboxSeccompRestore: true, FactoryboxResume: true,
+			FactoryboxConfigFile: filepath.Dir(request.Images) + "/criu.conf",
+			ImagesDirectory:      request.Images, WorkDirectory: request.Images,
+			ShellJob: true, FileLocks: true, EmptyNs: 0, TcpEstablished: true, ManageCgroupsMode: criu.CriuCgMode_FULL}
+		process := &libcontainer.Process{Init: true, Stdin: os.Stdin, Stdout: os.Stdout, Stderr: os.Stderr}
+		if err := container.Restore(process, options); err != nil {
+			return err
+		}
+		if err := factoryboxResumeIdentity(request, context.GlobalString("root"), target, group); err != nil {
+			return err
+		}
+		freezeFD, err := unix.Openat(int(group.Fd()), "cgroup.freeze", unix.O_WRONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+		if err != nil {
+			return err
+		}
+		freeze := os.NewFile(uintptr(freezeFD), "original resumed cgroup.freeze")
+		_, writeErr := freeze.WriteString("0")
+		if err := errors.Join(writeErr, freeze.Close()); err != nil {
+			return err
+		}
+		state, err := container.State()
+		if err != nil {
+			return err
+		}
+		status, err := container.Status()
+		if err != nil || status != libcontainer.Running {
+			return fmt.Errorf("resumed original runtime is not running: %v", err)
+		}
+		data, err := factoryboxCompletionData(request.Owner, request, state)
+		if err != nil {
+			return err
+		}
+		if err := factoryboxStoreCompletion(filepath.Dir(request.Images), "resume-result.json", data); err != nil {
+			return err
+		}
+		return json.NewEncoder(os.Stdout).Encode(state)
+	},
+}
