+/* Same-worker resources are received before restore enters the sandbox's
+ * namespaces. The endpoint must be root PID 1 in this worker, not a file path
+ * from the sandbox or a replacement service. No resource is reopened by name. */
+static struct {
+	unsigned int id;
+	char path[PATH_MAX];
+} factorybox_directories[128];
+static int factorybox_directory_count;
+
+const char *factorybox_directory_path(struct file_desc *d)
+{
+	int i;
+	for (i = 0; i < factorybox_directory_count; i++)
+		if (factorybox_directories[i].id == d->id && d->ops->type == FD_TYPES__REG)
+			return factorybox_directories[i].path;
+	return NULL;
+}
+
+int factorybox_load_fds(void)
+{
+	char request[256], prefix[256], reply[32768], name[PATH_MAX * 2 + 64];
+	struct sockaddr_un address = { .sun_family = AF_UNIX };
+	struct ucred peer;
+	socklen_t peer_size = sizeof(peer);
+	struct timeval timeout = { .tv_sec = 5 };
+	union {
+		struct cmsghdr alignment;
+		char data[CMSG_SPACE(128 * sizeof(int))];
+	} control;
+	struct iovec iov = { .iov_base = reply, .iov_len = sizeof(reply) - 1 };
+	struct msghdr message = { .msg_iov = &iov, .msg_iovlen = 1,
+		.msg_control = control.data, .msg_controllen = sizeof(control.data) };
+	struct cmsghdr *cmsg;
+	const char *key, *cursor, *end;
+	int socket_fd = -1, fds[128], count = 0, names = 0, size, result = -1, i;
+	ssize_t received;
+
+	if (!opts.factorybox_fdstore)
+		return 0;
+	key = strchr(opts.factorybox_fdstore, '|');
+	if (!key || key == opts.factorybox_fdstore || opts.factorybox_fdstore[0] != '/' ||
+	    key - opts.factorybox_fdstore >= (ptrdiff_t)sizeof(address.sun_path) || strlen(key + 1) != 65)
+		goto out;
+	for (i = 0; i < 65; i++) {
+		char value = key[1 + i];
+		if (i == 32 ? value != ':' : !((value >= '0' && value <= '9') || (value >= 'a' && value <= 'f')))
+			goto out;
+	}
+	memcpy(address.sun_path, opts.factorybox_fdstore, key - opts.factorybox_fdstore);
+	key++;
+	socket_fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+	if (socket_fd < 0 || setsockopt(socket_fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) ||
+	    setsockopt(socket_fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout)) ||
+	    connect(socket_fd, (struct sockaddr *)&address, sizeof(address)) ||
+	    getsockopt(socket_fd, SOL_SOCKET, SO_PEERCRED, &peer, &peer_size) || peer.uid != 0 || peer.pid != 1)
+		goto out;
+	size = snprintf(request, sizeof(request), "{\"operation\":\"restore\",\"key\":\"%s\"}", key);
+	if (size < 0 || size >= (int)sizeof(request) || send(socket_fd, request, size, MSG_NOSIGNAL) != size)
+		goto out;
+	received = recvmsg(socket_fd, &message, MSG_CMSG_CLOEXEC);
+	if (received < 0)
+		goto out;
+	for (cmsg = CMSG_FIRSTHDR(&message); cmsg; cmsg = CMSG_NXTHDR(&message, cmsg)) {
+		size_t bytes;
+		if (cmsg->cmsg_level != SOL_SOCKET || cmsg->cmsg_type != SCM_RIGHTS || cmsg->cmsg_len < CMSG_LEN(0))
+			goto out;
+		bytes = cmsg->cmsg_len - CMSG_LEN(0);
+		if (bytes % sizeof(int) || bytes / sizeof(int) > (size_t)(128 - count))
+			goto out;
+		memcpy(fds + count, CMSG_DATA(cmsg), bytes);
+		count += bytes / sizeof(int);
+	}
+	if (message.msg_flags & (MSG_TRUNC | MSG_CTRUNC))
+		goto out;
+	reply[received] = 0;
+	size = snprintf(prefix, sizeof(prefix), "{\"operation\":\"restore\",\"key\":\"%s\",\"names\":[", key);
+	if (size < 0 || strncmp(reply, prefix, size))
+		goto out;
+	cursor = reply + size;
+	while (*cursor != ']') {
+		unsigned long long id;
+		const char *digits;
+		char *directory_path = NULL;
+		if (*cursor != '"' || names >= count)
+			goto out;
+		end = strchr(++cursor, '"');
+		if (!end || end - cursor >= (ptrdiff_t)sizeof(name))
+			goto out;
+		memcpy(name, cursor, end - cursor);
+		name[end - cursor] = 0;
+		if (!strcmp(name, "factorybox-source-root:1")) {
+			close(fds[names]);
+			fds[names] = -1;
+			goto next_name;
+		}
+		if (!strncmp(name, "factorybox-reg:", 15))
+			digits = name + 15;
+		else if (!strncmp(name, "factorybox-dir:", 15)) {
+			char *separator = strchr(name + 15, ':');
+			if (!separator || factorybox_directory_count >= 128)
+				goto out;
+			*separator = 0;
+			directory_path = separator + 1;
+			digits = name + 15;
+		}
+		else if (!strncmp(name, "factorybox-inotify:", 19))
+			digits = name + 19;
+		else if (!strncmp(name, "factorybox-fanotify:", 20))
+			digits = name + 20;
+		else
+			goto out;
+		if (!*digits || strspn(digits, "0123456789") != strlen(digits))
+			goto out;
+		errno = 0;
+		id = strtoull(digits, NULL, 10);
+		if (errno || !id || id > UINT32_MAX)
+			goto out;
+		if (directory_path) {
+			size_t length = strlen(directory_path), index;
+			char *path = factorybox_directories[factorybox_directory_count].path;
+			if (!length || length % 2 || length / 2 >= PATH_MAX || strspn(directory_path, "0123456789abcdef") != length)
+				goto out;
+			for (index = 0; index < length; index += 2) {
+				char pair[3] = { directory_path[index], directory_path[index + 1], 0 };
+				path[index / 2] = strtoul(pair, NULL, 16);
+				if (!path[index / 2])
+					goto out;
+			}
+			path[length / 2] = 0;
+			if (path[0] != '/')
+				goto out;
+			factorybox_directories[factorybox_directory_count++].id = id;
+			snprintf(name, sizeof(name), "factorybox-reg:%u", (unsigned int)id);
+		}
+		if (inherit_fd_add(fds[names], name))
+			goto out;
+next_name:
+		names++;
+		cursor = end + 1;
+		if (*cursor == ',') {
+			cursor++;
+			if (*cursor != '"')
+				goto out;
+		}
+		else if (*cursor != ']')
+			goto out;
+	}
+	if (strcmp(cursor, "]}") || names != count)
+		goto out;
+	pr_info("Factorybox retained %d original shared file descriptions\n", count);
+	result = 0;
+out:
+	if (socket_fd >= 0)
+		close(socket_fd);
+	if (result) {
+		for (i = 0; i < count; i++)
+			close(fds[i]);
+		pr_err("Factorybox live shared-file generation is unavailable or changed\n");
+	}
+	return result;
+}
+
+bool factorybox_inherited_fd(struct file_desc *d, int *fd_p)
+{
+	char key[64];
+	const char *kind;
+	int fd;
+
+	if (!opts.factorybox_fdstore)
+		return false;
+	switch (d->ops->type) {
+	case FD_TYPES__REG: kind = "reg"; break;
+	case FD_TYPES__INOTIFY: kind = "inotify"; break;
+	case FD_TYPES__FANOTIFY: kind = "fanotify"; break;
+	default: return false;
+	}
+	snprintf(key, sizeof(key), "factorybox-%s:%u", kind, d->id);
+	fd = inherit_fd_lookup_id(key);
+	if (fd < 0)
+		return false;
+	*fd_p = fd;
+	return true;
+}
